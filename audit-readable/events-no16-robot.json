[{"path": "events/2026/05/evt-2026-05-no16-robot-funding-seed-round.yaml", "id": "evt-2026-05-no16-robot-funding-seed-round", "orgs": [{"id": "no16-robot", "role": "subject"}], "title": {"zh": "十六号机器人（XVI Robotics）获知名机构种子轮融资"}, "summary": {"zh": "腾讯新闻 5 月 22 日报道，宋鸿涌创办的北京十六号机器人科技有限公司（XVI Robotics）团队仍在早期组建阶段，已获得知名机构种子轮融资，投资方、金额、产品形态与商业化路径均未披露。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20260522A08XJW00", "publisher": "腾讯新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/news-2026-05-no16-robot-seed-round.html"}]}, {"path": "events/2025/12/evt-2025-12-17-no16-robot-corporate-founding.yaml", "id": "evt-2025-12-17-no16-robot-corporate-founding", "orgs": [{"id": "no16-robot", "role": "subject"}], "title": {"zh": "北京十六号机器人科技有限公司成立"}, "summary": {"zh": "观点网报道，前月之暗面后训练与强化学习负责人宋鸿涌于 2025 年 12 月离职，创立北京十六号机器人科技有限公司，聚焦通用人形机器人基座模型。企查查信息显示公司成立于 2025 年 12 月 17 日，法定代表人宋鸿涌，注册资本 100 万元。"}, "evidence": [{"url": "https://finance.sina.com.cn/wm/2026-05-24/doc-inhyzkka3079176.shtml", "publisher": "新浪财经（转载观点网）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/finance-2025-12-17-no16-robot-founding.html"}]}]