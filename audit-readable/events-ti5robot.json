[{"path": "events/2026/03/evt-2026-03-ti5robot-funding-c-round.yaml", "id": "evt-2026-03-ti5robot-funding-c-round", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人完成 C 轮融资，投资方为安元天云与东土科技"}, "summary": {"zh": "36 氪创投平台融资历史页记录，钛虎机器人于 2026 年 3 月完成 C 轮融资，金额未透露，投资方为安元天云、东土科技。"}, "evidence": [{"url": "https://pitchhub.36kr.com/project/2036217425107591", "publisher": "36 氪创投平台", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/pitchhub-2026-03-ti5robot-c-round-pitchhu.html"}]}, {"path": "events/2026/07/evt-2026-07-31-ti5robot-partnership-casmt-joint-lines.yaml", "id": "evt-2026-07-31-ti5robot-partnership-casmt-joint-lines", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人与中科摩通达成战略合作，敲定多条关节模组一体化智能产线"}, "summary": {"zh": "7 月 31 日，中科摩通（常州）智能制造股份有限公司发布消息，与钛虎机器人科技（上海）有限公司达成战略合作，敲定多条关节模组一体化智能产线整体交付项目，用于减速机、机器人总装等核心部件的自动化生产；钛虎方称产线落地后核心零部件自研产能将数倍扩容，支撑数千台级人形机器人整机年度交付目标。"}, "evidence": [{"url": "https://www.casmt.com/newsinfo/384.html", "publisher": "中科摩通官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/casmt-2026-07-31-ti5robot-casmt-joint-lin.html"}]}, {"path": "events/2026/07/evt-2026-07-19-ti5robot-partnership-siemens-factory.yaml", "id": "evt-2026-07-19-ti5robot-partnership-siemens-factory", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人与西门子签约共建具身智能标杆工厂"}, "summary": {"zh": "7 月 19 日，在 WAIC 2026 期间，钛虎机器人科技（上海）有限公司与西门子签署项目合作协议，围绕研发数字化升级、无人黑灯工厂搭建、轻量化关节联合实验室、产业生态赋能、行业标准联合共建五个板块合作；西门子以产品生命周期管理、自动化产线能力支持钛虎贯通设计、仿真、精密加工和智能装配的数据链路。"}, "evidence": [{"url": "https://www.ti5robot.com/h-nd-59.html", "publisher": "钛虎机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/ti5robot-2026-07-19-ti5robot-siemens-factory.html"}]}, {"path": "events/2026/05/evt-2026-05-06-ti5robot-funding-strategic-round.yaml", "id": "evt-2026-05-06-ti5robot-funding-strategic-round", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人获新一轮融资，金创投、泰中合投资、余杭国投集团、国舜投资参投"}, "summary": {"zh": "5 月 6 日，投融湾报道钛虎机器人科技（上海）有限公司获得新一轮融资，投资方为金创投、泰中合投资、余杭国投集团和国舜投资，金额未披露。"}, "evidence": [{"url": "https://www.163.com/dy/article/KS8QPTIV05119596.html", "publisher": "网易号（投融湾）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/163-2026-05-06-ti5robot-strategic-round.html"}]}, {"path": "events/2026/01/evt-2026-01-26-ti5robot-statement-hardware-only-no-model.yaml", "id": "evt-2026-01-26-ti5robot-statement-hardware-only-no-model", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人 CEO 称只组装硬件不做模型，2025 年大尺寸人形出货约 170 台"}, "summary": {"zh": "1 月 26 日，36 氪《智能涌现》发布对钛虎机器人 CEO 的访谈。访谈称钛虎「只组装硬件，但并不自己做模型」，提供的是硬件参考解决方案；2025 年新工厂扩建完成后关节模组年产能从 3 万个提升至 10 万个，人形机器人组装能力达每年 3000 台，大尺寸人形机器人 2025 年出货约 170 台。"}, "evidence": [{"url": "https://www.36kr.com/p/3656238372266121", "publisher": "36 氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/36kr-2026-01-26-ti5robot-36kr-interview.html"}]}, {"path": "events/2024/12/evt-2024-12-02-ti5robot-funding-pre-a-plus-rounds.yaml", "id": "evt-2024-12-02-ti5robot-funding-pre-a-plus-rounds", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人连续完成 Pre-A+ 与 Pre-A++ 两轮融资"}, "summary": {"zh": "12 月 2 日，钛虎机器人科技（上海）有限公司宣布连续完成 Pre-A+ 和 Pre-A++ 两轮融资，Pre-A 系列合计融资金额超过一亿元人民币。Pre-A+ 轮由凡创资本和锦冠资本投资，Pre-A++ 轮由毅达资本、商汤国香资本和江阴人才基金联合投资，老股东经纬创投连续两轮跟投。"}, "evidence": [{"url": "https://finance.sina.com.cn/tech/roll/2024-12-02/doc-incxzzsq5525893.shtml", "publisher": "新浪科技", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/finance-2024-12-02-ti5robot-prea-plus-plus.html"}]}, {"path": "events/2025/07/evt-2025-07-27-ti5robot-product_launch-waic2025-t170v21-t140.yaml", "id": "evt-2025-07-27-ti5robot-product_launch-waic2025-t170v21-t140", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人在 2025 WAIC 亮相 T170V2.1 与 T140 人形机器人"}, "summary": {"zh": "钛虎机器人官网新闻称，在 2025 WAIC 世界人工智能大会上，钛虎 T170V2.1 与钛虎 T140 两款人形机器人正式亮相。T170V2.1 采用新一代关节设计，中空孔比例较上一代提升 20%；T140 体积更小，搭配语音交互功能，面向教育培训与家庭陪伴场景。"}, "evidence": [{"url": "https://www.ti5robot.com/h-nd-43.html", "publisher": "钛虎机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/ti5robot-2025-07-27-ti5robot-waic2025-t170v2.html"}]}, {"path": "events/2025/11/evt-2025-11-28-ti5robot-product_launch-pro-3-joint.yaml", "id": "evt-2025-11-28-ti5robot-product_launch-pro-3-joint", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人五周年发布会首发 PRO-3 系列轻量化关节模组"}, "summary": {"zh": "11 月 28 日，钛虎机器人科技五周年活动暨新品发布会在上海举办，多款新品全球首发，其中 PRO-3 系列轻量化关节模组为一体化行星减速机关节模组，面向人形机器人关节，搭载自研 24bit 双编码器，全系列中孔走线，中空比超 11%。"}, "evidence": [{"url": "https://www.ti5robot.com/h-nd-45.html", "publisher": "钛虎机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/ti5robot-2025-11-28-ti5robot-pro3-joint-laun.html"}]}, {"path": "events/2025/06/evt-2025-06-23-ti5robot-funding-ant-china-mobile.yaml", "id": "evt-2025-06-23-ti5robot-funding-ant-china-mobile", "orgs": [{"id": "ti5robot", "role": "subject"}], "title": {"zh": "钛虎机器人完成超亿元新一轮融资，中国移动与蚂蚁集团参投"}, "summary": {"zh": "6 月 23 日，36 氪报道钛虎机器人近日完成超亿元新一轮融资，投资方包括中国移动、蚂蚁集团。报道称这是阿里系首次入局人形机器人核心关节。"}, "evidence": [{"url": "https://m.36kr.com/newsflashes/3348742156212868", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/m-2025-06-23-ti5robot-antgroup-chinam.html"}]}]