[{"path": "events/2022/07/evt-2022-07-tiangong-robotics-funding-angel.yaml", "id": "evt-2022-07-tiangong-robotics-funding-angel", "orgs": [{"id": "tiangong-robotics", "role": "subject"}], "title": {"zh": "天工机器人成立四个月获 2 亿元天使轮"}, "summary": {"zh": "2022 年 7 月，公司成立刚满四个月即获 2 亿元天使轮融资，投资方为经纬创投、华兴新经济基金、红点中国、零一创投。"}, "evidence": [{"url": "https://www.leiphone.com/category/industrynews/QDqnLfFb5wiTdPyd.html", "publisher": "雷峰网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2022/07/leiphone-2022-07-tiangong.html"}]}, {"path": "events/2026/09/evt-2026-09-01-tiangong-robotics-funding-a.yaml", "id": "evt-2026-09-01-tiangong-robotics-funding-a", "orgs": [{"id": "tiangong-robotics", "role": "subject"}], "title": {"zh": "天工机器人完成数亿元 A 轮融资"}, "summary": {"zh": "北京天下先智创机器人技术有限责任公司（天工机器人）宣布完成数亿元 A 轮融资，初芯基金领投，经纬创投、合肥国资等跟投。资金用于分拣类机器人扩大量产、基于人形的分拣机器人研发与商用化、海外市场拓展。报道称其手握全球头部电商与快递企业的产线订单。"}, "evidence": [{"url": "https://www.leiphone.com/category/industrynews/QDqnLfFb5wiTdPyd.html", "publisher": "雷峰网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/leiphone-2026-09-01-tiangong.html"}]}, {"path": "events/2026/09/evt-2026-09-tiangong-robotics-product-launch-3d-sorter-e.yaml", "id": "evt-2026-09-tiangong-robotics-product-launch-3d-sorter-e", "orgs": [{"id": "tiangong-robotics", "role": "subject"}], "title": {"zh": "天工机器人推出木马速运一体机（3D Sorter E），已在头部快递企业仓库投入运营"}, "summary": {"zh": "2026 年 9 月，天工机器人推出木马速运一体机（3D Sorter E），作为交叉带分拣体系的补充，用一柱多车、立体化格口设计让 NC 件与扁平件多流向分拣在一套设备内一次完成。报道称该设备已在国内某头部快递企业仓库投入运营，2026 年 7 月 2 日现场峰值处理量 24500 件/小时，人员分拣效率提升 280%。客户名称未披露。"}, "evidence": [{"url": "http://zgdsb.cn/news/toutiao/11467.html", "publisher": "电商报道网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/zgdsb-2026-09-tiangong-robotics-sorter.html"}, {"url": "https://cinic.org.cn/zgzz/xw/1653672.html", "publisher": "中国产业经济信息网（转自科技日报）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/cinic-2026-09-18-tiangong-robotics-produc.html"}]}]