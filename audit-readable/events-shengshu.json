[{"path": "events/2026/03/evt-2026-03-30-shengshu-corporate-joint-stock-reform.yaml", "id": "evt-2026-03-30-shengshu-corporate-joint-stock-reform", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技完成股份制改造，更名为北京生数科技股份有限公司"}, "summary": {"zh": "36 氪报道，2026 年 3 月 30 日生数科技公司主体完成股份制改造，由「北京生数科技有限公司」变更为「北京生数科技股份有限公司（未上市）」。"}, "evidence": [{"url": "https://www.36kr.com/p/3947480095430272", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/36kr-2026-03-30-shengshu-joint-stock-ref.html"}]}, {"path": "events/2026/02/evt-2026-02-05-shengshu-funding-a-plus-round.yaml", "id": "evt-2026-02-05-shengshu-funding-a-plus-round", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技完成超 6 亿元 A+ 轮融资"}, "summary": {"zh": "2 月 5 日，北京生数科技有限公司宣布完成超过 6 亿元人民币 A+ 轮融资，由中关村科学城公司和星连资本领投，万兴科技、视觉中国、拓尔思战略投资，启明创投、北京市人工智能产业投资基金、卓源亚洲、建发新兴投资、淮海投资等老股东跟投。"}, "evidence": [{"url": "https://www.ncsti.gov.cn/kjdt/xwjj/202602/t20260208_237672.html", "publisher": "北京市科委·中关村管委会网站（转载生数科技公众号）", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/ncsti-2026-02-05-shengshu-a-plus-round.html"}]}, {"path": "events/2026/02/evt-2026-02-06-shengshu-product-launch-motus.yaml", "id": "evt-2026-02-06-shengshu-product-launch-motus", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技联合清华大学发布统一世界模型 Motus"}, "summary": {"zh": "2 月 6 日，生数科技联合清华大学正式开源统一世界模型 Motus。该模型基于视频大模型构建，面向具身智能任务，代码、论文与权重在 GitHub、Hugging Face 公开。报道称 Motus 于 2025 年 12 月完成论文发布并开源。"}, "evidence": [{"url": "https://www.itbear.com.cn/html/2026-02/1135316.html", "publisher": "ITBear（转载鞭牛士）", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/itbear-2026-02-06-shengshu-motus-release.html"}]}, {"path": "events/2026/07/evt-2026-07-shengshu-funding-b-plus-round.yaml", "id": "evt-2026-07-shengshu-funding-b-plus-round", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技完成 5 亿美元 B+ 轮融资"}, "summary": {"zh": "智东西 8 月 19 日报道，生数科技投资方达泰 2026 年 7 月在其公众号发文，称生数科技已于近期完成一轮 5 亿美元 B+ 轮融资，投资方与投后估值未披露。同篇报道援引彭博社消息，生数科技正考虑赴港 IPO。"}, "evidence": [{"url": "https://www.zhidx.com/p/586199.html", "publisher": "智东西", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/zhidx-2026-07-shengshu-b-plus-round.html"}]}, {"path": "events/2026/04/evt-2026-04-shengshu-funding-b-round.yaml", "id": "evt-2026-04-shengshu-funding-b-round", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技完成近 20 亿元 B 轮融资，阿里云领投"}, "summary": {"zh": "科技日报 4 月 14 日报道，北京生数科技有限公司近日宣布完成近 20 亿元人民币 B 轮融资，由阿里云领投，中网投、九安海棠、好未来、光合创投等战略投资，星连资本、达泰资本、建发新兴投资、BV 百度风投、卓源亚洲等老股东追加投资。"}, "evidence": [{"url": "https://www.stdaily.com/web/gdxw/2026-04/14/content_501842.html", "publisher": "科技日报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/stdaily-2026-04-shengshu-b-round.html"}]}, {"path": "events/2026/09/evt-2026-09-11-shengshu-publication-motus2.yaml", "id": "evt-2026-09-11-shengshu-publication-motus2", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技新建仓库 Motus2"}, "summary": {"zh": "生数科技新建仓库 Motus2。来源：GitHub · shengshu-ai"}, "evidence": [{"url": "https://github.com/shengshu-ai/Motus2", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-11-shengshu.html"}]}, {"path": "events/2025/03/evt-2025-03-12-shengshu-personnel-ceo-luo-yihang.yaml", "id": "evt-2025-03-12-shengshu-personnel-ceo-luo-yihang", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "骆怡航出任生数科技 CEO"}, "summary": {"zh": "观察者网 2025 年 3 月 12 日报道，原字节跳动火山引擎 AI 应用产品线负责人骆怡航于近日加入北京生数科技有限公司任 CEO，全面负责研发、产品、商业化及团队管理工作，生数科技方面向该媒体确认了这一任命。"}, "evidence": [{"url": "https://finance.sina.com.cn/roll/2025-03-12/doc-inepkvpf7673492.shtml", "publisher": "新浪财经（转载观察者网）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/finance-2025-03-12-shengshu-ceo-browser.html"}]}, {"path": "events/2025/07/evt-2025-07-25-shengshu-product-launch-vidar.yaml", "id": "evt-2025-07-25-shengshu-product-launch-vidar", "orgs": [{"id": "shengshu", "role": "subject"}], "title": {"zh": "生数科技联合清华大学发布具身基座模型 Vidar"}, "summary": {"zh": "新华网 2025 年 7 月 26 日报道，生数科技携手清华大学于 7 月 25 日发布具身基座模型 Vidar。该模型构建支持机器人双臂协同任务的多视角视频预测框架，并搭配高精度预测逆动力学模型完成动作预测；公司称仅用 20 分钟机器人真机数据即可泛化到新机器人，所需数据量约为行业均值的千分之一。"}, "evidence": [{"url": "http://www.bj.xinhuanet.com/20250726/e751d0aa02064e0f98c64137b22550bd/c.html", "publisher": "新华网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/bj-2025-07-25-shengshu-vidar.html"}]}]