[{"path": "events/2026/09/evt-2026-09-09-force-infinity-product_launch-atomego.yaml", "id": "evt-2026-09-09-force-infinity-product_launch-atomego", "orgs": [{"id": "force-infinity", "role": "subject"}], "title": {"zh": "原力无限联合多机构发布具身基础模型 AtomEgo"}, "summary": {"zh": "原力无限联合招商局狮子山人工智能实验室、香港大学、同济大学等团队发布具身基础模型 AtomEgo，围绕人类第一人称（Ego）数据与机器人数据的跨本体学习，比较直接联合训练、渐进式具身对齐与 World–Action Modeling 等训练路径。"}, "evidence": [{"url": "https://www.163.com/tech/article/L6CJ2KQT00098IEO.html", "publisher": "网易科技（来源：网易智能）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/163-2026-09-09-force-infinity-atomego.html"}]}, {"path": "events/2026/08/evt-2026-08-14-force-infinity-funding-a-and-a-plus.yaml", "id": "evt-2026-08-14-force-infinity-funding-a-and-a-plus", "orgs": [{"id": "force-infinity", "role": "subject"}], "title": {"zh": "原力无限完成 A 轮及 A+ 轮融资，金额近 10 亿元人民币"}, "summary": {"zh": "8 月 14 日，原力无限（INFIFORCE）宣布已完成 A 轮及 A+ 轮融资，融资金额近 10 亿元人民币，由敦鸿资产及头部国资平台领投，浙大科创集团、盐都国控、丽水市国资公司等跟投，老股东创世伙伴创投 CCV 加注。资金投向具身大脑 AtomBrain 及因果世界模型研发、AI Infra DataGrid 升级、多形态本体规模化交付。"}, "evidence": [{"url": "https://infiforce.cn/news-detail?id=2088103628513726466", "publisher": "原力无限官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/infiforce-2026-08-14-force-infinity-a-round.html"}, {"url": "https://www.stcn.com/article/detail/4076151.html", "publisher": "证券时报网（人民财讯）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/stcn-2026-08-14-force-infinity-a-round-s.html"}]}, {"path": "events/2024/10/evt-2024-10-force-infinity-product_launch-auto-charging-robot.yaml", "id": "evt-2024-10-force-infinity-product_launch-auto-charging-robot", "orgs": [{"id": "force-infinity", "role": "subject"}], "title": {"zh": "原力无限发布智能全自动充电机器人"}, "summary": {"zh": "钛媒体稿件写明「2024 年 10 月，原力无限发布全球首创的智能全自动充电机器人，打通『自动驾驶、自动泊车、自动充电』全链路」。同一稿件写明原力无限当时已在北京、广州等核心城市部署该产品。"}, "evidence": [{"url": "https://www.tmtpost.com/7507888.html", "publisher": "钛媒体", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/tmtpost-2024-10-force-infinity-charging-.html"}]}, {"path": "events/2025/03/evt-2025-03-25-force-infinity-corporate-elu-ai-brand-upgrade.yaml", "id": "evt-2025-03-25-force-infinity-corporate-elu-ai-brand-upgrade", "orgs": [{"id": "force-infinity", "role": "subject"}], "title": {"zh": "原力无限宣布品牌升级为 ELU.AI，下设原力无限、原力光年、原力万象三大子品牌"}, "summary": {"zh": "3 月 25 日，与 Pre-A 轮融资同时，ELU.AI 宣布品牌升级，聚焦 AI 智能机器人、行业 AI Agent 和类脑智能三大核心领域，旗下涵盖原力无限（INFIFORCE）、原力光年（LIGHTFORCE）和原力万象（UNIFORCE）三大子品牌，分别专注于智能机器人、行业 AI 应用和机器人大脑。"}, "evidence": [{"url": "https://www.tmtpost.com/7507888.html", "publisher": "钛媒体", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/tmtpost-2025-03-25-force-infinity-pre-a.html"}]}, {"path": "events/2025/03/evt-2025-03-25-force-infinity-funding-pre-a.yaml", "id": "evt-2025-03-25-force-infinity-funding-pre-a", "orgs": [{"id": "force-infinity", "role": "subject"}], "title": {"zh": "原力无限完成 Pre-A 轮融资，原话为「数亿元」"}, "summary": {"zh": "3 月 25 日，ELU.AI（原力无限机器人）宣布完成 Pre-A 轮融资，报道原话为「数亿元人民币」，未披露确定金额。投资方为力鼎资本、杭实产投、兴泰资本等，天使轮投资方创世伙伴创投持续追投。报道写明资金重点投向强化 AI 决策系统、推进下一代智能机器人研发、加速全球市场布局。"}, "evidence": [{"url": "https://www.tmtpost.com/7507888.html", "publisher": "钛媒体", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/tmtpost-2025-03-25-force-infinity-pre-a.html"}, {"url": "https://m.bkeconomy.com/detail/1742878323129456.html", "publisher": "新京报贝壳财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/m-2025-03-25-force-infinity-pre-a-bk.html"}]}]