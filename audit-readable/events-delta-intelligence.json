[{"path": "events/2026/07/evt-2026-07-28-delta-intelligence-funding-angel-plus-plus.yaml", "id": "evt-2026-07-28-delta-intelligence-funding-angel-plus-plus", "orgs": [{"id": "delta-intelligence", "role": "subject"}, {"id": "agibot", "role": "investor"}, {"id": "leju", "role": "investor"}, {"id": "galaxea", "role": "investor"}], "title": {"zh": "德塔智能完成近 5 亿元天使++ 轮融资"}, "summary": {"zh": "新京报 7 月 28 日报道，人形机器人基础模型公司德塔智能近日完成近 5 亿元天使++ 轮融资，投资方包括多家上市公司产业方和头部财务投资机构，为公司成立半年内的第六轮融资。此前投资方包括智元机器人、乐聚机器人、星海图等主机厂，以及元禾控股、复星锐正、华映资本、联想创投等机构。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1785246449129444.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/bjnews-2026-07-28-delta-intelligence-angel.html"}]}, {"path": "events/2026/07/evt-2026-07-28-delta-intelligence-product-launch-delta-d1.yaml", "id": "evt-2026-07-28-delta-intelligence-product-launch-delta-d1", "orgs": [{"id": "delta-intelligence", "role": "subject"}], "title": {"zh": "德塔智能发布头戴式全身全景数据采集设备 Delta D1"}, "summary": {"zh": "与天使++ 轮融资同期，德塔智能发布头戴式全身全景数据采集设备 Delta D1：佩戴者正常作业时同步采集第一人称全景视觉与全身关节运动轨迹，不依赖机器人本体。新京报报道称德塔智能已与智元、乐聚、星海图、宇树等人形机器人厂商建立合作。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1785246449129444.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/bjnews-2026-07-28-delta-intelligence-angel.html"}]}, {"path": "events/2026/09/evt-2026-09-18-delta-intelligence-partnership-changan-tianshu.yaml", "id": "evt-2026-09-18-delta-intelligence-partnership-changan-tianshu", "orgs": [{"id": "delta-intelligence", "role": "subject"}], "title": {"zh": "德塔智能与长安天枢智能机器人签署战略合作备忘录，面向汽车制造场景"}, "summary": {"zh": "北京德塔源创智能科技有限公司与长安天枢智能机器人公司签署战略合作备忘录（MOU），面向汽车制造工业场景打通「场景需求—数据采集—模型训练端侧部署—真机验证—数据回流—持续优化」研发闭环，推进人形机器人在汽车总装、物流转运、现场巡检、装配作业、上下料、质量检验等场景的 PoC 验证与示范应用。"}, "evidence": [{"url": "https://www.gkzhan.com/news/detail/195721.html", "publisher": "智能制造网（转载德塔智能公众号）", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/gkzhan-2026-09-18-delta-intelligence-chang.html"}, {"url": "https://auto.ifeng.com/c/8wWaZoXYSdm", "publisher": "凤凰网汽车（网通社）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/auto-2026-09-18-delta-intelligence-chang.html"}]}]