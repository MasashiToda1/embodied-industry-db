[{"path": "events/2026/07/evt-2026-07-09-rokae-funding-hk-ipo.yaml", "id": "evt-2026-07-09-rokae-funding-hk-ipo", "orgs": [{"id": "rokae", "role": "subject"}], "title": {"zh": "珞石机器人在港交所上市"}, "summary": {"zh": "7 月 9 日，珞石机器人正式登陆港交所。公告显示，本次全球发售 2303.19 万股 H 股，发售价每股 38 港元；香港公开发售获 156.58 倍超额认购，国际发售获 11.96 倍超额认购，引入广发基金、华泰资本、北京金融街资本等 5 名基石投资者。"}, "evidence": [{"url": "https://m.gelonghui.com/p/5510236", "publisher": "格隆汇", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/m-2026-07-09-rokae-hk-ipo.html"}]}, {"path": "events/2025/04/evt-2025-04-26-rokae-product_launch-humanoid-debut.yaml", "id": "evt-2025-04-26-rokae-product_launch-humanoid-debut", "orgs": [{"id": "rokae", "role": "subject"}], "title": {"zh": "珞石机器人全新一代人形机器人在山东省机器人大会首次公开亮相"}, "summary": {"zh": "4 月 26 日，2025 山东省机器人大会在邹城启幕，珞石机器人全新一代人形机器人首次公开亮相，并在开幕式上发布《2025 机器人山东宣言》。官网介绍该人形机器人依托全栈自研核心技术与全力控关节协作机器人产品，融合多模态感知融合技术与 VLA 大模型智能中枢，结合模仿学习与强化学习算法；同场展出焊接、打磨、码垛、力控装配等 15 项以上应用方案。"}, "evidence": [{"url": "https://www.rokae.com/cn/news/show/2179/%E4%BA%BA%E5%BD%A2%E6%9C%BA%E5%99%A8%E4%BA%BA%E9%A6%96%E7%A7%80%E3%80%8115+%E5%85%A8%E5%9C%BA%E6%99%AF%E6%96%B9%E6%A1%88%E4%BA%AE%E7%9B%B8%EF%BC%8C%E7%8F%9E%E7%9F%B3%E6%9C%BA%E5%99%A8%E4%BA%BA%E9%97%AA%E8%80%80%E5%B1%B1%E4%B8%9C%E7%9C%81%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%A4%A7%E4%BC%9A%EF%BC%81.html", "publisher": "珞石机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/rokae-2025-04-26-rokae-xiaoluo-debut.html"}]}, {"path": "events/2025/09/evt-2025-09-rokae-deployment-agibot-humanoid-arms.yaml", "id": "evt-2025-09-rokae-deployment-agibot-humanoid-arms", "orgs": [{"id": "rokae", "role": "subject"}, {"id": "agibot", "role": "customer"}], "title": {"zh": "珞石与智元签订协议，供应仿人机械臂"}, "summary": {"zh": "2025 年 9 月，珞石机器人与智元签订协议，为其提供仿人机械臂，集成到智元的人形产品中。"}, "evidence": [{"url": "https://m.gelonghui.com/p/5510236", "publisher": "格隆汇", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/m-2026-07-09-rokae-hk-ipo.html"}]}, {"path": "events/2025/06/evt-2025-06-rokae-funding-pre-ipo-round.yaml", "id": "evt-2025-06-rokae-funding-pre-ipo-round", "orgs": [{"id": "rokae", "role": "subject"}], "title": {"zh": "珞石机器人完成上市前最后一轮融资"}, "summary": {"zh": "投中网报道，2025 年 6 月珞石机器人完成上市前最后一轮融资，从金沙江联合资本处获得 1.95 亿元，估值达到 52.95 亿元。报道称珞石机器人自成立以来共经过 10 轮融资，股东包括梅花创投、德联资本、清控银杏、顺为资本、金沙江联合资本、襄禾资本、深创投、远翼投资、新希望集团、国家制造业转型升级基金、新业资本等。"}, "evidence": [{"url": "https://www.chinaventure.com.cn/news/80-20251030-388632.html", "publisher": "投中网", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/chinaventure-2025-06-rokae-pre-ipo-round.html"}]}]