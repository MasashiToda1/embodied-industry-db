[{"path": "events/2026/02/evt-2026-02-26-huilun-corporate-founding.yaml", "id": "evt-2026-02-26-huilun-corporate-founding", "orgs": [{"id": "huilun", "role": "subject"}], "title": {"zh": "广汽集团宣布孵化成立广东慧仑科技有限公司，独立承接人形机器人业务"}, "summary": {"zh": "2 月 26 日，广汽集团在广州开发区、黄埔区高质量发展大会上宣布孵化成立广东慧仑科技有限公司，以独立主体开展市场化运营，全面承接广汽集团在具身智能领域的业务，总部落地黄埔；同场展出第四代具身智能人形机器人 GoMate Mini。"}, "evidence": [{"url": "https://www.gacgroup.com/cn/news/detail?baseid=19104", "publisher": "广汽集团官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/gacgroup-2026-02-26-huilun-founding.html"}]}, {"path": "events/2026/08/evt-2026-08-11-huilun-funding-round.yaml", "id": "evt-2026-08-11-huilun-funding-round", "orgs": [{"id": "huilun", "role": "subject"}], "title": {"zh": "慧仑科技完成超亿元融资，中车国创基金、招银国际、四川科创等联合投资"}, "summary": {"zh": "广汽集团孵化的广东慧仑科技有限公司宣布完成超亿元融资，由中车国创基金、招银国际、四川科创、天成自控、中天控股集团等联合投资，诚一资本担任财务顾问。资金将投入垂类模型优化、汽车产线与综合服务场景拓展、核心硬件迭代与人才建设。"}, "evidence": [{"url": "https://www.gacgroup.com/cn/news/detail?baseid=19182", "publisher": "广汽集团官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/gacgroup-2026-08-11-huilun-funding-gac.html"}, {"url": "https://www.pencilnews.cn/p/47008.html", "publisher": "铅笔道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/pencilnews-2026-08-12-huilun-funding-pencil.html"}]}, {"path": "events/2026/08/evt-2026-08-12-huilun-deployment-gomate-mini-fleet.yaml", "id": "evt-2026-08-12-huilun-deployment-gomate-mini-fleet", "orgs": [{"id": "huilun", "role": "subject"}], "title": {"zh": "慧仑科技披露 GoMate Mini 已在 7 个项目部署近 50 台，累计运行约 6.3 万公里"}, "summary": {"zh": "据公司披露，第四代轮足式人形机器人 GoMate Mini 已在 7 个代表性项目部署近 50 台，最长单项目运行 12 个月，累计运行约 6.3 万公里，处置异常约 18.9 万次，落地高端园区、商业综合体、地铁枢纽等场景，采用销售加租赁组合模式，成立半年内获近千万元订单。"}, "evidence": [{"url": "https://www.pencilnews.cn/p/47008.html", "publisher": "铅笔道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/pencilnews-2026-08-12-huilun-funding-pencil.html"}]}]