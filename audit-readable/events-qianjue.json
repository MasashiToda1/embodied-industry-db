[{"path": "events/2026/07/evt-2026-07-14-qianjue-funding-100m-strategic-round.yaml", "id": "evt-2026-07-14-qianjue-funding-100m-strategic-round", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人完成亿元级融资，吉德电器与具身智能产业方战略投资"}, "summary": {"zh": "7 月 14 日，千觉机器人科技（上海）有限公司宣布完成亿元级融资，本轮由一家具身智能产业方与吉德电器战略投资，天季资本共同投资。资金用于高精度三色光视触觉传感器产业化、视触觉数采设备与触觉数据集部署验证、原生支持触觉与接触模态的物理智能模型。报道同时提到公司 7 月 10 日发布面向 UMI 数据采集的视触觉传感器 GS-PS。"}, "evidence": [{"url": "https://tech.ifeng.com/c/8ukvcONpO63", "publisher": "凤凰网科技 · 来源智东西机器人前瞻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/tech-2026-07-14-qianjue-100m-round.html"}]}, {"path": "events/2026/09/evt-2026-09-23-qianjue-publication-xensesdk-v2-2-0.yaml", "id": "evt-2026-09-23-qianjue-publication-xensesdk-v2-2-0", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人发布 xensesdk v2.2.0"}, "summary": {"zh": "该标签下的 README 将 Xense SDK 定义为触觉视觉传感器开发工具包，列出图像、深度、三维力分布和六维合力等数据接口。发布说明未列本版本功能变更，因此不将 README 中的既有功能记作本版新增。 日期采用官方 GitHub release 的 published_at（UTC）。"}, "evidence": [{"url": "https://github.com/XenseRobotics/xensesdk/releases/tag/v2.2.0", "publisher": "GitHub · XenseRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-xensesdk-v2-2-0-release-20261001.json"}, {"url": "https://github.com/XenseRobotics/xensesdk/blob/v2.2.0/README.md", "publisher": "GitHub · XenseRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-xensesdk-v2-2-0-readme-20261001.md"}]}, {"path": "events/2026/09/evt-2026-09-qianjue-funding-two-strategic-rounds.yaml", "id": "evt-2026-09-qianjue-funding-two-strategic-rounds", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人连续完成两轮数亿元战略融资，蓝驰创投、中金资本、靖亚资本加注"}, "summary": {"zh": "千觉机器人宣布连续完成两轮数亿元战略融资，投资方包括蓝驰创投、中金资本旗下基金、靖亚资本等。公司称资金用于高精度视触觉传感器迭代与规模化交付、真实交互数据采集、触觉仿真与数据集建设，以及触觉具身模型和触觉世界模型研发。"}, "evidence": [{"url": "https://www.gkzhan.com/news/detail/195751.html", "publisher": "智能制造网 · 来源千觉机器人微信公众号", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/gkzhan-2026-09-qianjue-two-strategic-ro.html"}]}, {"path": "events/2024/11/evt-2024-11-30-qianjue-publication-xensesdk.yaml", "id": "evt-2024-11-30-qianjue-publication-xensesdk", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人开源触觉传感器 Python SDK"}, "summary": {"zh": "千觉机器人在 GitHub 组织 XenseRobotics 下创建并开源 xensesdk 仓库，为其触觉传感器提供 Python SDK，支持深度、形变、marker 跟踪、力场以及远程 / 离线推理。该组织主页登记的网站为 xenserobotics.com。"}, "evidence": [{"url": "https://github.com/XenseRobotics/xensesdk", "publisher": "GitHub · XenseRobotics", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/github-2024-11-30-qianjue-xensesdk.html"}]}, {"path": "events/2024/10/evt-2024-10-qianjue-funding-angel-round.yaml", "id": "evt-2024-10-qianjue-funding-angel-round", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人完成数千万元天使轮融资"}, "summary": {"zh": "千觉机器人于 2024 年 10 月完成数千万元天使轮融资，由高瓴创投、璞跃中国领投。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20250507A068DO00", "publisher": "瑞财经（腾讯新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/news-2025-05-06-qianjue-seed-rounds.html"}]}, {"path": "events/2025/03/evt-2025-03-qianjue-deployment-agibot-tactile-solution.yaml", "id": "evt-2025-03-qianjue-deployment-agibot-tactile-solution", "orgs": [{"id": "qianjue", "role": "subject"}, {"id": "agibot", "role": "customer"}], "title": {"zh": "千觉机器人触觉感知方案落地智元机器人"}, "summary": {"zh": "千觉机器人自主研发的触觉仿真工具 Xense_Sim 与多模态高精度触觉传感器 G1-WS 落地应用于智元机器人，用于完备数据采集模态。G1-WS 专为机器人夹爪设计，三维形状测量分辨率为每平方厘米 5 万个测量点，X/Y 方向精度 0.03mm、Z 方向精度 0.06mm，每帧力场处理时间 10ms；Xense_Sim 可模拟切向运动与力信息，处理速度 50Hz，已集成至 Isaac Sim 仿真平台。"}, "evidence": [{"url": "https://www.geekpark.net/news/346630", "publisher": "极客公园", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/geekpark-2025-03-qianjue-agibot-deploy-ge.html"}, {"url": "https://sensor.ofweek.com/2025-05/ART-81013-8120-30662389.html", "publisher": "OFweek传感器网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/sensor-2025-03-qianjue-agibot-deploy.html"}]}, {"path": "events/2025/02/evt-2025-02-qianjue-funding-angel-plus-round.yaml", "id": "evt-2025-02-qianjue-funding-angel-plus-round", "orgs": [{"id": "qianjue", "role": "subject"}, {"id": "agibot", "role": "investor"}], "title": {"zh": "千觉机器人完成天使 + 轮融资，智元机器人入股"}, "summary": {"zh": "千觉机器人于 2025 年 2 月完成天使 + 轮融资，投资人为智元机器人。报道引用企查查数据称，智元机器人持有千觉机器人约 1.45% 股权。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20250507A068DO00", "publisher": "瑞财经（腾讯新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/news-2025-05-06-qianjue-seed-rounds.html"}]}, {"path": "events/2025/10/evt-2025-10-qianjue-funding-pre-a-round.yaml", "id": "evt-2025-10-qianjue-funding-pre-a-round", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人完成亿元级 Pre-A 轮融资，孚腾资本领投、理想汽车参投"}, "summary": {"zh": "千觉机器人（Xense Robotics）宣布完成亿元级 Pre-A 轮融资，为其 2025 年内第三轮融资。本轮由孚腾资本（上海具身智能基金）领投，理想汽车等产业方及彬复资本、科实资本联合参投，高瓴创投、元禾原点、戈壁创投等老股东加注。报道称公司成立于 2024 年 5 月，总部上海。"}, "evidence": [{"url": "https://www.sensorexpert.com.cn/article/435934.html", "publisher": "传感器专家网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/sensorexpert-2025-10-qianjue-pre-a-round.html"}]}, {"path": "events/2025/05/evt-2025-05-06-qianjue-funding-tens-of-millions-round.yaml", "id": "evt-2025-05-06-qianjue-funding-tens-of-millions-round", "orgs": [{"id": "qianjue", "role": "subject"}], "title": {"zh": "千觉机器人完成数千万元新一轮融资"}, "summary": {"zh": "5 月 6 日消息，千觉机器人科技（上海）有限公司近日完成数千万元融资，最新一轮由元禾原点、戈壁创投、小苗朗程投资，资金将用于技术研发投入和产品迭代、加快量产交付速度。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20250506A0277G00", "publisher": "硬氪（腾讯新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/news-2025-05-06-qianjue-round-36kr.html"}]}]