[{"path": "events/2026/02/evt-2026-02-spirit-ai-funding-two-rounds.yaml", "id": "evt-2026-02-spirit-ai-funding-two-rounds", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能连续完成两轮融资近 20 亿元，云锋基金、红杉中国等参与"}, "summary": {"zh": "2026 年 2 月，千寻智能宣布连续完成两轮融资近 20 亿元人民币，投资方包括云锋基金、混沌投资、红杉中国、Synstellation Capital、TCL 创投、明荟致远、重庆产业投资母基金、杭州金投、360 基金、厚雪资本等，顺为资本、Prosperity7、达晨财智等老股东继续认购。36 氪报道称本轮后公司估值突破百亿元。"}, "evidence": [{"url": "https://www.spirit-ai.com/news/26", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/spirit-ai-2026-02-spirit-ai-feb-rounds.html"}, {"url": "https://www.36kr.com/p/3756015111291654", "publisher": "36 氪 · 转载投资界", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/36kr-2026-04-07-spirit-ai-a-round-www.html"}]}, {"path": "events/2026/04/evt-2026-04-07-spirit-ai-funding-a-round-1b.yaml", "id": "evt-2026-04-07-spirit-ai-funding-a-round-1b", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能宣布获 10 亿元新融资，顺为资本、云锋基金联合领投"}, "summary": {"zh": "4 月 7 日，千寻智能宣布再获 10 亿元人民币融资，由顺为资本、云锋基金联合领投，达晨财智、银河源汇、图灵基金、新鼎资本、庚辛资本等参与。报道称这距上一轮 20 亿元融资官宣仅一个多月。"}, "evidence": [{"url": "https://www.36kr.com/p/3756015111291654", "publisher": "36 氪 · 转载投资界", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/36kr-2026-04-07-spirit-ai-a-round-www.html"}]}, {"path": "events/2026/06/evt-2026-06-03-spirit-ai-funding-a-plus-round.yaml", "id": "evt-2026-06-03-spirit-ai-funding-a-plus-round", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能完成 15 亿元 A+ 轮融资，同日宣布 Spirit v1.6 登顶 RoboArena"}, "summary": {"zh": "6 月 3 日，千寻智能宣布完成 15 亿元人民币 A+ 轮融资，股东包含一线美元基金、大型产业投资方及国资基金，老股东继续加码，具体投资方名单未披露。同日公司宣布其具身基座模型 Spirit v1.6 在 RoboArena 评测中综合得分第一。报道称公司三个月内完成四轮融资，累计近 50 亿元。"}, "evidence": [{"url": "https://www.spirit-ai.com/news/34", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/spirit-ai-2026-06-03-spirit-ai-a-plus-round.html"}, {"url": "https://finance.sina.com.cn/wm/2026-06-03/doc-iniacxkk4007887.shtml", "publisher": "新浪财经 · AI 资本局", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/finance-2026-06-03-spirit-ai-a-plus-round-s.html"}]}, {"path": "events/2026/05/evt-2026-05-20-spirit-ai-partnership-d-robotics.yaml", "id": "evt-2026-05-20-spirit-ai-partnership-d-robotics", "orgs": [{"id": "spirit-ai", "role": "subject"}, {"id": "d-robotics", "role": "counterparty"}], "title": {"zh": "千寻智能与地瓜机器人达成战略合作，Spirit v1.5 完成与旭日 S600 适配"}, "summary": {"zh": "2026 年 5 月 20 日，千寻智能宣布与地瓜机器人达成战略合作，双方已完成千寻开源具身模型 Spirit v1.5 与地瓜旭日 S600 大算力平台（560TOPS INT8）的适配，Spirit v1.5 可在该平台实现端到端推理。官方称 Spirit v1.5 采用 VLA 统一建模框架。"}, "evidence": [{"url": "https://www.spirit-ai.com/news/32", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/spirit-ai-2026-05-20-spirit-ai-d-robotics-par.html"}]}, {"path": "events/2024/11/evt-2024-11-11-spirit-ai-funding-angel-plus.yaml", "id": "evt-2024-11-11-spirit-ai-funding-angel-plus", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能完成天使+轮融资"}, "summary": {"zh": "2024 年 11 月 11 日，千寻智能官宣完成天使+轮融资，由柏睿资本独家注资。报道称公司自成立至今在半年多时间里已完成三轮融资，新融资将用于人才引进和商业化场景下的产品迭代及业务拓展。金额未在该稿中给出确定数字。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/1407545.html", "publisher": "证券时报网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/stcn-2024-11-spirit-ai-angel-plus.html"}]}, {"path": "events/2025/03/evt-2025-03-spirit-ai-product_launch-spirit-v1-preview.yaml", "id": "evt-2025-03-spirit-ai-product_launch-spirit-v1-preview", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能发布自研 VLA 模型 Spirit v1 抢先版"}, "summary": {"zh": "官网产品进展写「2025 年 3 月，千寻智能发布 Spirit V1 VLA 模型抢先版」。同期官网融资稿称，抢先版演示视频中机器人已可实现叠衣服全流程顺畅操作，完成连续长程复杂任务，并称 Spirit v1 可根据自然语言指令完成多任务连续操作。"}, "evidence": [{"url": "https://spirit-ai.com/news/8", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/spirit-ai-2025-03-spirit-ai-spirit-v1.html"}, {"url": "https://spirit-ai.com/news/6", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/spirit-ai-2025-03-spirit-ai-pre-a.html"}]}, {"path": "events/2025/03/evt-2025-03-31-spirit-ai-funding-pre-a-round.yaml", "id": "evt-2025-03-31-spirit-ai-funding-pre-a-round", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能完成 5.28 亿元 Pre-A 轮融资"}, "summary": {"zh": "3 月 31 日，千寻智能完成 5.28 亿元人民币 Pre-A 轮融资。本轮由阿美风险投资旗下 Prosperity7 Ventures（P7）领投，招商局创投、广发信德、靖亚资本、东方富海、华控基金等参与，华发集团、浙江省科创母基金与浙江东方共同发起设立的善富科创子基金参与；老股东达晨财智、柏睿资本、弘晖基金、千乘资本持续加码。"}, "evidence": [{"url": "https://spirit-ai.com/news/6", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/spirit-ai-2025-03-spirit-ai-pre-a.html"}, {"url": "https://www.caixin.com/2025-03-31/102304317.html", "publisher": "财新网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/caixin-2025-03-spirit-ai-pre-a-caixin.html"}]}, {"path": "events/2025/07/evt-2025-07-21-spirit-ai-funding-pre-a-plus-round.yaml", "id": "evt-2025-07-21-spirit-ai-funding-pre-a-plus-round", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能完成 PreA+ 轮融资，京东领投"}, "summary": {"zh": "7 月 21 日，千寻智能披露完成 PreA+ 轮融资，原文表述为「近 6 亿元」。本轮由京东领投，中国互联网投资基金、浙江省科创母基金、华泰紫金、复星锐正等跟投，Prosperity7 Ventures、顺为资本、华控基金、千乘资本、靖亚资本、弘晖基金等老股东超额追加，高鹄资本担任独家财务顾问。"}, "evidence": [{"url": "https://www.spirit-ai.com/news/11", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/spirit-ai-2025-07-spirit-ai-pre-a-plus.html"}, {"url": "https://stcn.com/article/detail/2665886.html", "publisher": "证券时报网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/stcn-2025-07-spirit-ai-pre-a-plus-stc.html"}]}, {"path": "events/2025/12/evt-2025-12-17-spirit-ai-deployment-catl-pack-line.yaml", "id": "evt-2025-12-17-spirit-ai-deployment-catl-pack-line", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能人形机器人「小墨」在宁德时代中州基地电池 PACK 产线规模化上岗"}, "summary": {"zh": "12 月 17 日，千寻智能宣布其人形机器人「小墨」正式在宁德时代中州基地新能源动力电池 PACK 生产线上岗，承担电池包下线前 EOL 与 DCR 工序的高压测试插头插接作业。官方称机器人搭载端到端视觉-语言-动作（VLA）模型，插接成功率稳定在 99% 以上，单日工作量较人工提升三倍。"}, "evidence": [{"url": "https://www.ncsti.gov.cn/kjdt/xwjj/202512/t20251219_232737.html", "publisher": "北京市科学技术委员会网站 · 转载北京海淀公众号", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/ncsti-2025-12-17-spirit-ai-catl-deploymen.html"}, {"url": "https://www.spirit-ai.com/news/22", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/spirit-ai-2025-12-17-spirit-ai-catl-deploymen.html"}]}, {"path": "events/2025/06/evt-2025-06-spirit-ai-product_launch-moz1.yaml", "id": "evt-2025-06-spirit-ai-product_launch-moz1", "orgs": [{"id": "spirit-ai", "role": "subject"}], "title": {"zh": "千寻智能正式发布全身力控人形机器人 Moz1"}, "summary": {"zh": "2025 年 6 月，千寻智能正式发布首款商用级人形机器人 Moz1。报道称 Moz1 全身配置 26 个自由度，搭载一体化力控关节与高精高速 WBC 算法，负载自重比达 1:1，可实现全身零延时遥操作，并搭载公司自研 VLA 模型 Spirit v1。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/2763729.html", "publisher": "证券时报网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/stcn-2025-06-spirit-ai-moz1-launch.html"}, {"url": "https://spirit-ai.com/news/8", "publisher": "千寻智能官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/spirit-ai-2025-03-spirit-ai-spirit-v1.html"}]}]