[{"path": "events/2026/02/evt-2026-02-modelbest-funding-china-telecom-round.yaml", "id": "evt-2026-02-modelbest-funding-china-telecom-round", "orgs": [{"id": "modelbest", "role": "subject"}], "title": {"zh": "面壁智能完成数亿元融资，中国电信领投"}, "summary": {"zh": "澎湃新闻 2026 年 2 月 28 日报道，北京面壁智能科技有限责任公司日前完成春节后新一轮融资，规模为数亿元，由中国电信领投，中信金石、中信私募跟投。"}, "evidence": [{"url": "https://finance.sina.com.cn/jjxw/2026-02-28/doc-inhpkaqh5968732.shtml", "publisher": "新浪财经（转载澎湃新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/finance-2026-02-modelbest-china-telecom-.html"}]}, {"path": "events/2026/07/evt-2026-07-19-modelbest-product-launch-minicpm-robot.yaml", "id": "evt-2026-07-19-modelbest-product-launch-minicpm-robot", "orgs": [{"id": "modelbest", "role": "subject"}, {"id": "unitree", "role": "supplier"}], "title": {"zh": "面壁智能在 WAIC 2026 发布首个具身智能模型系列 MiniCPM-Robot"}, "summary": {"zh": "WAIC 2026 期间，面壁智能发布并开源首个具身智能系列成果 MiniCPM-Robot，包括面向机器人操作的通用 VLA 模型 MiniCPM-RobotManip（1.5B 参数）和面向移动机器人跟踪导航的 MiniCPM-RobotTrack（与南京大学合作，适配宇树 Go2 Edu，支持本地断网部署）。"}, "evidence": [{"url": "https://www.zhidx.com/p/577495.html", "publisher": "智东西", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/zhidx-2026-07-19-modelbest-minicpm-robot.html"}]}, {"path": "events/2026/07/evt-2026-07-15-modelbest-funding-2026-07-round.yaml", "id": "evt-2026-07-15-modelbest-funding-2026-07-round", "orgs": [{"id": "modelbest", "role": "subject"}], "title": {"zh": "面壁智能宣布完成新一轮融资，2026 年上半年累计融资超 50 亿元"}, "summary": {"zh": "智东西 7 月 15 日报道，面壁智能当日宣布完成新一轮融资，投资方包括国家级基金、央企、汽车制造商等产业方与财务投资机构，具体名单与金额未公开。报道称公司 2026 年上半年累计融资金额超 50 亿元，估值超 200 亿元。"}, "evidence": [{"url": "https://zhidx.com/p/575756.html", "publisher": "智东西", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/zhidx-2026-07-15-modelbest-2026-07-round.html"}]}, {"path": "events/2026/07/evt-2026-07-19-modelbest-partnership-leju-geely.yaml", "id": "evt-2026-07-19-modelbest-partnership-leju-geely", "orgs": [{"id": "modelbest", "role": "subject"}, {"id": "leju", "role": "counterparty"}], "title": {"zh": "面壁智能与乐聚机器人、吉利汽车推出具身智能落地方案"}, "summary": {"zh": "WAIC 2026 期间面壁智能披露：与吉利汽车合作，将其 VLM 多模态模型与吉利机器人本体、VLA 模型及导航系统集成，落地生产仓储场景；与乐聚机器人联合推出展厅导览 Agent 方案（无网络环境纯端侧运行）和园区巡检方案（识别车辆违停、路面与公共设施异常）。"}, "evidence": [{"url": "https://finance.sina.com.cn/stock/t/2026-07-23/doc-iniiusma7781160.shtml", "publisher": "新浪财经（转载智东西）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/finance-2026-07-19-modelbest-leju-geely.html"}]}, {"path": "events/2026/04/evt-2026-04-modelbest-funding-shenzhen-round.yaml", "id": "evt-2026-04-modelbest-funding-shenzhen-round", "orgs": [{"id": "modelbest", "role": "subject"}], "title": {"zh": "面壁智能完成数亿元融资，深创投、汇川产投联合领投"}, "summary": {"zh": "科创板日报 4 月 9 日报道，面壁智能近日宣布完成新一轮数亿元人民币融资，由深创投、汇川技术旗下汇川产投联合领投，道禾长期投资、国泰海通创新投、武岳峰科创等跟投。报道称这是公司 2026 年完成的第二笔融资，一季度累计融资规模超 10 亿元。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20260409A035TD00", "publisher": "腾讯新闻（转载科创板日报）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/news-2026-04-modelbest-shenzhen-round.html"}]}, {"path": "events/2024/12/evt-2024-12-11-modelbest-funding-2024-12-round.yaml", "id": "evt-2024-12-11-modelbest-funding-2024-12-round", "orgs": [{"id": "modelbest", "role": "subject"}], "title": {"zh": "面壁智能完成新一轮数亿元融资"}, "summary": {"zh": "21 世纪经济报道 2024 年 12 月 11 日报道，面壁智能当天宣布完成新一轮数亿元融资，由龙芯创投、鼎晖百孚、中关村科学城基金和赛富投资基金联合领投，北京市人工智能产业投资基金与清科创投跟投。公司称融资后将提速以端侧 AI 为代表的高效大模型商业化布局。"}, "evidence": [{"url": "https://www.21jingji.com/article/20241211/herald/6f86bfc09bd1053c8ea23edfe9ae7a4f.html", "publisher": "21 世纪经济报道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/21jingji-2024-12-11-modelbest-funding-2024-1.html"}]}, {"path": "events/2025/12/evt-2025-12-23-modelbest-funding-2025-12-round.yaml", "id": "evt-2025-12-23-modelbest-funding-2025-12-round", "orgs": [{"id": "modelbest", "role": "subject"}], "title": {"zh": "面壁智能完成数亿元融资，京国瑞、国科投资等参与"}, "summary": {"z