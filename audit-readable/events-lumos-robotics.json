[{"path": "events/2026/07/evt-2026-07-14-lumos-robotics-partnership-jd.yaml", "id": "evt-2026-07-14-lumos-robotics-partnership-jd", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人与京东签署战略合作，目标三年内京东平台累计销售额突破 10 亿元"}, "summary": {"zh": "鹿明机器人与京东签署战略合作协议，以产品共创、技术协同、场景拓展、渠道共建为核心，未来三年共同投入产品、供应链及生态资源，目标实现鹿明全系列产品在京东平台累计销售额突破 10 亿元；双方围绕 JoyInside、JoyAI 等能力协同研发，并联合打造面向工业制造、数据采集、智慧巡检的一体化方案。"}, "evidence": [{"url": "https://www.gasgoo.com/robot/news/70465668-3%E5%B9%B410%E4%BA%BF%E9%94%80%E5%94%AE%E9%A2%9D-%E9%B9%BF%E6%98%8E%E6%9C%BA%E5%99%A8%E4%BA%BA%E4%B8%8E%E4%BA%AC%E4%B8%9C%E8%BE%BE%E6%88%90%E6%88%98%E7%95%A5%E5%90%88%E4%BD%9C/", "publisher": "盖世汽车", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/gasgoo-2026-07-14-lumos-robotics-jd-partne.html"}, {"url": "https://www.pai.com.cn/p/01kxfnk8r40wj822rfg4kjqr7c", "publisher": "电商派", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/pai-2026-07-14-lumos-robotics-jd-partne.html"}]}, {"path": "events/2026/09/evt-2026-09-19-lumos-robotics-deployment-theater.yaml", "id": "evt-2026-09-19-lumos-robotics-deployment-theater", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人剧场《机器人和 TA 的朋友们》在深圳全球首演"}, "summary": {"zh": "由鹿明机器人与深圳市文旅产业发展有限公司共同打造的机器人剧场在深圳市宝安区青少年宫首场公演。45 分钟沉浸式演出，由机器人主持全程串联，涵盖舞蹈、相声、小品、武术、DJ 秀、魔术六大品类，多台机器人协同参演。该剧场将由深圳文旅进行常态化运营。"}, "evidence": [{"url": "https://www.leiphone.com/category/industrynews/KQYlP3qCFGorz4hm.html", "publisher": "雷峰网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/leiphone-2026-09-19-lumos.html"}]}, {"path": "events/2026/08/evt-2026-08-19-lumos-robotics-product_launch-nexcore.yaml", "id": "evt-2026-08-19-lumos-robotics-product_launch-nexcore", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人在 WRC 2026 首发技能进化引擎 Lumos NexCore，并展出重载轮臂机器人 MOS2"}, "summary": {"zh": "8 月 19 日，鹿明机器人在 2026 世界机器人大会首发机器人技能进化引擎 Lumos NexCore，打通任务定义、数据接入、模型训练、技能评测、部署运行到持续学习的链路，采用平台订阅加训练算力、真机验证和技能授权的组合收费模式；同场展出第二代重载轮臂式机器人 MOS2，双臂负载 50kg。"}, "evidence": [{"url": "https://finance.sina.com.cn/roll/2026-08-19/doc-ininvmyq8303221.shtml", "publisher": "新浪财经（来源：机器之心）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/finance-2026-08-19-lumos-robotics-nexcore.html"}, {"url": "https://www.tmtpost.com/nictation/8108562.html", "publisher": "钛媒体", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/tmtpost-2026-08-19-lumos-robotics-nexcore-t.html"}]}, {"path": "events/2026/05/evt-2026-05-11-lumos-robotics-funding-a1-a2.yaml", "id": "evt-2026-05-11-lumos-robotics-funding-a1-a2", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人完成数亿元 A1 及 A2 轮融资，三菱电机连续领投，累计融资近 10 亿元"}, "summary": {"zh": "鹿明机器人宣布连续完成 A1 及 A2 两轮融资。A1 轮由三菱电机智能制造科技（中国）集团有限公司领投，老股东普华资本、吴中金控等跟投；A2 轮由三菱电机继续领投，恒生电子、海高集团、昆石投资等跟投。两轮完成后公司累计融资近 10 亿元，资金用于具身大模型研发和场景拓展。"}, "evidence": [{"url": "https://www.jiemian.com/article/14408632.html", "publisher": "界面新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/jiemian-2026-05-11-lumos-robotics-a1-a2.html"}, {"url": "https://fgw.sz.gov.cn/ztzl/qtztzl/szscjmyjjfzzhfwpt/mqfc/myqyfzdt/content/post_12909785.html", "publisher": "深圳市发展和改革委员会网站（转载搜狐）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/fgw-2026-05-11-lumos-robotics-a1-a2-szf.html"}]}, {"path": "events/2024/12/evt-2024-12-lumos-robotics-product_launch-lus1.yaml", "id": "evt-2024-12-lumos-robotics-product_launch-lus1", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人发布全尺寸双足人形机器人 Lumos LUS1"}, "summary": {"zh": "鹿明机器人官网里程碑写明 2024 年 12 月发布全尺寸双足人形机器人 Lumos LUS1，官网称这是其人形机器人平台研发的第一个重要里程碑。"}, "evidence": [{"url": "https://www.lumosbot.tech/about/", "publisher": "鹿明机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/lumosbot-2024-12-lumos-robotics-milestone.html"}]}, {"path": "events/2025/04/evt-2025-04-09-lumos-robotics-funding-angel-and-angel-plus.yaml", "id": "evt-2025-04-09-lumos-robotics-funding-angel-and-angel-plus", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人完成天使轮及天使+轮两轮融资，原话为「近亿元」"}, "summary": {"zh": "4 月 9 日，鹿明机器人宣布在成立半年内连续完成天使轮及天使+轮两轮融资，报道原话为「近亿元」，未披露确定金额。天使轮由英诺天使基金、商汤国香资本、梅花创投联合投资；天使+轮由普华资本、香港科技大学工学院创院院长高秉强等联合投资，老股东行使超额认购权；瑞辰资本担任独家财务顾问。报道写明资金用于加速核心技术研发、高端人才引进与产品化商业化落地。公司官网里程碑把这两轮记在 2025.04。"}, "evidence": [{"url": "https://news.pedaily.cn/202504/548124.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/news-2025-04-09-lumos-robotics-angel-plu.html"}, {"url": "https://www.lumosbot.tech/about/", "publisher": "鹿明机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/lumosbot-2025-06-lumos-robotics-milestone.html"}]}, {"path": "events/2025/08/evt-2025-08-lumos-robotics-product_launch-mos1-and-nix.yaml", "id": "evt-2025-08-lumos-robotics-product_launch-mos1-and-nix", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人发布重载轮式双臂机器人 Lumos MOS 1 与迷你双足人形机器人 Lumos NIX"}, "summary": {"zh": "鹿明机器人官网里程碑写明 2025 年 8 月发布两款产品：Lumos MOS 1，官网称其为全球首款双臂负载 50 公斤的重载轮式双臂具身机器人；以及 Lumos NIX，一款迷你双足人形机器人。同月官网记录 Lumos LUS2 在首届世界人形机器人运动会团体舞比赛中获得银牌。"}, "evidence": [{"url": "https://www.lumosbot.tech/about/", "publisher": "鹿明机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/lumosbot-2025-08-lumos-robotics-milestone.html"}]}, {"path": "events/2025/06/evt-2025-06-lumos-robotics-product_launch-lus2.yaml", "id": "evt-2025-06-lumos-robotics-product_launch-lus2", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人发布全尺寸双足人形机器人 Lumos LUS2"}, "summary": {"zh": "鹿明机器人官网里程碑写明 2025 年 6 月发布 Lumos LUS2，官网称其为全球首款能在 1 秒内起身的全尺寸双足人形机器人。"}, "evidence": [{"url": "https://www.lumosbot.tech/about/", "publisher": "鹿明机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/lumosbot-2025-06-lumos-robotics-milestone.html"}]}, {"path": "events/2025/05/evt-2025-05-30-lumos-robotics-funding-angel-plus-plus.yaml", "id": "evt-2025-05-30-lumos-robotics-funding-angel-plus-plus", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人完成天使++轮融资，天使轮累计融资原话为「近 2 亿」"}, "summary": {"zh": "5 月 30 日，鹿明机器人宣布完成天使++轮融资，投资方包括复星锐正、德马科技（688360.SH）和吴中金控，本轮未披露金额。报道写明这是公司两个月内完成的第二轮融资、半年内完成的第三轮融资，天使轮累计融资原话为「近 2 亿」。资金用于完善产品及深化产业协同，加速与产业方的合作。"}, "evidence": [{"url": "https://news.pedaily.cn/202505/550373.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/news-2025-05-30-lumos-robotics-angel-pp.html"}, {"url": "https://www.lumosbot.tech/about/", "publisher": "鹿明机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/lumosbot-2025-05-lumos-robotics-milestone.html"}]}, {"path": "events/2025/05/evt-2025-05-lumos-robotics-product_launch-lux-tactile-module.yaml", "id": "evt-2025-05-lumos-robotics-product_launch-lux-tactile-module", "orgs": [{"id": "lumos-robotics", "role": "subject"}], "title": {"zh": "鹿明机器人发布 LUX 系列视触觉模组"}, "summary": {"zh": "鹿明机器人官网里程碑写明 2025 年 5 月发布 LUX 系列视触觉模组。投资界稿件写明这是公司旗下首款核心零部件产品，为具身智能行业提供高精度、高可靠性的关键零部件解决方案。"}, "evidence": [{"url": "https://www.lumosbot.tech/about/", "publisher": "鹿明机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/lumosbot-2025-05-lumos-robotics-milestone.html"}, {"url": "https://news.pedaily.cn/202505/550373.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/news-2025-05-30-lumos-robotics-angel-pp.html"}]}]