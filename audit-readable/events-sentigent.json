[{"path": "events/2026/07/evt-2026-07-20-sentigent-product_launch-swan-architecture.yaml", "id": "evt-2026-07-20-sentigent-product_launch-swan-architecture", "orgs": [{"id": "sentigent", "role": "subject"}], "title": {"zh": "深庭纪发布户外伴随机器人具身智能架构 SWAN"}, "summary": {"zh": "7 月 20 日，深庭纪发布户外伴随机器人专属具身智能架构 SWAN，部署于端侧实时运行，由模型推理主链、混合记忆身份数据库、安全数据飞轮系统三大模块组成，支持跟随、守护、自主表达与意图响应。SWAN 将率先落地 Rovar 机器人，公司称产品计划年底上市，并已完成 Pre-A 轮融资。"}, "evidence": [{"url": "http://www.chinaups.com/news/20260721/127127.html", "publisher": "UPS 科技网（来源：证券时报网人民财讯）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/chinaups-2026-07-20-sentigent-swan.html"}, {"url": "https://www.yfchuhai.com/news/10234608.html", "publisher": "扬帆出海（转载 36 氪）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/yfchuhai-2026-07-20-sentigent-swan-36kr.html"}]}, {"path": "events/2026/01/evt-2026-01-sentigent-funding-angel.yaml", "id": "evt-2026-01-sentigent-funding-angel", "orgs": [{"id": "sentigent", "role": "subject"}], "title": {"zh": "深庭纪完成亿元天使轮融资，蓝驰创投领投"}, "summary": {"zh": "苏州深庭纪智能科技有限公司宣布完成亿元天使轮融资，由蓝驰创投领投，老股东 Particle Future（粒子未来基金）加投，距 2025 年 7 月的数千万元种子+轮半年。资金用于研发、产品创新与团队建设，推进 2026 年下半年产品量产。"}, "evidence": [{"url": "https://www.xhby.net/content/s695b1eece4b05fbb22fdf527.html", "publisher": "新华报业网（新华日报财经）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/xhby-2026-01-sentigent-angel-round.html"}, {"url": "https://eu.36kr.com/zh/p/3638686789454983", "publisher": "36 氪出海（智能涌现）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/eu-2026-01-sentigent-angel-round-36.html"}]}, {"path": "events/2025/07/evt-2025-07-08-sentigent-funding-seed-plus.yaml", "id": "evt-2025-07-08-sentigent-funding-seed-plus", "orgs": [{"id": "sentigent", "role": "subject"}], "title": {"zh": "深庭纪智能完成种子+轮融资，原话为「数千万元人民币」"}, "summary": {"zh": "7 月 8 日，AI 伴随机器人研发商深庭纪智能科技宣布完成种子+轮融资，报道原话为「数千万元人民币」，未披露确定金额，由黑芝麻智能、软通高科、粒子未来基金等机构参投。报道写明资金主要用于具身大脑的核心能力建设、完善从感知、认知到决策的闭环架构，以及加速新一代机器人产品的量产落地。"}, "evidence": [{"url": "http://www.eeo.com.cn/2025/0708/736999.shtml", "publisher": "经济观察网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/eeo-2025-07-08-sentigent-seed-plus.html"}, {"url": "https://news.pedaily.cn/202507/552054.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/news-2025-07-08-sentigent-seed-plus-peda.html"}]}, {"path": "events/2025/12/evt-2025-12-sentigent-product_launch-rovar-x3.yaml", "id": "evt-2025-12-sentigent-product_launch-rovar-x3", "orgs": [{"id": "sentigent", "role": "subject"}], "title": {"zh": "深庭纪发布双轮足户外陪伴机器人 Rovar X3"}, "summary": {"zh": "苏州深庭纪智能科技有限公司发布双轮足户外陪伴机器人 Rovar X3，主打户外跟随、载物运送、摄影跟拍与宠物陪伴，采用直驱轮毂电机驱动。报道称产品已通过多项户外场景测试并在国外内测，将于 2026 年 1 月登陆 CES。"}, "evidence": [{"url": "https://news.2500sz.com/doc/2025/12/23/1187570.shtml", "publisher": "名城苏州网（来源：苏州新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/news-2025-12-sentigent-rovar-x3-launc.html"}]}]