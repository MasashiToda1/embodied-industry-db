[{"path": "events/2026/08/evt-2026-08-26-jianzhi-robot-funding-a-round-momenta.yaml", "id": "evt-2026-08-26-jianzhi-robot-funding-a-round-momenta", "orgs": [{"id": "jianzhi-robot", "role": "subject"}], "title": {"zh": "简智机器人完成 A 轮融资，Momenta 领投，累计融资超 2 亿美元"}, "summary": {"zh": "8 月 26 日，简智机器人宣布完成 A 轮融资，由 Momenta 领投，多家老股东追投，本轮金额未披露。公司称成立一年内完成 7 轮融资，累计融资总额「超 2 亿美元」。资金投向无本体数据基础设施、Data Foundation Model 迭代、真机评测闭环与全球化业务。"}, "evidence": [{"url": "https://robot.ofweek.com/2026-08/ART-8321201-8140-30700216.html", "publisher": "OFweek 机器人网 · 转载具身涌现", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/robot-2026-08-26-jianzhi-robot-a-round-mo.html"}]}, {"path": "events/2026/06/evt-2026-06-01-jianzhi-robot-funding-multi-round-ant-didi.yaml", "id": "evt-2026-06-01-jianzhi-robot-funding-multi-round-ant-didi", "orgs": [{"id": "jianzhi-robot", "role": "subject"}], "title": {"zh": "简智机器人完成连续多轮共数亿元融资，蚂蚁集团、滴滴、德联资本分别领投"}, "summary": {"zh": "6 月 1 日，简智机器人宣布完成连续多轮共「数亿元」融资，分别由蚂蚁集团、滴滴、德联资本领投，顺为资本、BV 百度风投、九识智能等老股东跟投。资金用于人类行为数据的多模态采集矩阵、数据治理与效果评测全链路建设。"}, "evidence": [{"url": "https://www.36kr.com/p/3834105574270600", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/36kr-2026-06-01-jianzhi-robot-multi-roun.html"}]}, {"path": "events/2025/12/evt-2025-12-18-jianzhi-robot-funding-angel-round.yaml", "id": "evt-2025-12-18-jianzhi-robot-funding-angel-round", "orgs": [{"id": "jianzhi-robot", "role": "subject"}, {"id": "robosense", "role": "investor"}, {"id": "galaxea", "role": "investor"}], "title": {"zh": "简智机器人完成第三轮（天使轮）融资，顺为资本领投；成立 4 个月三轮融资总额超 2 亿元"}, "summary": {"zh": "12 月 18 日，据顺为资本官微消息，简智机器人完成第三轮融资，为公司成立 4 个月内的第 3 轮，三轮总额「超 2 亿元」。种子轮由 BV 百度风投领投，Momenta、九识、星海图跟投；种子 + 轮由速腾聚创领投，BV 百度风投跟投；天使轮由顺为领投，初心资本、BV 百度风投超额跟投。"}, "evidence": [{"url": "https://www.nbd.com.cn/articles/2025-12-19/4186954.html", "publisher": "每日经济新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/nbd-2025-12-18-jianzhi-robot-angel-roun.html"}]}, {"path": "events/2025/05/evt-2025-05-29-jianzhi-robot-corporate-incorporation.yaml", "id": "evt-2025-05-29-jianzhi-robot-corporate-incorporation", "orgs": [{"id": "jianzhi-robot", "role": "subject"}], "title": {"zh": "简智新创（北京）机器人科技有限公司成立"}, "summary": {"zh": "投资界公司页载工商信息：简智新创（北京）机器人科技有限公司成立于 2025 年 5 月 29 日，所属行业为软件和信息技术服务业，注册地址为北京市海淀区中关村东路 1 号院 7 号楼 3 层 301。OFweek 报道亦载该公司「2025 年 5 月正式成立」。公司主营具身智能多模态数据采集与治理，产品为 DAS 数据采集系统及配套数据治理平台。"}, "evidence": [{"url": "https://vc.pedaily.cn/company/822267.html", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/vc-2025-05-29-jianzhi-robot-incorporat.html"}, {"url": "https://robot.ofweek.com/2026-08/ART-8321201-8140-30700216.html", "publisher": "OFweek 机器人网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/robot-2025-05-jianzhi-robot-founded-ma.html"}]}]