[{"path": "events/2026/02/evt-2026-02-roboscience-funding-pre-a-round.yaml", "id": "evt-2026-02-roboscience-funding-pre-a-round", "orgs": [{"id": "roboscience", "role": "subject"}], "title": {"zh": "RoboScience 机器科学完成数亿元 Pre-A 轮融资，普华资本领投"}, "summary": {"zh": "智东西 5 月 6 日报道回顾，RoboScience 机器科学 2026 年 2 月完成数亿元 Pre-A 轮融资，投资方包括普华资本、达晨财智、长石资本、香港慧科科创、天启资本、招商局创投、零一创投等。财经天下报道称本轮由普华资本领投。"}, "evidence": [{"url": "https://zhidx.com/p/555152.html", "publisher": "智东西（机器人前瞻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/zhidx-2026-05-roboscience-a-round.html"}, {"url": "http://www.caijingtx.com/cjnews/2026/010329529.html", "publisher": "财经天下", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/caijingtx-2026-08-17-roboscience-rex-g1-wrc.html"}]}, {"path": "events/2026/08/evt-2026-08-17-roboscience-product-launch-rex-g1.yaml", "id": "evt-2026-08-17-roboscience-product-launch-rex-g1", "orgs": [{"id": "roboscience", "role": "subject"}], "title": {"zh": "RoboScience 机器科学发布轮式仿人形通用操作机器人 REX G1"}, "summary": {"zh": "8 月 17 日，RoboScience 机器科学发布首款产品——轮式仿人形通用操作机器人 REX G1，搭载自研 VLOA 架构通用具身大模型 Visics，面向物流、工厂、零售及家庭场景。财经天下报道其全身 22 个关节自由度，双臂负载 10 公斤，端侧算力 2070 TFLOPS，续航最长 4 小时并支持热插拔换电，在 WRC 2026 首秀。"}, "evidence": [{"url": "https://www.gasgoo.com/robot/news/70469349-roboscience%E5%8F%91%E5%B8%83rex/", "publisher": "盖世汽车", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/gasgoo-2026-08-17-roboscience-rex-g1.html"}, {"url": "http://www.caijingtx.com/cjnews/2026/010329529.html", "publisher": "财经天下", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/caijingtx-2026-08-17-roboscience-rex-g1-wrc.html"}]}, {"path": "events/2026/05/evt-2026-05-roboscience-funding-a-round.yaml", "id": "evt-2026-05-roboscience-funding-a-round", "orgs": [{"id": "roboscience", "role": "subject"}], "title": {"zh": "RoboScience 机器科学完成 10 亿元 A 轮融资"}, "summary": {"zh": "AI 科技评论 5 月 6 日报道，RoboScience 机器科学近日完成十亿元 A 轮融资，投资方包含多家国内外产业巨头及一线财务机构，资金用于 VLOA 大模型研发、自研机器人本体工程化与量产。"}, "evidence": [{"url": "https://www.163.com/dy/article/KS7VMOJM0511DPVD.html", "publisher": "网易号（AI 科技评论）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/163-2026-05-roboscience-a-round-163.html"}, {"url": "https://zhidx.com/p/555152.html", "publisher": "智东西（机器人前瞻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/zhidx-2026-05-roboscience-a-round.html"}]}, {"path": "events/2024/12/evt-2024-12-roboscience-corporate-founding.yaml", "id": "evt-2024-12-roboscience-corporate-founding", "orgs": [{"id": "roboscience", "role": "subject"}], "title": {"zh": "北京机科未来科技有限公司注册成立"}, "summary": {"zh": "RoboScience 官网公司新闻写明，公司注册成立于 2024 年 12 月底，自 2025 年 3 月开始正式运营。公司由前苹果设备端机器学习平台技术负责人田野与新加坡国立大学计算机系助理教授邵林共同创立。"}, "evidence": [{"url": "https://www.roboscience.co/jishu_detail/5.html", "publisher": "RoboScience 官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/roboscience-2024-12-roboscience-founding.html"}]}, {"path": "events/2025/03/evt-2025-03-31-roboscience-funding-seed.yaml", "id": "evt-2025-03-31-roboscience-funding-seed", "orgs": [{"id": "roboscience", "role": "subject"}], "title": {"zh": "RoboScience 完成数千万元种子轮融资"}, "summary": {"zh": "钛媒体 2025 年 3 月 31 日报道，具身智能公司 RoboScience（北京机科未来科技有限公司）宣布完成数千万元种子轮融资，由零一创投独家投资，资金用于产品研发和团队搭建。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20250331A02HVN00", "publisher": "腾讯新闻（钛媒体 APP）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/news-2025-03-31-roboscience-seed.html"}]}, {"path": "events/2025/07/evt-2025-07-30-roboscience-funding-angel.yaml", "id": "evt-2025-07-30-roboscience-funding-angel", "orgs": [{"id": "roboscience", "role": "subject"}], "title": {"zh": "RoboScience 完成近 2 亿元天使轮融资，京东领投"}, "summary": {"zh": "RoboScience 官网 2025 年 7 月 30 日公告，公司完成近 2 亿元天使轮融资，由京东领投，招商局创投、商汤国香资本跟投，老股东零一创投继续追投，慕石资本担任本轮独家财务顾问。公告同时说明公司注册成立于 2024 年 12 月底，本轮融资前已完成数千万元种子轮融资。"}, "evidence": [{"url": "https://www.roboscience.co/jishu_detail/5.html", "publisher": "RoboScience 官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/roboscience-2025-07-30-roboscience-angel.html"}]}]