[{"path": "events/2026/08/evt-2026-08-18-digital-china-humanoid-funding-pre-a.yaml", "id": "evt-2026-08-18-digital-china-humanoid-funding-pre-a", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏完成亿元级 Pre-A 轮战略融资，同创伟业继续跟投"}, "summary": {"zh": "数字华夏官网 8 月 18 日发文称，公司近日完成亿元级 Pre-A 轮战略融资，由多家产业资本联合投资，老股东同创伟业继续跟投加注；官方称本轮产业资本同时带来商业订单。资金用于仿生智能系列产品量产和场景大脑 RoboEase 生态建设。领投方名称未披露。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/240.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/digit-2026-08-18-digital-china-humanoid-p.html"}, {"url": "https://www.stcn.com/article/detail/4080059.html", "publisher": "证券时报（人民财讯）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/stcn-2026-08-17-digital-china-humanoid-p.html"}]}, {"path": "events/2026/08/evt-2026-08-28-digital-china-humanoid-product-launch-p02-harmonyos.yaml", "id": "evt-2026-08-28-digital-china-humanoid-product-launch-p02-harmonyos", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏联合深开鸿在数博会发布基于开源鸿蒙的全国产化人形机器人星行侠 P02"}, "summary": {"zh": "8 月 28 日，数字华夏 CEO 沈健在贵阳数博会主会场发布全国产化双形态人形机器人星行侠 P02：支持双足行走与轮式移动切换，官方称核心零部件 100% 本土化配套，搭载 128 TOPS 推理算力「大脑」与 6 TOPS 异构「小脑」，25 个自研一体化关节，底层操作系统基于深开鸿 M-Robots OS 3.0（开源鸿蒙）。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/245.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/digit-2026-08-27-digital-china-humanoid-p.html"}]}, {"path": "events/2026/06/evt-2026-06-18-digital-china-humanoid-partnership-wantian-jv.yaml", "id": "evt-2026-06-18-digital-china-humanoid-partnership-wantian-jv", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏与港股中国万天控股旗下公司签约，共建合资运营平台推动服务人形机器人落地"}, "summary": {"zh": "6 月 18 日，数字华夏（深圳）机器人有限公司与中国万天控股（1854.HK）关联控股子公司深圳万天人工智能科技有限公司签署战略合作框架协议，双方共建合资运营平台，推动服务人形机器人批量落地政务、金融、康养、商业场景，并围绕「出货、出海、出圈」布局东盟、中东、欧美市场。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/225.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/digit-2026-06-18-digital-china-humanoid-w.html"}, {"url": "https://fgw.sz.gov.cn/ztzl/qtztzl/szscjmyjjfzzhfwpt/mqfc/myqyfzdt/content/post_12865797.html", "publisher": "深圳市发展和改革委员会网站（转载深圳新闻网）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/fgw-2026-06-18-digital-china-humanoid-w.html"}]}, {"path": "events/2026/05/evt-2026-05-23-digital-china-humanoid-product-launch-p2-roboease.yaml", "id": "evt-2026-05-23-digital-china-humanoid-product-launch-p2-roboease", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏发布双形态人形机器人星行侠 P2、场景大脑 RoboEase 与健康监护方案 RoboCare"}, "summary": {"zh": "2026 年 5 月 23 日，数字华夏在深圳文博会同期举办新品发布会，发布「星」系列机器人星行侠 P2（双足/轮式「飞兵」双形态、10 小时续航、自主回充、三个版本）、具身智能场景大脑 RoboEase（图形化拖拽配置任务、标准化开发工具链）和面向康养的 RoboCare 健康监护方案。现场与深开鸿等数十家企业签署战略合作协议。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/214.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/digit-2026-05-23-digital-china-humanoid-p.html"}]}, {"path": "events/2025/03/evt-2025-03-18-digital-china-humanoid-partnership-nanjing-center.yaml", "id": "evt-2025-03-18-digital-china-humanoid-partnership-nanjing-center", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏在南京软件谷成立具身智能机器人应用中心，并与江苏移动、科大讯飞签署合作协议"}, "summary": {"zh": "3 月 18 日上午，具身智能机器人应用中心在中国（南京）软件谷成立，由数字华夏旗下华夏机器人（南京）有限公司建设，定位为基于真实交互场景的人形机器人数据采集及应用中心，覆盖家庭服务、康养陪护等场景，建立包含动作、语音、表情的多模态数据库。同日，华夏机器人（南京）有限公司与江苏移动信息系统集成有限公司、科大讯飞股份有限公司举行合作协议签署仪式。通用人形机器人「夏起」在成立仪式上首次公开亮相，10 台夏起同步群舞。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/104.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/digit-2025-03-18-dch-nanjing-center.html"}]}, {"path": "events/2025/03/evt-2025-03-14-digital-china-humanoid-funding-angel-plus.yaml", "id": "evt-2025-03-14-digital-china-humanoid-funding-angel-plus", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏完成数千万元天使 + 轮融资，同创伟业独家投资"}, "summary": {"zh": "3 月 14 日，数字华夏（深圳）科技有限公司宣布完成数千万元天使 + 轮融资，由同创伟业独家投资，资金用于人形机器人多模态互动大模型研发、产品线扩展及商业化应用场景拓展。公告称公司 2024 年完成数十台机器人商业交付和数千万元营收，客户包括头部 ICT 厂商、头部银行、电网企业和国央企；星行侠 IP 系列机器人在研。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/103.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/digit-2025-03-14-dch-angel-plus.html"}, {"url": "http://www.investorscn.com/2025/03/14/120119/", "publisher": "投资家网", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/investorscn-2025-03-14-dch-angel-plus-inv.html"}]}, {"path": "events/2025/04/evt-2025-04-28-digital-china-humanoid-product-launch-xingxingxia-p01.yaml", "id": "evt-2025-04-28-digital-china-humanoid-product-launch-xingxingxia-p01", "orgs": [{"id": "digital-china-humanoid", "role": "subject"}], "title": {"zh": "数字华夏发布双形态人形机器人星行侠 P01"}, "summary": {"zh": "4 月 28 日，数字华夏（深圳）科技有限公司正式发布 IP 系列机器人星行侠 P01，官方称其为全球首款双形态人形机器人。产品支持「本体模式」与搭载「风火轮」自适应底盘的「飞兵模式」自由切换，具备双足行走、轮式移动、导航避障、自动充电和电梯联动跨楼层能力，续航超过 10 小时，面向商场、展馆、办公楼等场景。星行侠是继夏澜、夏起之后的第三款重点人形机器人产品，发布即开启预售、招募 100 名创始版用户，价格未公布。"}, "evidence": [{"url": "https://www.digit.com.cn/NewsDetail/117.html", "publisher": "数字华夏官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/digit-2025-04-28-dch-xingxingxia-launch.html"}, {"url": "http://chinaaet.com/article/3000171415", "publisher": "电子技术应用（转载 IT之家）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/chinaaet-2025-04-28-dch-xingxingxia-aet.html"}]}]