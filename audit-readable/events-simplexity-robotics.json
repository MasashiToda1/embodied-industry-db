[{"path": "events/2026/03/evt-2026-03-09-simplexity-robotics-funding-five-rounds.yaml", "id": "evt-2026-03-09-simplexity-robotics-funding-five-rounds", "orgs": [{"id": "simplexity-robotics", "role": "subject"}], "title": {"zh": "至简动力官宣半年内完成 5 轮融资，累计 20 亿元"}, "summary": {"zh": "3 月 9 日，至简动力首次正式官宣在半年不到的时间连续完成 5 轮融资，累计融资金额 20 亿元人民币。财务投资机构包括元璟资本、蓝驰创投、红杉中国、君联资本、中科创星、高榕创投，战略投资方为腾讯和阿里巴巴集团，光源资本担任最新一轮财务顾问。投中网称最后一轮投后估值超过 10 亿美元。"}, "evidence": [{"url": "https://www.jiemian.com/article/14088655.html", "publisher": "界面新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/jiemian-2026-03-09-simplexity-robotics-five.html"}]}, {"path": "events/2026/07/evt-2026-07-06-simplexity-robotics-pricing-i7-pro.yaml", "id": "evt-2026-07-06-simplexity-robotics-pricing-i7-pro", "orgs": [{"id": "simplexity-robotics", "role": "subject"}], "title": {"zh": "至简动力 i7 Pro 最高配版本售价 22.98 万元"}, "summary": {"zh": "量子位报道至简动力 7 月 6 日百台交付时称，i7 Pro 最高配版本售价 22.98 万元。"}, "evidence": [{"url": "https://www.qbitai.com/2026/07/445531.html", "publisher": "量子位", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/qbitai-2026-07-06-simplexity-robotics-i7pr.html"}]}, {"path": "events/2026/07/evt-2026-07-06-simplexity-robotics-deployment-i7-pro-100-units.yaml", "id": "evt-2026-07-06-simplexity-robotics-deployment-i7-pro-100-units", "orgs": [{"id": "simplexity-robotics", "role": "subject"}], "title": {"zh": "至简动力首款机器人 i7 Pro 完成首批百台交付，CNC 具身机器人产线落成"}, "summary": {"zh": "7 月 6 日，至简动力在苏州吴中区举行场景落地暨百台交付仪式，宣布首款全场景机器人 i7 Pro 完成首批百台交付，并落成 CNC 智能化具身机器人产线。i7 Pro 搭载七自由度力控人形臂，先落地 CNC 上下料场景，已拓展柔性 PCB、光电模组等工业赛道。"}, "evidence": [{"url": "https://www.163.com/dy/article/L18H7AUS0514R9KE.html", "publisher": "网易号", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/163-2026-07-06-simplexity-robotics-i7pr.html"}]}, {"path": "events/2025/07/evt-2025-07-simplexity-robotics-corporate-founding.yaml", "id": "evt-2025-07-simplexity-robotics-corporate-founding", "orgs": [{"i