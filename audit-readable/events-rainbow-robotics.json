[{"path": "events/2026/07/evt-2026-07-06-rainbow-robotics-deployment-toyota-rb-y1-cumulative-25-units.yaml", "id": "evt-2026-07-06-rainbow-robotics-deployment-toyota-rb-y1-cumulative-25-units", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "Rainbow Robotics 向丰田累计供应约 25 台 RB-Y1，较 2024 年首批 5—6 台扩大约五倍"}, "summary": {"zh": "据韩国电子新闻 7 月 6 日援引业界消息报道，Rainbow Robotics 自 2024 年向丰田首批交付移动双臂机器人 RB-Y1 以来持续扩大供货，丰田累计采购 RB-Y1 约 25 台；2024 年首批约 5—6 台，两年内供货规模扩大约五倍。"}, "evidence": [{"url": "https://en.etnews.com/20260707200002", "publisher": "Electronic Times（ETNews）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/en-2026-07-06-rainbow-robotics-toyota-.html"}]}, {"path": "events/2026/04/evt-2026-04-13-rainbow-robotics-product_launch-rb-y2-simtos.yaml", "id": "evt-2026-04-13-rainbow-robotics-product_launch-rb-y2-simtos", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "Rainbow Robotics 在 SIMTOS 2026 首次公开工业用移动双臂机器人 RB-Y2，单臂负载提升至约 6—7 kg"}, "summary": {"zh": "4 月 13 日，Rainbow Robotics 在京畿道 KINTEX 开幕的 SIMTOS 2026 上首次公开移动双臂机器人 RB-Y2。RB-Y2 是约一年半前发布的研究平台 RB-Y1 的后续产品，面向制造与工业现场投入开发，已应用所需安全认证与法规规格，单臂负载从 3—4 kg 提升到约 6—7 kg。公司人员在现场称 RB-Y1 已向全球研究机构供货约 300 台，RB-Y2 的传感器、相机、夹爪将按导入现场定制。"}, "evidence": [{"url": "https://kidd.co.kr/news/245649", "publisher": "산업종합저널（kidd.co.kr）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/kidd-2026-04-13-rainbow-robotics-rb-y2-s.html"}]}, {"path": "events/2026/09/evt-2026-09-19-rainbow-robotics-publication-10.yaml", "id": "evt-2026-09-19-rainbow-robotics-publication-10", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人发布模型 rb10_iros_0917_pi05"}, "summary": {"zh": "彩虹机器人发布模型 rb10_iros_0917_pi05。许可 未标；标签 lerobot、safetensors、robotics、pi05、dataset:rainbowrobotics/rb10_iros_0917、base_model:lerobot/pi05_base"}, "evidence": [{"url": "https://huggingface.co/rainbowrobotics/rb10_iros_0917_pi05", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/huggingface-2026-09-19-rainbow-robotics.html"}]}, {"path": "events/2026/09/evt-2026-09-21-rainbow-robotics-dataset-rb10-iros.yaml", "id": "evt-2026-09-21-rainbow-robotics-dataset-rb10-iros", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人发布 RB-10 IROS 演示数据集（LeRobot 格式）"}, "summary": {"zh": "在 Hugging Face 发布 rb10_iros_double 及其加工版本 rb10_iros_double_trim、rb10_iros_double_0921，三者为同一数据的处理链（README 载有 lineage）。LeRobot 格式，规模区间 100K–1M，模态含视频与时序，标签 robotics。许可未标注。"}, "evidence": [{"url": "https://huggingface.co/datasets/rainbowrobotics/rb10_iros_double", "publisher": "Hugging Face · rainbowrobotics", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/huggingface-2026-09-21-rainbow.html"}]}, {"path": "events/2026/09/evt-2026-09-13-rainbow-robotics-publication-0-1-2-dev1.yaml", "id": "evt-2026-09-13-rainbow-robotics-publication-0-1-2-dev1", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人发布 rb-sdk 0.1.2.dev1"}, "summary": {"zh": "彩虹机器人发布 rb-sdk 0.1.2.dev1。来源：GitHub · RainbowRobotics"}, "evidence": [{"url": "https://github.com/RainbowRobotics/rb-sdk/releases/tag/0.1.2.dev1", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-13-rainbow-robotics.html"}]}, {"path": "events/2026/09/evt-2026-09-15-rainbow-robotics-publication-0-1-2-dev2.yaml", "id": "evt-2026-09-15-rainbow-robotics-publication-0-1-2-dev2", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人发布 rb-sdk 0.1.2.dev2"}, "summary": {"zh": "彩虹机器人发布 rb-sdk 0.1.2.dev2。来源：GitHub · RainbowRobotics"}, "evidence": [{"url": "https://github.com/RainbowRobotics/rb-sdk/releases/tag/0.1.2.dev2", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-15-rainbow-robotics.html"}]}, {"path": "events/2026/09/evt-2026-09-17-rainbow-robotics-dataset_release-14.yaml", "id": "evt-2026-09-17-rainbow-robotics-dataset_release-14", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人发布数据集 rb10_iros_0917"}, "summary": {"zh": "彩虹机器人发布数据集 rb10_iros_0917。许可 未标；标签 task_categories:robotics、license:apache-2.0、size_categories:100K<n<1M、format:parquet、modality:tabular、modality:timeseries"}, "evidence": [{"url": "https://huggingface.co/datasets/rainbowrobotics/rb10_iros_0917", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/huggingface-2026-09-17-rainbow-robotics.html"}]}, {"path": "events/2026/06/evt-2026-06-14-rainbow-robotics-deployment-coupang-rb-y1-pilot.yaml", "id": "evt-2026-06-14-rainbow-robotics-deployment-coupang-rb-y1-pilot", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "Rainbow Robotics 移动双臂机器人 RB-Y1 进入 Coupang 物流中心做实证验证"}, "summary": {"zh": "据韩国电子新闻 6 月 14 日援引业界消息报道，Coupang 已将 Rainbow Robotics 的移动双臂机器人 RB-Y1 引入其物流中心开展实证，验证内容为现场行驶稳定性与作业效率，用途为货物分拣与搬运。报道称此前三星电子与丰田已将 RB-Y1 引入制造工厂测试。三方均未公开确认该项目。"}, "evidence": [{"url": "https://en.etnews.com/20260615200005", "publisher": "Electronic Times（ETNews）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/en-2026-06-14-rainbow-robotics-coupang.html"}]}, {"path": "events/2024/09/evt-2024-09-30-rainbow-robotics-publication-rby1-sdk-first-release.yaml", "id": "evt-2024-09-30-rainbow-robotics-publication-rby1-sdk-first-release", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人在 GitHub 发布 RB-Y1 官方 SDK rby1-sdk 首批版本"}, "summary": {"zh": "9 月 30 日，彩虹机器人在 GitHub 组织 RainbowRobotics 下的 rby1-sdk 仓库发布 v0.1.10 与 v0.1.11，这是该仓库 releases 页上最早的两个版本。仓库说明为「Official Python and C++ SDK for seamless control and development of the Rainbow Robotics RB-Y1 robot」，以 Apache License 2.0 开源，提供 Python 与 C++ 两套接口。"}, "evidence": [{"url": "https://github.com/RainbowRobotics/rby1-sdk", "publisher": "GitHub / RainbowRobotics", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/github-2024-09-30-rainbow-robotics-rby1-sd.html"}, {"url": "https://github.com/RainbowRobotics/rby1-sdk/releases/tag/v0.1.11", "publisher": "GitHub / RainbowRobotics", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/github-2024-09-30-rainbow-robotics-rby1-sd-2.html"}]}, {"path": "events/2024/10/evt-2024-10-13-rainbow-robotics-deployment-toyota-rb-y1.yaml", "id": "evt-2024-10-13-rainbow-robotics-deployment-toyota-rb-y1", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "电子新闻报道彩虹机器人向丰田供应移动双臂机器人 RB-Y1"}, "summary": {"zh": "10 月 13 日，韩国《电子新闻》报道彩虹机器人向日本丰田供应移动双臂机器人 RB-Y1，丰田此前一直在评估采购、此次最终确定导入。报道称具体数量未获确认，丰田为验证与汽车生产结合的可能性而购买。彩虹机器人方面对是否供货丰田回应「客户相关内容无法具体确认」。"}, "evidence": [{"url": "https://www.etnews.com/20241011000228", "publisher": "电子新闻（etnews）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/etnews-2024-10-13-rainbow-robotics-toyota-.html"}]}, {"path": "events/2024/10/evt-2024-10-11-rainbow-robotics-deployment-rb-y1-first-30-units.yaml", "id": "evt-2024-10-11-rainbow-robotics-deployment-rb-y1-first-30-units", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人移动双臂机器人 RB-Y1 预售 30 台售罄并开始正式交付"}, "summary": {"zh": "10 月 11 日，ZDNet Korea 报道彩虹机器人 3 月首次公开的移动双臂机器人 RB-Y1 完成 30 台预售并转入正式销售，国内与海外各 15 台，已交付的客户包括 MIT、加州大学伯克利分校、佐治亚理工学院与延世大学。RB-Y1 为轮式高速移动底盘加双 7 自由度手臂、6 轴单腿构型，除轮子外共 22 轴，可通过数据臂（主）对机器人（从）做示教。报道称该产品尚未进入现场应用阶段。"}, "evidence": [{"url": "https://zdnet.co.kr/view/?no=20241011170145", "publisher": "ZDNet Korea", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/zdnet-2024-10-11-rainbow-robotics-rby1-pr.html"}]}, {"path": "events/2024/12/evt-2024-12-31-rainbow-robotics-funding-samsung-35pct-stake.yaml", "id": "evt-2024-12-31-rainbow-robotics-funding-samsung-35pct-stake", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "三星电子行使认购期权将 Rainbow Robotics 持股增至 35%，成为最大股东并将其并为子公司"}, "summary": {"zh": "12 月 31 日，三星电子宣布行使认购期权，将对 Rainbow Robotics 的持股从 14.7% 增至 35%，成为其最大股东，Rainbow Robotics 并入三星电子合并财务报表成为子公司。三星电子 2023 年首次以 868 亿韩元取得 14.7% 股份；韩国媒体报道此次增持 20.29% 股份的对价「约 2674 亿韩元」。三星同时设立直属 CEO 的未来机器人推进团。"}, "evidence": [{"url": "https://news.samsung.com/global/samsung-electronics-to-become-largest-shareholder-in-rainbow-robotics-accelerating-future-robot-development", "publisher": "Samsung Global Newsroom", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/news-2024-12-31-rainbow-robotics-samsung.html"}, {"url": "https://www.asiae.co.kr/en/article/2024123109125960726", "publisher": "The Asia Business Daily", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/asiae-2024-12-31-rainbow-robotics-samsung.html"}]}, {"path": "events/2025/03/evt-2025-03-05-rainbow-robotics-corporate-ftc-approves-samsung-acquisition.yaml", "id": "evt-2025-03-05-rainbow-robotics-corporate-ftc-approves-samsung-acquisition", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "韩国公平交易委员会批准三星电子收购彩虹机器人"}, "summary": {"zh": "3 月 5 日，韩联社报道韩国公平交易委员会（FTC）批准三星电子对彩虹机器人的收购，距三星提交审查约两个月，理由是该交易形成垄断的可能性很小。三星电子目前持有彩虹机器人 35% 股份，2023 年曾向其投资 868 亿韩元。"}, "evidence": [{"url": "https://en.yna.co.kr/view/AEN20250305003500320", "publisher": "Yonhap News Agency", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/en-2025-03-05-rainbow-robotics-ftc-app.html"}]}, {"path": "events/2025/03/evt-2025-03-22-rainbow-robotics-procurement-samsung-2024-1-45bn-krw.yaml", "id": "evt-2025-03-22-rainbow-robotics-procurement-samsung-2024-1-45bn-krw", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "年报披露三星电子 2024 年向彩虹机器人采购 14.5 亿韩元产品"}, "summary": {"zh": "3 月 22 日，ZDNet Korea 依据彩虹机器人事业报告报道，2024 年彩虹机器人向三星电子供货 8 次，合计 14.5 亿韩元，其中 4 月 1 次、9 月 2 次，其余 5 次集中在第四季度，10 月至 12 月售出约 10 亿韩元产品。报道称三星电子以研究为目的购买了 RB-Y1 等产品。三星电子副会长韩宗熙在第 56 届股东大会上表示，彩虹机器人的协作机器人已投入公司部分制造产线使用。"}, "evidence": [{"url": "https://zdnet.co.kr/view/?no=20250322011853", "publisher": "ZDNet Korea", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/zdnet-2025-03-22-rainbow-robotics-samsung.html"}]}, {"path": "events/2025/07/evt-2025-07-02-rainbow-robotics-deployment-rb-y1-cumulative-80-units.yaml", "id": "evt-2025-07-02-rainbow-robotics-deployment-rb-y1-cumulative-80-units", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "彩虹机器人移动双臂机器人 RB-Y1 上市一年累计交付约 80 台"}, "summary": {"zh": "7 月 2 日，ZDNet Korea 报道彩虹机器人的移动双臂机器人 RB-Y1 上市一年累计交付约 80 台：2024 年 9 至 12 月供应初批 30 台，2025 年上半年又售出 50 余台，目前每月产量约 10 至 20 台、投入生产人力 14 人。客户中三星电子累计购买 35 台，MIT 购买 3 台、加州大学伯克利分校 2 台。按国别计算美国占 45%、韩国占 41%。公司方面表示下半年还有约 40 至 50 台销售计划，其中 20 余台已签订供货合同。"}, "evidence": [{"url": "https://zdnet.co.kr/view/?no=20250702145450", "publisher": "ZDNet Korea", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/zdnet-2025-07-02-rainbow-robotics-rby1-80.html"}]}, {"path": "events/2025/10/evt-2025-10-24-rainbow-robotics-partnership-samsung-heavy-shipbuilding-robots.yaml", "id": "evt-2025-10-24-rainbow-robotics-partnership-samsung-heavy-shipbuilding-robots", "orgs": [{"id": "rainbow-robotics", "role": "subject"}], "title": {"zh": "Rainbow Robotics 与三星重工合作开发船厂 AI 焊接机器人：三星重工提供数据与测试环境，Rainbow 负责硬件"}, "summary": {"zh": "10 月 24 日，三星重工宣布与 Rainbow Robotics 合作开发 AI 焊接机器人，用于船体分段焊接。协议下三星重工提供作业数据与测试环境，Rainbow Robotics 负责硬件开发与技术支持，目标是做出可在狭窄空间与斜面作业的轻量化移动焊接机器人（含移动双臂与四足形态）。"}, "evidence": [{"url": "https://www.ajupress.com/view/20251024142000329", "publisher": "Aju Press", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/ajupress-2025-10-24-rainbow-robotics-samsung.html"}]}]