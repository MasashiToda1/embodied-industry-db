[{"path": "events/2026/02/evt-2026-02-25-xpeng-robotics-corporate-production-base.yaml", "id": "evt-2026-02-25-xpeng-robotics-corporate-production-base", "orgs": [{"id": "xpeng-robotics", "role": "subject"}], "title": {"zh": "小鹏布局人形机器人全链条量产基地"}, "summary": {"zh": "2 月 25 日，广州市高质量发展大会上，小鹏人形机器人全链条量产基地作为天河区重点「开门红」项目正式提报。基地将落地广棠科创城具身智能产业园，园区总建筑面积约 11 万平方米，一期建设机器人厂房、动力站房及配套设施。"}, "evidence": [{"url": "https://www.xiaopeng.com/news/company_news/5537.html", "publisher": "小鹏汽车官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/xiaopeng-2026-02-25-xpeng-robotics-factory-b.html"}]}, {"path": "events/2026/09/evt-2026-09-08-xpeng-robotics-corporate-production-line-start.yaml", "id": "evt-2026-09-08-xpeng-robotics-corporate-production-line-start", "orgs": [{"id": "xpeng-robotics", "role": "subject"}], "title": {"zh": "小鹏机器人生产线启用，首台 IRON 自主走下产线"}, "summary": {"zh": "9 月 8 日，小鹏机器人生产线正式启用，首台高阶通用人形机器人完成自动化总装并自主走下产线。产线由小鹏自主设计，核心制程自动化率超过 80%，引入整车级质量管理体系。按规划，IRON 于 2026 年底进入规模量产，率先在小鹏门店和园区应用，2027 年面向中国及海外市场上市交付。"}, "evidence": [{"url": "https://robot.ofweek.com/2026-09/ART-898890-8110-30702459.html", "publisher": "OFweek 机器人网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/robot-2026-09-08-xpeng-robotics-productio.html"}]}, {"path": "events/2026/08/evt-2026-08-24-xpeng-robotics-funding-series-a.yaml", "id": "evt-2026-08-24-xpeng-robotics-funding-series-a", "orgs": [{"id": "xpeng-robotics", "role": "subject"}], "title": {"zh": "小鹏机器人业务首轮融资超 9 亿美元"}, "summary": {"zh": "8 月 24 日，小鹏集团宣布旗下人形机器人业务已与多家投资者签署股权融资协议。本轮为小鹏机器人业务首轮融资，融资金额超 9 亿美元，投后估值超 63 亿美元；由 IDG 资本领投，高榕创投参投，腾讯和阿里巴巴作为战略投资者参与。交割完成后小鹏集团继续控股机器人业务并合并报表。"}, "evidence": [{"url": "https://www.xiaopeng.com/news/company_news/5585.html", "publisher": "小鹏汽车官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/xiaopeng-2026-08-24-xpeng-robotics-series-a.html"}]}, {"path": "events/2026/06/evt-2026-06-10-xpeng-robotics-personnel-he-xiaopeng-robotics-ceo.yaml", "id": "evt-2026-06-10-xpeng-robotics-personnel-he-xiaopeng-robotics-ceo", "orgs": [{"id": "xpeng-robotics", "role": "subject"}], "title": {"zh": "何小鹏兼任小鹏机器人业务 CEO"}, "summary": {"zh": "6 月 10 日，何小鹏发出内部信，宣布除担任小鹏集团 CEO 外，亲自兼任机器人业务 CEO。内部信提出的节点为：2026 年第四季度实现人形机器人量产，2027 年一季度进入线下门店导购，2027 年二季度推向海外市场。"}, "evidence": [{"url": "https://www.yicai.com/news/103223315.html", "publisher": "第一财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/yicai-2026-06-10-xpeng-robotics-ceo.html"}]}, {"path": "events/2024/11/evt-2024-11-06-xpeng-robotics-product_launch-iron.yaml", "id": "evt-2024-11-06-xpeng-robotics-product_launch-iron", "orgs": [{"id": "xpeng-robotics", "role": "subject"}], "title": {"zh": "小鹏在 AI 科技日发布 AI 机器人 Iron"}, "summary": {"zh": "11 月 6 日，「小鹏 AI 科技日」在广州华南理工大学举办，小鹏发布 AI 机器人 Iron。官方介绍 Iron 以 1∶1 类真人姿态呈现，拥有超 60 个关节，可模拟人类站立、躺卧、坐；搭载自研图灵 AI 芯片、端到端大模型与小鹏天玑 AIOS，手指可完成抓、拿、放等任务。官方称该机器人已进入工厂工作，后续将进入销售门店、办公室、家庭等场景。"}, "evidence": [{"url": "https://www.xiaopeng.com/news/company_news/5409.html", "publisher": "小鹏汽车官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/xiaopeng-2024-11-06-xpeng-robotics-iron-laun.html"}]}]