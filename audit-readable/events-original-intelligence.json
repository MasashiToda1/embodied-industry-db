[{"path": "events/2026/02/evt-2026-02-10-original-intelligence-product_launch-dm0.yaml", "id": "evt-2026-02-10-original-intelligence-product_launch-dm0", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机发布具身原生大模型 DM0、开发框架 Dexbotic 2.0 与量产工作流 DFOL"}, "summary": {"zh": "2 月 10 日，原力灵机在北京举办技术开放日，发布具身原生大模型 DM0、开发框架 Dexbotic 2.0 和应用量产工作流 DFOL。官方称 DM0 参数量 2.4B，从零开始训练并与阶跃星辰联合训练，预训练覆盖 UR、Franka、ARX、UMI、Aloha、R1-Lite、Realman、DOS-W1 等 8 种机型，并宣布 DM0 全面开源。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20260210A03NBB00", "publisher": "腾讯新闻 · TechWeb", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/news-2026-02-10-original-intelligence-dm.html"}]}, {"path": "events/2026/07/evt-2026-07-09-original-intelligence-product_launch-dm05-apex.yaml", "id": "evt-2026-07-09-original-intelligence-product_launch-dm05-apex", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机开发者大会发布 DM0.5 模型、通用机器人 Apex 与开发者平台 DexDev"}, "summary": {"zh": "7 月 9 日，原力灵机在 2026 开发者大会上发布通用具身基础模型 DM0.5、通用机器人本体 Apex，以及开发者平台 DexDev（DFOL2.0、MaaS、DexOS），并展示面向仓储物流拆零拣选的多智能体作业系统 Ferrata。官方称 Ferrata 已在真实仓库完成测试，覆盖超 10 万 SKU。"}, "evidence": [{"url": "http://www.xinhuanet.com/tech/20260710/01f997d814a6480290cf828a36d565e5/c.html", "publisher": "新华网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/xinhuanet-2026-07-09-original-intelligence-ap.html"}]}, {"path": "events/2026/09/evt-2026-09-15-original-intelligence-publication-dm05-robocoliseum.yaml", "id": "evt-2026-09-15-original-intelligence-publication-dm05-robocoliseum", "orgs": [{"id": "original-intelligence", "role": "subject"}, {"id": "agibot", "role": "counterparty"}], "title": {"zh": "原力灵机 DM0.5 在 RoboColiseum 四个子榜单登顶"}, "summary": {"zh": "报道称原力灵机模型 DM0.5 同时占据 RoboColiseum 评测平台四个能力子榜单（指令跟随、空间理解、扰动适应、通用操作）榜首。RoboColiseum 由智元机器人发起，现有 78 个评测任务、超 3000 个泛化 case，训练集与评测集隔离。"}, "evidence": [{"url": "https://www.leiphone.com/category/ai/jIrGoPOXjx7WNljl.html", "publisher": "雷峰网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/leiphone-2026-09-15-original-intelligence.html"}]}, {"path": "events/2026/08/evt-2026-08-original-intelligence-corporate-joint-stock-reform.yaml", "id": "evt-2026-08-original-intelligence-corporate-joint-stock-reform", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机完成股份制改造，更名为原力灵机（重庆）智能科技股份有限公司"}, "summary": {"zh": "工商信息显示，原力灵机于 2026 年 8 月完成工商变更登记，企业类型变更为股份有限公司，公司全称变更为原力灵机（重庆）智能科技股份有限公司。公司未公布上市时间表。"}, "evidence": [{"url": "https://news.pedaily.cn/202608/567534.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/news-2026-08-original-intelligence-jo.html"}]}, {"path": "events/2026/06/evt-2026-06-16-original-intelligence-funding-atomix-merger.yaml", "id": "evt-2026-06-16-original-intelligence-funding-atomix-merger", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机完成与原力聚合（Atomix）合并，同步完成新一轮战略融资"}, "summary": {"zh": "6 月 16 日，原力聚合（Atomix）官网宣布原力灵机完成与原力聚合的合并，并完成新一轮战略融资。投资方包括智谱、阶跃星辰、商汤、阿里巴巴，华勤技术、上汽恒旭等产业资本，以及金浦资本、元禾璞华、兴证资本、苏州基金、招银国际、厚雪基金、正奇能科、运衡实业等机构，老股东跟投，高鹄资本担任独家财务顾问。融资金额未披露。"}, "evidence": [{"url": "https://www.atomixrobot.com.cn/news/228.html", "publisher": "原力聚合（Atomix）官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/atomixrobot-2026-06-16-original-intelligence-at.html"}, {"url": "https://news.pedaily.cn/202606/565150.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/news-2026-06-original-intelligence-at.html"}]}, {"path": "events/2025/03/evt-2025-03-original-intelligence-funding-angel-round.yaml", "id": "evt-2025-03-original-intelligence-funding-angel-round", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机完成 2 亿元天使轮融资"}, "summary": {"zh": "报道称原力灵机（Dexmal）于 2025 年 3 月完成 2 亿元天使轮融资，投资方包括君联资本、九坤创投、启明创投等机构。"}, "evidence": [{"url": "https://www.36kr.com/p/3552641065286528", "publisher": "36 氪（转亿欧网）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/36kr-2025-03-original-intelligence-an.html"}]}, {"path": "events/2025/03/evt-2025-03-original-intelligence-corporate-founded.yaml", "id": "evt-2025-03-original-intelligence-corporate-founded", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机（Dexmal）成立"}, "summary": {"zh": "报道称原力灵机（Dexmal）成立于 2025 年 3 月，先后完成重庆、北京两地注册，专注具身智能软硬件技术研发与落地，核心创始团队源自旷视科技。"}, "evidence": [{"url": "https://www.36kr.com/p/3552641065286528", "publisher": "36 氪（转亿欧网）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/36kr-2025-03-original-intelligence-an.html"}, {"url": "https://news.qq.com/rain/a/20251114A061IS00", "publisher": "瑞财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/news-2025-03-original-intelligence-fo.html"}]}, {"path": "events/2025/11/evt-2025-11-14-original-intelligence-funding-a-plus-round.yaml", "id": "evt-2025-11-14-original-intelligence-funding-a-plus-round", "orgs": [{"id": "original-intelligence", "role": "subject"}], "title": {"zh": "原力灵机完成数亿元 A+ 轮融资，阿里巴巴独家投资"}, "summary": {"zh": "11 月 14 日，Dexmal 原力灵机通过官方公众号宣布完成数亿元人民币 A+ 轮融资，阿里巴巴为独家投资方。此前 A 轮由蔚来资本领投，洪泰基金、联想创投、锡创投、正景基金跟投，君联资本、启明创投、九坤创投追投；两轮融资金额近 10 亿元。"}, "evidence": [{"url": "https://m.bjnews.com.cn/detail/1763108341168583.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/m-2025-11-14-original-intelligence-a-.html"}]}]