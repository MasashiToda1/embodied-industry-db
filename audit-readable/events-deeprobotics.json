[{"path": "events/2026/05/evt-2026-05-18-deeprobotics-funding-star-ipo-accepted.yaml", "id": "evt-2026-05-18-deeprobotics-funding-star-ipo-accepted", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技科创板 IPO 获上交所受理，拟募资 25.03 亿元"}, "summary": {"zh": "5 月 18 日，上交所网站显示杭州云深处科技股份有限公司科创板 IPO 审核状态变更为「已受理」，拟募集资金 25.0251 亿元，保荐机构为中信建投证券。证券时报 IPO 页面显示，公司 2026 年 5 月 27 日收到审核问询，8 月 7 日状态更新为「已问询」。"}, "evidence": [{"url": "https://tech.caijing.com.cn/20260519/5160392.shtml", "publisher": "财经网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/tech-2026-05-18-deeprobotics-ipo-accepte.html"}, {"url": "https://www.stcn.com/ipo/detail/3659.html", "publisher": "证券时报 IPO 信息披露", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/stcn-2026-05-18-deeprobotics-ipo-stcn.html"}]}, {"path": "events/2024/09/evt-2024-09-12-deeprobotics-publication-lite3-rl-stack.yaml", "id": "evt-2024-09-12-deeprobotics-publication-lite3-rl-stack", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处开源 Lite3 四足机器人强化学习训练与部署两个仓库"}, "summary": {"zh": "9 月 12 日，云深处在 GitHub 组织 DeepRoboticsLab 下创建并公开 Lite3_rl_deploy 与 Lite3_rl_training 两个仓库。Lite3_rl_deploy 面向 Lite3 的仿真到仿真与仿真到实机部署，README 的仿真流程使用 MuJoCo 与 PyBullet；Lite3_rl_training 为四足机器人运动控制的学习型控制器，包含训练与硬件部署所需组件，依赖 Isaac Gym、legged_gym 与 rsl_rl。两个仓库均为 BSD-3-Clause 许可。"}, "evidence": [{"url": "https://github.com/DeepRoboticsLab/Lite3_rl_deploy", "publisher": "云深处 GitHub", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/github-2024-09-12-deeprobotics-lite3-rl-de.html"}, {"url": "https://github.com/DeepRoboticsLab/Lite3_rl_training", "publisher": "云深处 GitHub", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/github-2024-09-12-deeprobotics-lite3-rl-tr.html"}]}, {"path": "events/2024/09/evt-2024-09-18-deeprobotics-publication-robot-training-cases.yaml", "id": "evt-2024-09-18-deeprobotics-publication-robot-training-cases", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处开源 Lite3 实训案例集 Robot_Training_Cases"}, "summary": {"zh": "9 月 18 日，云深处在 GitHub 组织 DeepRoboticsLab 下创建并公开 Robot_Training_Cases 仓库。README 写明这是基于杭州云深处科技教育科研类四足机器人 Lite3 激光版的实训案例参考资料，目录覆盖基础知识与操作体验、仿真环境及部署、运动开发入门、感知开发入门、单关节控制、基于 VMC 的运动控制、基于强化学习的训练及部署、激光定位建图与导航等案例，许可为 MIT。"}, "evidence": [{"url": "https://github.com/DeepRoboticsLab/Robot_Training_Cases", "publisher": "云深处 GitHub", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/github-2024-09-18-deeprobotics-training-ca.html"}]}, {"path": "events/2024/12/evt-2024-12-11-deeprobotics-deployment-sp-group-singapore.yaml", "id": "evt-2024-12-11-deeprobotics-deployment-sp-group-singapore", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处 X30 四足机器人交付新加坡能源集团电力隧道巡检方案"}, "summary": {"zh": "12 月 11 日，云深处科技宣布与官方合作伙伴 Eastern Green Power（EGP）合作，采用自研 X30 四足机器人和数字化技术，交付新加坡能源集团（SP 集团）电力隧道巡检解决方案。SP 集团将该机器狗命名为「SPock」，配备视频摄像头和热成像仪，在管廊内自主导航、实时发现缺陷并生成数据报告，官方称预估每年节省人工隧道检查时间 480 小时。官网稿称 X30 是国内第一台在海外电力系统落地应用的行业级四足机器人。"}, "evidence": [{"url": "https://www.ithome.com/0/816/971.htm", "publisher": "IT之家", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/ithome-2024-12-11-deeprobotics-sp-group-it.html"}, {"url": "https://www.deeprobotics.cn/robot/index/article/id/265.html", "publisher": "云深处科技官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/12/deeprobotics-2024-12-11-deeprobotics-sp-group.html"}]}, {"path": "events/2025/03/evt-2025-03-31-deeprobotics-publication-robotserver-sdk.yaml", "id": "evt-2025-03-31-deeprobotics-publication-robotserver-sdk", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处开源导航控制接口库 robotserver_sdk"}, "summary": {"zh": "3 月 31 日，云深处在 GitHub 组织 DeepRoboticsLab 下创建并公开 robotserver_sdk 仓库。中文 README 写明该 SDK 提供控制和监控机器狗导航任务的接口，封装底层协议与网络通信，功能包括连接与断开机器狗控制系统、获取实时状态、下发与取消导航任务、查询导航任务执行状态；要求 C++17、CMake 3.10、Boost 1.66 以上，许可为 MIT。"}, "evidence": [{"url": "https://github.com/DeepRoboticsLab/robotserver_sdk", "publisher": "云深处 GitHub", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/github-2025-03-31-deeprobotics-robotserver.html"}]}, {"path": "events/2025/02/evt-2025-02-27-deeprobotics-deployment-ningxia-wind-substation.yaml", "id": "evt-2025-02-27-deeprobotics-deployment-ningxia-wind-substation", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处 X30 机器狗交付宁夏戈壁滩无人区风电场升压站智能巡检项目"}, "summary": {"zh": "云深处官网 2 月 27 日发文称，公司与金风慧能、中国三峡集团合作的四足机器人无人巡检项目已在宁夏戈壁滩无人风电场升压站交付。项目从 2024 年 8 月运行至 2025 年 2 月，累计完成超过 200 次巡检，单日最高覆盖 349 个巡检对象，识别准确率 96.5%。X30 机器狗与无人机协作，每日两次巡检、每次约 80 分钟，巡检对象包括主变压器、套管、隔离刀闸、避雷器及分合指示器。"}, "evidence": [{"url": "https://www.deeprobotics.cn/robot/index/article/id/273.html", "publisher": "云深处科技官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/02/deeprobotics-2025-02-27-deeprobotics-ningxia-win.html"}]}, {"path": "events/2025/07/evt-2025-07-08-deeprobotics-funding-pre-c.yaml", "id": "evt-2025-07-08-deeprobotics-funding-pre-c", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技宣布完成近 5 亿元人民币新一轮融资"}, "summary": {"zh": "7 月 8 日，杭州云深处科技有限公司宣布完成近 5 亿元人民币新一轮融资，由达晨财智、国新基金等联合领投，北京机器人产业发展投资基金、前海母基金、央视融媒体基金、富浙基金、华映资本、物产中大投资等机构跟投，钧山资本、方广资本及爱施德智城基金等老股东继续加持。官方称资金投向四足机器人产线扩建、人形机器人技术研发及高端人才引进。后续报道将该轮称为 Pre-C 轮。"}, "evidence": [{"url": "https://news.pedaily.cn/202507/552010.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/news-2025-07-08-deeprobotics-pre-c.html"}, {"url": "https://www.ithome.com/0/866/622.htm", "publisher": "IT之家", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/ithome-2025-07-08-deeprobotics-pre-c-ithom.html"}]}, {"path": "events/2025/04/evt-2025-04-29-deeprobotics-product-launch-lynx-m20.yaml", "id": "evt-2025-04-29-deeprobotics-product-launch-lynx-m20", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处发布山猫 M20 行业级全地形轮足机器人"}, "summary": {"zh": "4 月 29 日，云深处科技发布山猫 M20 轮足机器人，官方称这是面向复杂地形和危险环境打造的中型行业级全地形轮足机器人。整机有效负载 15 公斤、负载续航 12 公里，配 96 线激光雷达，支持全向避障，工业级 IP66 防护，可选自主导航与自主充电的 Pro 版本。官网产品页列出的应用场景为电力巡检、消防应急、物流配送与科研探索，发布时开启全球预售，未公布售价。"}, "evidence": [{"url": "https://www.ithome.com/0/849/905.htm", "publisher": "IT之家", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/ithome-2025-04-29-deeprobotics-lynx-m20.html"}, {"url": "https://finance.sina.com.cn/tech/roll/2025-04-30/doc-ineuxfic4358377.shtml", "publisher": "新浪科技", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/finance-2025-04-29-deeprobotics-lynx-m20-si.html"}]}, {"path": "events/2025/11/evt-2025-11-03-deeprobotics-corporate-joint-stock-reform.yaml", "id": "evt-2025-11-03-deeprobotics-corporate-joint-stock-reform", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技完成股改，更名为杭州云深处科技股份有限公司"}, "summary": {"zh": "证券时报报道，11 月 3 日，公司由「杭州云深处科技有限公司」更名为「杭州云深处科技股份有限公司」，企业类型从「其他有限责任公司」变更为「其他股份有限公司（非上市）」。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3558169.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/stcn-2025-11-03-deeprobotics-reorg.html"}]}, {"path": "events/2025/10/evt-2025-10-09-deeprobotics-product-launch-dr02.yaml", "id": "evt-2025-10-09-deeprobotics-product-launch-dr02", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技发布首款行业级人形机器人 DR02"}, "summary": {"zh": "10 月 9 日，云深处科技发布行业级人形机器人 DR02。官方页面称整机达到 IP66 防水防尘，运行温度 -20℃ 至 55℃，面向安防巡逻、工厂作业等场景；第一财经报道该机身高 175cm、体重 75kg、31 个自由度（不含末端执行器）。"}, "evidence": [{"url": "https://www.deeprobotics.cn/robot/index/article/id/277.html", "publisher": "云深处科技官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/deeprobotics-2025-10-09-deeprobotics-dr02-offici.html"}, {"url": "https://www.yicai.com/news/102855785.html", "publisher": "第一财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/yicai-2025-10-09-deeprobotics-dr02-yicai.html"}]}, {"path": "events/2025/12/evt-2025-12-24-deeprobotics-corporate-ipo-tutoring-filing.yaml", "id": "evt-2025-12-24-deeprobotics-corporate-ipo-tutoring-filing", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技提交 IPO 辅导备案，辅导机构为中信建投"}, "summary": {"zh": "12 月 24 日，证监会官网显示，杭州云深处科技股份有限公司向浙江证监局提交 IPO 辅导备案，辅导券商为中信建投证券。报道称公司 12 月 8 日与中信建投签署辅导协议，辅导时间为 2025 年 12 月至 2026 年 6 月。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20251224A04ONO00", "publisher": "腾讯新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/news-2025-12-23-deeprobotics-ipo-tutorin.html"}]}, {"path": "events/2025/12/evt-2025-12-25-deeprobotics-funding-pre-ipo.yaml", "id": "evt-2025-12-25-deeprobotics-funding-pre-ipo", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技完成数亿元 Pre-IPO 轮融资，国家人工智能产业投资基金领投"}, "summary": {"zh": "证券时报援引企查查信息报道，12 月 25 日，云深处科技完成数亿元人民币 Pre-IPO 轮融资，由国家人工智能产业投资基金合伙企业（有限合伙）领投，京东跟投。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3558169.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/stcn-2025-12-25-deeprobotics-pre-ipo.html"}]}, {"path": "events/2025/12/evt-2025-12-09-deeprobotics-funding-c-round.yaml", "id": "evt-2025-12-09-deeprobotics-funding-c-round", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处科技完成超 5 亿元 C 轮融资"}, "summary": {"zh": "12 月 9 日，杭州云深处科技股份有限公司宣布完成超 5 亿元人民币 C 轮融资，由招银国际和华夏基金联合领投，中国电信、中国联通旗下基金参与战略投资，云晖资本、中芯聚源、浙大基金会、首程控股等跟投，达晨财智、前海方舟、央视融媒体基金、北京机器人产业发展投资基金和华映资本等老股东继续加持。"}, "evidence": [{"url": "https://www.deeprobotics.cn/robot/index/article/id/282.html", "publisher": "云深处科技官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/deeprobotics-2025-12-09-deeprobotics-c-round.html"}]}, {"path": "events/2025/08/evt-2025-08-14-deeprobotics-publication-rl-training-isaaclab.yaml", "id": "evt-2025-08-14-deeprobotics-publication-rl-training-isaaclab", "orgs": [{"id": "deeprobotics", "role": "subject"}], "title": {"zh": "云深处开源基于 Isaac Lab 的强化学习训练库 rl_training"}, "summary": {"zh": "8 月 14 日，云深处在 GitHub 组织 DeepRoboticsLab 下创建并公开 rl_training 仓库，仓库描述为「RL_Training Repo Based on Isaaclab」，定位为面向云深处机器人的强化学习训练库，训练出的策略配套该组织下的部署仓库使用，许可为 BSD-3-Clause。截至 2026 年 9 月抓取时，README 列出的训练环境覆盖 Lite3、M20 与 DR02 三款机型，依赖 Isaac Sim、Isaac Lab 与 RSL-RL。"}, "evidence": [{"url": "https://github.com/DeepRoboticsLab/rl_training", "publisher": "云深处 GitHub", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/github-2025-08-14-deeprobotics-rl-training.html"}]}]