[{"path": "events/2026/07/evt-2026-07-08-miaodong-product-launch-beni-kickstarter.yaml", "id": "evt-2026-07-08-miaodong-product-launch-beni-kickstarter", "orgs": [{"id": "miaodong", "role": "subject"}], "title": {"zh": "妙动科技首款消费级跟拍机器人 Beni 在 Kickstarter 上线众筹"}, "summary": {"zh": "7 月 8 日，深圳妙动科技（Mondo Robotics）首款消费级产品 Beni 在 Kickstarter 上线众筹，上线不到一天金额达 122 万美元、支持者近 2000 人。Beni 是一款自主跟随的轮式摄影机器人，可自动识别并跟随人或狗进行追踪拍摄。"}, "evidence": [{"url": "https://www.baijing.cn/article/55952", "publisher": "白鲸出海", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/baijing-2026-07-08-miaodong-beni-kickstarte.html"}]}, {"path": "events/2026/09/evt-2026-09-22-miaodong-pricing-beni.yaml", "id": "evt-2026-09-22-miaodong-pricing-beni", "orgs": [{"id": "miaodong", "role": "subject"}], "title": {"zh": "妙动科技官网 Beni 标准套装标价 799 美元，页面显示折扣价 599 美元"}, "summary": {"zh": "妙动科技官网 Beni 商品页显示「Beni 标准套装 599.00 美元 799.00 美元」，会员可额外享 20 美元折扣，页面标注交付时间 2026 年 11 月。"}, "evidence": [{"url": "https://www.mondorobotics.com/zh/products/mondo-robotics-beni", "publisher": "妙动科技官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/mondorobotic-2026-09-22-miaodong-beni-price.html"}]}, {"path": "events/2025/04/evt-2025-04-miaodong-funding-angel.yaml", "id": "evt-2025-04-miaodong-funding-angel", "orgs": [{"id": "miaodong", "role": "subject"}], "title": {"zh": "妙动科技完成数千万美元天使轮融资"}, "summary": {"zh": "36 氪 2025 年 8 月 13 日刊发的 IT 桔子统计稿写明，2025 年 4 月妙动科技天使轮获数千万美元融资，由红杉中国、经纬创投和美团龙珠领投。稿件称公司方向为娱乐机器人产品。"}, "evidence": [{"url": "https://www.36kr.com/p/3420971536420231", "publisher": "36 氪（转载 IT 桔子）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/36kr-2025-04-miaodong-angel-36kr.html"}]}, {"path": "events/2025/11/evt-2025-11-miaodong-funding-sequoia-meituan-round.yaml", "id": "evt-2025-11-miaodong-funding-sequoia-meituan-round", "orgs": [{"id": "miaodong", "role": "subject"}], "title": {"zh": "妙动科技完成新一轮融资，红杉中国与美团再次投资"}, "summary": {"zh": "虎嗅 2025 年 11 月 4 日报道，深圳市妙动科技有限公司再次完成新一轮融资，投资方为老股东红杉中国与美团；报道称首轮融资金额 5—6 千万美元，本轮据说为 2—3 亿美元，公司未官宣。"}, "evidence": [{"url": "https://www.n315.com/hongsan/2025/1104/9641.html", "publisher": "融资界（转载虎嗅）", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/n315-2025-11-miaodong-2025-11-round-n.html"}]}]