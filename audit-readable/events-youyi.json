[{"path": "events/2026/08/evt-2026-08-20-youyi-product_launch-t01-transformable-humanoid.yaml", "id": "evt-2026-08-20-youyi-product_launch-t01-transformable-humanoid", "orgs": [{"id": "youyi", "role": "subject"}], "title": {"zh": "有怡科技在 WRC 2026 发布可变形「本质人形」机器人 T01"}, "summary": {"zh": "8 月 20 日，金华有怡科技有限公司在 2026 世界机器人大会上提出「本质人形」理念并发布首款本质人形机器人 T01。T01 为可变形多模态机器人，将双足双臂四个肢体机构减少为腿臂复用的两个肢体机构，自重 30kg，设计速度 3m/s，具备双足行走、轮式移动、双臂作业、箱体收纳功能，可作为驾乘工具搭载 100kg 成年人。"}, "evidence": [{"url": "http://www.zj.xinhuanet.com/20260820/347a6b85deb24747a2eb7583ad2b3530/c.html", "publisher": "新华网浙江频道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/zj-2026-08-20-youyi-t01-launch.html"}]}, {"path": "events/2025/08/evt-2025-08-10-youyi-product_launch-blackt-h1-wrc2025.yaml", "id": "evt-2025-08-10-youyi-product_launch-blackt-h1-wrc2025", "orgs": [{"id": "youyi", "role": "subject"}], "title": {"zh": "有怡科技 BlackT-H1 人形机器人在 2025 世界机器人大会京东展厅首秀"}, "summary": {"zh": "8 月 10 日，金华有怡科技有限公司研发的 BlackT-H1 人形机器人在 2025 世界机器人大会京东展厅完成全球首秀。稿件称该机器人身高 1.63 米、体重 43 千克，通过激光雷达与视觉识别技术自主规避障碍物，具备「灵巧操作 + 直膝行走」能力，面向物流配送、仓储搬运、物品分拣等场景。"}, "evidence": [{"url": "https://www.top168.com/news/show-521060.html", "publisher": "头部财经", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/top168-2025-08-10-youyi-blackt-h1-wrc2025.html"}]}, {"path": "events/2025/08/evt-2025-08-27-youyi-corporate-jinhua-headquarters.yaml", "id": "evt-2025-08-27-youyi-corporate-jinhua-headquarters", "orgs": [{"id": "youyi", "role": "subject"}], "title": {"zh": "金华有怡科技有限公司总部在金东金漪湖开业"}, "summary": {"zh": "今日金东稿件称，金华有怡科技有限公司总部开业，为金东区首个人形机器人产业化项目落地。稿件称公司已将大部分研发和生产环节布局在金华，并计划未来三年内实现整机 90% 以上关键零部件的本地化。"}, "evidence": [{"url": "https://jdnews.zjol.com.cn/jdnews/system/2025/08/27/035036047.shtml", "publisher": "金义新区新闻网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/jdnews-2025-08-27-youyi-jinhua-hq-opening.html"}]}]