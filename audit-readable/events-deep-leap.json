[{"path": "events/2026/09/evt-2026-09-04-deep-leap-product-launch-dele-w05.yaml", "id": "evt-2026-09-04-deep-leap-product-launch-dele-w05", "orgs": [{"id": "deep-leap", "role": "subject"}], "title": {"zh": "深度跃迁发布世界动作模型 DELE-w0.5"}, "summary": {"zh": "深度跃迁发布具身基座模型 DELE-w0.5。该模型在训练时联合学习机器人动作与动作完成后的未来世界表征，推理时仅由语言和当前视觉生成动作，采用双流 Transformer 架构，未使用开源机器人基础模型、VLA 或视频生成模型的既有权重。项目主页与论文同步公开。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20260904A06UMA00", "publisher": "腾讯新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/news-2026-09-04-deep-leap-dele-w05.html"}]}, {"path": "events/2026/09/evt-2026-09-deep-leap-funding-angel-round.yaml", "id": "evt-2026-09-deep-leap-funding-angel-round", "orgs": [{"id": "deep-leap", "role": "subject"}], "title": {"zh": "深度跃迁完成复星创富独家投资的天使轮融资"}, "summary": {"zh": "腾讯新闻 9 月 4 日刊发的 DELE-w0.5 发布稿中称，深度跃迁已完成由复星创富独家投资的天使轮融资，金额与时间未披露。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20260904A06UMA00", "publisher": "腾讯新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/news-2026-09-04-deep-leap-dele-w05.html"}]}]