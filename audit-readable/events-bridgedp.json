[{"path": "events/2026/02/evt-2026-02-bridgedp-funding-pre-a-round.yaml", "id": "evt-2026-02-bridgedp-funding-pre-a-round", "orgs": [{"id": "bridgedp", "role": "subject"}], "title": {"zh": "桥介数物完成数千万元 Pre-A 轮融资"}, "summary": {"zh": "据科创板日报 8 月 13 日报道，桥介数物（深圳）科技有限公司于 2026 年 2 月完成数千万元 Pre-A 轮融资，参投方包括瑞丞投资、沂景资本以及深圳天使母基金。报道引用企查查信息。"}, "evidence": [{"url": "https://www.163.com/dy/article/L480NP400550B1DU.html", "publisher": "网易（转载科创板日报）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/163-2026-02-bridgedp-pre-a-round-163.html"}]}, {"path": "events/2026/08/evt-2026-08-12-bridgedp-funding-pre-a-plus3-round.yaml", "id": "evt-2026-08-12-bridgedp-funding-pre-a-plus3-round", "orgs": [{"id": "bridgedp", "role": "subject"}], "title": {"zh": "桥介数物完成亿元级 Pre-A+++ 轮融资，中国移动链长基金领投"}, "summary": {"zh": "8 月 12 日，深圳通用机器人操作系统研发商桥介数物（BridgeDP Robotics）宣布完成 Pre-A+++ 轮融资，由中国移动链长基金领投，老股东复星创富、深创投追加投资，融资规模达亿元级。公司称资金用于 RoboCraft AI 运动能力开发平台生态建设、跨本体全身运动数据工厂产能提升、运动控制模型迭代以及海外技术服务体系布局。"}, "evidence": [{"url": "https://www.zhidx.com/p/584179.html", "publisher": "智东西（机器人前瞻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/zhidx-2026-08-12-bridgedp-pre-a-plus3-rou.html"}, {"url": "https://finance.sina.com.cn/jjxw/2026-08-12/doc-inimzqcs5351017.shtml", "publisher": "新浪财经（转载环球网）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/finance-2026-08-12-bridgedp-pre-a-plus3-sin.html"}]}, {"path": "events/2025/08/evt-2025-08-06-bridgedp-funding-angel-plus-and-pre-a.yaml", "id": "evt-2025-08-06-bridgedp-funding-angel-plus-and-pre-a", "orgs": [{"id": "bridgedp", "role": "subject"}], "title": {"zh": "桥介数物完成天使 + 轮及 Pre-A 轮融资，半年内累计三轮「近亿元」"}, "summary": {"zh": "8 月 6 日，桥介数物（深圳）科技有限公司宣布完成天使 + 轮及 Pre-A 轮融资。天使 + 轮投资方包括复星创富、潜能集团等；Pre-A 轮由隐山资本领投，明荟致远、沂景资本等跟投；易凯资本担任独家财务顾问。报道称桥介数物在半年时间内连续完成 3 轮融资，累计金额「近亿元」。公司称资金将用于通用机器人动作开发平台的技术研发、产品升级与人才招聘。"}, "evidence": [{"url": "https://www.caixin.com/2025-08-07/102349522.html", "publisher": "财新网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/caixin-2025-08-06-bridgedp-angel-plus-prea.html"}, {"url": "https://news.qq.com/rain/a/20250809A06H8F00", "publisher": "腾讯新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/news-2025-08-06-bridgedp-angel-plus-prea.html"}]}]