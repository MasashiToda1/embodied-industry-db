[{"path": "events/2026/04/evt-2026-04-30-pudu-product_launch-d9.yaml", "id": "evt-2026-04-30-pudu-product_launch-d9", "orgs": [{"id": "pudu", "role": "subject"}], "title": {"zh": "普渡机器人发布全新一代人形机器人 PUDU D9"}, "summary": {"zh": "4 月 30 日，深圳市普渡科技股份有限公司发布全新一代人形机器人 PUDU D9，身高 170cm、体重 58kg，采用轻量化高强度结构与全栈自研架构，在关节模组与运动控制两个维度升级。D9 与四足 PUDU D5、类人形 PUDU D7 构成多形态具身智能产品矩阵。"}, "evidence": [{"url": "https://www.pudutech.com/zh-CN/news/pudu-robotics-advances-general-embodied-ai-portfolio-pudu-d9", "publisher": "普渡机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/pudutech-2026-04-30-pudu-d9.html"}, {"url": "https://www.eepw.com.cn/article/202605/480886.htm", "publisher": "电子产品世界", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/eepw-2026-04-30-pudu-d9-eepw.html"}]}, {"path": "events/2026/04/evt-2026-04-23-pudu-funding-new-round.yaml", "id": "evt-2026-04-23-pudu-funding-new-round", "orgs": [{"id": "pudu", "role": "subject"}], "title": {"zh": "普渡机器人完成近 10 亿元融资，估值突破 100 亿元"}, "summary": {"zh": "4 月 23 日，普渡机器人宣布完成近 10 亿元人民币新一轮融资，估值突破 100 亿元人民币。本轮由龙岗金控、亚投资本联合领投，北汽产投、蓝思科技、弘晖基金及珠三角、长三角多地政府引导基金参与；资金投向具身智能技术研发、产品矩阵扩充、全球市场拓展与产能建设。"}, "evidence": [{"url": "https://www.pudutech.com/zh-CN/news/pudu-robotics-raises-150-million-exceeds-1-5-billion-valuation", "publisher": "普渡机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/pudutech-2026-04-23-pudu-funding.html"}, {"url": "https://finance.sina.com.cn/wm/2026-04-23/doc-inhvnaik5536280.shtml", "publisher": "新浪财经（转载 IPO 早知道）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/finance-2026-04-23-pudu-funding-sina.html"}]}, {"path": "events/2026/08/evt-2026-08-26-robosense-deployment-h1-2026-robot-lidar.yaml", "id": "evt-2026-08-26-robosense-deployment-h1-2026-robot-lidar", "orgs": [{"id": "robosense", "role": "subject"}, {"id": "unitree", "role": "customer"}, {"id": "agibot", "role": "customer"}, {"id": "galbot", "role": "customer"}, {"id": "pudu", "role": "customer"}, {"id": "dobot", "role": "customer"}, {"id": "limx", "role": "customer"}, {"id": "fourier", "role": "customer"}], "title": {"zh": "速腾聚创 2026 年上半年机器人激光雷达销量 282600 台，同比增长 510.4%，并首次披露空间相机、触觉、关节模组进展"}, "summary": {"zh": "8 月 26 日，速腾聚创发布 2026 年中期业绩：上半年激光雷达总销量 719200 台，其中机器人领域 282600 台，同比增长 510.4%，机器人业务收入占产品收入近半。公司称已与宇树、智元、银河通用、普渡、越疆、逐际动力、傅利叶等近 60 家具身智能企业达成合作；首次披露空间相机（已获规模化订单，三季度末启动交付）、视触觉与 MEMS 触觉传感器（9 月底启动商业交付）、关节模组（首批万级采购需求，四季度批量交付）三类新品。"}, "evidence": [{"url": "https://www.163.com/dy/article/L5B3OFHP053990SN.html", "publisher": "网易号 · 金角财经（转载速腾聚创新闻稿）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/163-2026-08-26-robosense-h1-2026-robot-.html"}]}, {"path": "events/2026/06/evt-2026-06-01-pudu-product_launch-d7.yaml", "id": "evt-2026-06-01-pudu-product_launch-d7", "orgs": [{"id": "pudu", "role": "subject"}], "title": {"zh": "普渡机器人发布新一代工业级类人形机器人 PUDU D7"}, "summary": {"zh": "6 月 1 日，普渡机器人发布新一代工业级类人形机器人 PUDU D7，面向工厂制造与仓储物流场景。整机最高承重 14kg，作业高度可达 2 米，依托双臂微力控制实现重物轻拿轻放，可自主完成推车放置与场内输送。"}, "evidence": [{"url": "https://www.pudutech.com/zh-CN/news/pudu-d7-industrial-humanoid-robot-launch", "publisher": "普渡机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/pudutech-2026-06-01-pudu-d7.html"}, {"url": "https://www.ithome.com/0/958/380.htm", "publisher": "IT 之家", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/ithome-2026-06-01-pudu-d7-ithome.html"}]}, {"path": "events/2024/09/evt-2024-09-19-pudu-product_launch-d7.yaml", "id": "evt-2024-09-19-pudu-product_launch-d7", "orgs": [{"id": "pudu", "role": "subject"}], "title": {"zh": "普渡机器人发布首款类人形机器人 PUDU D7"}, "summary": {"zh": "9 月 19 日，普渡机器人发布初代类人形机器人 PUDU D7，由普渡 X 实验室（Pudu X-Lab）孵化研发。官方介绍该机型身高 165 厘米、重量 45 公斤，仿生臂臂展 65 厘米，整机 30 个自由度，配备灵巧手后提升至 50 个；采用仿生双臂与全向移动底盘，大模型上采用「大脑大模型」与「小脑大模型」分离的策略。官网把该机型全面商业化落地的时间目标定在 2025 年。"}, "evidence": [{"url": "https://www.pudutech.com/zh-CN/news/818", "publisher": "普渡机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/pudutech-2024-09-19-pudu-d7-launch.html"}]}]