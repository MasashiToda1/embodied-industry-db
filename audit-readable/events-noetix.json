[{"path": "events/2026/03/evt-2026-03-12-noetix-deployment-bumi-awe-jd.yaml", "id": "evt-2026-03-12-noetix-deployment-bumi-awe-jd", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力在 AWE2026 现场交付「小布米」，宣布与京东深化合作"}, "summary": {"zh": "3 月 12 日，松延动力携「小布米」与「小顽童 N2」亮相 AWE2026，创始人姜哲源在现场将「小布米」交付到用户手中；松延动力与京东联合宣布深化合作，推动人形机器人民用化。姜哲源称 2026 年核心目标是实现「小布米」万台规模交付。"}, "evidence": [{"url": "https://egs.stcn.com/news/detail/2250552.html", "publisher": "证券时报·e公司", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/egs-2026-03-12-noetix-bumi-awe-delivery.html"}]}, {"path": "events/2026/03/evt-2026-03-02-noetix-funding-b-round.yaml", "id": "evt-2026-03-02-noetix-funding-b-round", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力完成近 10 亿元 B 轮融资，宁德时代系晨道资本领投"}, "summary": {"zh": "3 月 2 日，北京松延动力科技集团股份有限公司宣布完成 B 轮融资，B 轮累计规模近 10 亿元，由宁德时代系产业投资平台晨道资本领投，国科投资、京国盛基金、九合创投等跟投。公司称累计已完成 9 轮融资。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3656889.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/stcn-2026-03-02-noetix-b-round.html"}, {"url": "https://www.bjnews.com.cn/detail/1772414188129618.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/bjnews-2026-03-02-noetix-b-round-bjnews.html"}]}, {"path": "events/2026/09/evt-2026-09-08-noetix-product-launch-scalabot-heron.yaml", "id": "evt-2026-09-08-noetix-product-launch-scalabot-heron", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力发布具身智能技术品牌 Scalabot 与首个世界模型 HERON-World Model"}, "summary": {"zh": "9 月 8 日，松延动力发布通用具身智能技术品牌 Scalabot，并推出其技术架构 HERON 下的首个世界模型 HERON-World Model。公司称模型支持不同构型、不同自由度的机器人，将率先应用于家庭服务场景，并计划先以几百台机器人进入家庭采集数据。"}, "evidence": [{"url": "https://www.d1ev.com/news/shichang/312299", "publisher": "第一电动网（转载盖世汽车）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/d1ev-2026-09-08-noetix-scalabot.html"}, {"url": "https://www.stcn.com/article/detail/4190007.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/stcn-2026-09-08-noetix-scalabot-stcn.html"}]}, {"path": "events/2025/03/evt-2025-03-14-noetix-product-launch-n2-e1.yaml", "id": "evt-2025-03-14-noetix-product-launch-n2-e1", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力发布人形机器人 N2 与升级版 E1，宣传起售价 3.99 万元"}, "summary": {"zh": "3 月 14 日，松延动力发布人形机器人 N2 和升级版 E1，对外宣传起售价 3.99 万元。N2 身高 1.2 米、体重 30 公斤，具备后空翻、奔跑、单双脚跳跃等运动能力，实测奔跑速度最快 3.5 米每秒，机身标配二次开发接口，内置模型预测控制（MPC）与强化学习（RL）协同技术。钛媒体当晚采访中，公司方面称 3.99 万元对应单次批量 50 台以上，50 台以内为 4.99 万元，N2 预售价为 5.99 万元起、E1 最低 3.99 万元起。每日经济新闻 4 月报道称 N2 定价 3.99 万元、交付周期约两周，E1 处于全面开放预订状态。"}, "evidence": [{"url": "https://www.tmtpost.com/7494943.html", "publisher": "钛媒体", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/tmtpost-2025-03-14-noetix-n2-e1-launch.html"}, {"url": "https://www.nbd.com.cn/articles/2025-04-23/3844689.html", "publisher": "每日经济新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/nbd-2025-03-14-noetix-n2-price-nbd.html"}]}, {"path": "events/2025/03/evt-2025-03-17-noetix-funding-a-and-a-plus.yaml", "id": "evt-2025-03-17-noetix-funding-a-and-a-plus", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力宣布完成连续两轮过亿元 A 轮及 A+ 轮融资"}, "summary": {"zh": "3 月 17 日，松延动力北京科技有限公司宣布完成连续两轮过亿元 A 轮及 A+ 轮融资。A+ 轮由彬复资本领投，华强资本跟投；A 轮投资方包括神骐资本、北京未来科学城基金、天启资本、泽然资本、教育科技集团战略方等机构。北京商报报道称公司已完成五轮融资，已拿到数千万元采购订单，主要集中在科研教育、教学教具、展览展示领域，2025 年计划完成近千台交付。"}, "evidence": [{"url": "https://news.pedaily.cn/202503/547212.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/news-2025-03-17-noetix-a-aplus.html"}, {"url": "https://news.qq.com/rain/a/20250317A09H7400", "publisher": "北京商报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/03/news-2025-03-17-noetix-a-aplus-bbt.html"}]}, {"path": "events/2025/11/evt-2025-11-26-noetix-funding-pre-b-plus.yaml", "id": "evt-2025-11-26-noetix-funding-pre-b-plus", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力完成近 2 亿元 Pre-B+ 轮融资，中金资本领投"}, "summary": {"zh": "11 月 26 日，松延动力完成近 2 亿元 Pre-B+ 轮融资，由中金资本领投，允泰资本、厚为资本跟投。融资用于技术研发投入、高价值应用场景生态合作和打通规模化量产交付通路。与 10 月 26 日的 Pre-B 轮合计近 5 亿元。"}, "evidence": [{"url": "https://stcn.com/article/detail/3512757.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/stcn-2025-11-26-noetix-pre-b-plus.html"}]}, {"path": "events/2025/10/evt-2025-10-23-noetix-pricing-bumi-9998.yaml", "id": "evt-2025-10-23-noetix-pricing-bumi-9998", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力消费级人形机器人「小布米」上线京东，定价 9998 元"}, "summary": {"zh": "10 月 23 日，松延动力人形机器人「Bumi 小布米」上架京东平台，定价 9998 元。投资界报道该机身高 94cm、重约 12kg、21 个以上自由度，支持行走、奔跑、舞蹈、语音交互与图形化编程；证券时报报道上线后一小时售出百台，两天首批 500 台售罄，截至 11 月 26 日线上线下累计售出数千台。"}, "evidence": [{"url": "https://stcn.com/article/detail/3512757.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/stcn-2025-10-23-noetix-bumi-price.html"}, {"url": "https://news.pedaily.cn/202510/556361.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/news-2025-10-26-noetix-pre-b.html"}]}, {"path": "events/2025/10/evt-2025-10-26-noetix-funding-pre-b.yaml", "id": "evt-2025-10-26-noetix-funding-pre-b", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力完成近 3 亿元 Pre-B 轮融资，方广资本领投"}, "summary": {"zh": "松延动力完成近 3 亿元 Pre-B 轮融资，由方广资本领投，祥峰投资、中车转型升级基金、聚合资本、东方嘉富、央视融媒体基金、嘉道资本、宽桥恒松等跟投。证券时报后续报道写明该轮于 10 月 26 日完成。"}, "evidence": [{"url": "https://news.pedaily.cn/202510/556361.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/news-2025-10-26-noetix-pre-b.html"}, {"url": "https://stcn.com/article/detail/3512757.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/stcn-2025-11-26-noetix-pre-b-plus.html"}]}, {"path": "events/2025/08/evt-2025-08-05-noetix-funding-a-plus-plus.yaml", "id": "evt-2025-08-05-noetix-funding-a-plus-plus", "orgs": [{"id": "noetix", "role": "subject"}], "title": {"zh": "松延动力完成数亿元 A++ 轮融资"}, "summary": {"zh": "8 月 5 日，松延动力宣布完成数亿元 A++ 轮融资，由金浦资本领投，北汽产投、中金资本、晶科能源、赟汇资本、优山资本、卓源资本、元智未来等机构跟投。这是公司 2025 年上半年以来连续完成的第三轮融资，累计融资六轮。每日经济新闻报道称，松延动力上半年已获涉及超 2000 台产品的商业化订单，报道给出的合同总额口径为超 1 亿元；新京报报道称公司 7 月量产交付 105 台人形机器人，其中 N2 交付 92 台、E1 交付 13 台，环比增长 176%。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1754385295168483.html", "publisher": "新京报贝壳财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/bjnews-2025-08-05-noetix-a-plus-plus.html"}, {"url": "https://www.nbd.com.cn/articles/2025-08-05/4001291.html", "publisher": "每日经济新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/nbd-2025-08-05-noetix-a-plus-plus-nbd.html"}]}]