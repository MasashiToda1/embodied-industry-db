[{"path": "events/2026/07/evt-2026-07-23-topstar-product_launch-fysiverse-world-model.yaml", "id": "evt-2026-07-23-topstar-product_launch-fysiverse-world-model", "orgs": [{"id": "topstar", "role": "subject"}], "title": {"zh": "拓斯达联合飞捷科思在 WAIC 2026 发布 Fysiverse 工业物理世界模型"}, "summary": {"zh": "2026 年世界人工智能大会期间，拓斯达联合飞捷科思发布 Fysiverse 工业物理世界模型。该模型搭载飞捷科思自研可微分物理仿真引擎 Fysics，用于还原零部件与产线的刚度、形变、摩擦、负载、公差等物理特征，生成可交互数字孪生环境与训练素材，并适配拓斯达全系工业机器人。"}, "evidence": [{"url": "https://www.21jingji.com/article/20260723/herald/2ed48c44a31338eb59b1ea864bdb05cd.html", "publisher": "21 经济网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/21jingji-2026-07-23-topstar-fysiverse-world-.html"}]}, {"path": "events/2026/07/evt-2026-07-20-topstar-funding-hkex-refiling.yaml", "id": "evt-2026-07-20-topstar-funding-hkex-refiling", "orgs": [{"id": "topstar", "role": "subject"}], "title": {"zh": "拓斯达再次向港交所提交上市申请书，此前 1 月递交的招股书已满 6 个月失效"}, "summary": {"zh": "7 月 20 日，广东拓斯达科技股份有限公司再次向港交所提交上市申请书，独家保荐人为华泰国际。此前拓斯达于 2026 年 1 月 16 日递交的港股招股书满 6 个月，于 7 月 16 日失效。"}, "evidence": [{"url": "https://www.tmtpost.com/nictation/8071380.html", "publisher": "钛媒体", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/tmtpost-2026-07-20-topstar-hkex-refiling.html"}]}, {"path": "events/2026/01/evt-2026-01-16-topstar-funding-hkex-h-share-filing.yaml", "id": "evt-2026-01-16-topstar-funding-hkex-h-share-filing", "orgs": [{"id": "topstar", "role": "subject"}], "title": {"zh": "拓斯达向港交所主板递交 H 股上市申请，推进 A+H 上市"}, "summary": {"zh": "据港交所 1 月 16 日披露，广东拓斯达科技股份有限公司（300607.SZ）向港交所主板递交上市申请书，华泰国际为独家保荐人。招股书称公司在机器人核心零部件、机器人本体、自动化应用系统形成全链条布局，并定位为具身智能领域的先行者。"}, "evidence": [{"url": "http://mp.cnfol.com/8919/article/1768746605-142220437.html", "publisher": "中金在线（转载智通财经）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/mp-2026-01-16-topstar-hkex-h-share-fil.html"}]}, {"path": "events/2024/11/evt-2024-11-15-huawei-cloudrobo-partnership-shenzhen-embodied-center-mous.yaml", "id": "evt-2024-11-15-huawei-cloudrobo-partnership-shenzhen-embodied-center-mous", "orgs": [{"id": "huawei-cloudrobo", "role": "subject"}, {"id": "topstar", "role": "counterparty"}, {"id": "leju", "role": "counterparty"}, {"id": "zhaowei", "role": "counterparty"}, {"id": "x-square-robot", "role": "counterparty"}], "title": {"zh": "华为（深圳）全球具身智能产业创新中心启动运营，与 16 家企业签署合作备忘录"}, "summary": {"zh": "11 月 15 日，深圳市前海管理局与宝安区政府举办「AI 向未来——人工智能应用创新成果发布会」，会上华为（深圳）全球具身智能产业创新中心宣布正式运营，并举行优选伙伴签约仪式，与 16 家企业签署合作备忘录。报道列出的签约企业包括兆威机电、拓斯达、乐聚机器人、深圳市大族机器人、深圳墨影科技、自变量机器人等。报道称该中心由华为与深圳市前海管理局、宝安区人民政府合作建立，后续华为将与签约企业开展应用场景相关合作。"}, "evidence": [{"url": "https://caifuhao.eastmoney.com/news/20241115170249743115900", "publisher": "东方财富网财富号（金色光投资有道）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/caifuhao-2024-11-15-huawei-cloudrobo-shenzhe.html"}]}, {"path": "events/2025/04/evt-2025-04-topstar-corporate-juzhen-zhituo-jv.yaml", "id": "evt-2025-04-topstar-corporate-juzhen-zhituo-jv", "orgs": [{"id": "topstar", "role": "subject"}], "title": {"zh": "拓斯达与智谱华章成立控股子公司矩阵智拓，研发机器人大小脑与行业专用模型"}, "summary": {"zh": "拓斯达在官网文章中称，2025 年 4 月拓斯达与智谱华章成立合资公司矩阵智拓，由拓斯达控股，专注机器人大小脑与具身智能研究、开发行业专用模型。每日经济新闻 2025 年 3 月 13 日援引天眼查信息报道称，广东矩阵智拓科技有限公司注册资本 5000 万元人民币，由拓斯达（300607）、智谱 AI 关联公司北京智谱华章科技有限公司、海南何尊网络科技有限公司、东莞市拓谱思企业管理中心（有限合伙）共同持股。"}, "evidence": [{"url": "https://www.topstarltd.com/lang-cn/newsview/2269.html", "publisher": "拓斯达", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/topstarltd-2025-04-topstar-juzhen-zhituo-jv.html"}, {"url": "https://www.nbd.com.cn/articles/2025-03-13/3787046.html", "publisher": "每日经济新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/nbd-2025-04-topstar-juzhen-zhituo-re.html"}]}, {"path": "events/2025/09/evt-2025-09-12-topstar-product_launch-xiaotuo-wheeled-humanoid.yaml", "id": "evt-2025-09-12-topstar-product_launch-xiaotuo-wheeled-humanoid", "orgs": [{"id": "topstar", "role": "subject"}, {"id": "orbbec", "role": "counterparty"}], "title": {"zh": "拓斯达在全球开放日发布首款轮式人形机器人「小拓」，并发起人形机器人生态创新联盟"}, "summary": {"zh": "9 月 12 日，拓斯达在东莞举办「AI 无界 智造共生——拓斯达全球开放日 2025」，旗下矩阵智拓发布首款人形机器人「小拓」，为轮式人形机器人，基于拓斯达与智谱共同构建的具身模型，集成 3D 相机与 AI 视觉检测系统，已在注塑车间完成多轮验证，能识别注塑件良率并自主完成装盘。同场拓斯达与伯恩光学、尼得科、THK、奥比中光、华南理工大学等发起「拓斯达人形机器人生态创新联盟」。"}, "evidence": [{"url": "https://www.topstarltd.com/lang-cn/newsview/2142.html", "publisher": "拓斯达官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/09/topstarltd-2025-09-12-topstar-xiaotuo-wheeled-.html"}, {"url": "https://news.qq.com/rain/a/20250915A080K000", "publisher": "腾讯新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/09/news-2025-09-12-topstar-xiaotuo-qq.html"}]}]