[{"path": "events/2026/03/evt-2026-03-19-horizon-robotics-corporate-d-robotics-deconsolidation.yaml", "id": "evt-2026-03-19-horizon-robotics-corporate-d-robotics-deconsolidation", "orgs": [{"id": "horizon-robotics", "role": "subject"}, {"id": "d-robotics", "role": "counterparty"}], "title": {"zh": "地平线年度业绩公告披露：不再拥有地瓜机器人控制权，地瓜机器人取消入账转为联营公司"}, "summary": {"zh": "3 月 19 日，地平线（9660.HK）在截至 2025 年 12 月 31 日止年度的业绩公告「报告期间后事项及内幕消息」中披露：因地瓜机器人（D-Robotics）持续融资，地平线持有其已发行股本从上市时近 70% 被动稀释至约 40%；地瓜机器人员工持股平台拟终止与地平线全资附属公司的一致行动协议，地平线创始人拟撤回董事会成员任命授权书。相关文件签署后，地平线不再拥有对地瓜机器人的控制权，地瓜机器人不再作为附属公司入账，改作联营公司入账，地平线保持第一大股东地位，并继续向其提供产品解决方案及研发服务。"}, "evidence": [{"url": "https://www.hkexnews.hk/listedco/listconews/sehk/2026/0319/2026031900928_c.pdf", "publisher": "香港交易所披露易", "tier": "primary", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/hkexnews-2026-03-19-horizon-robotics-droboti.html"}]}, {"path": "events/2026/02/evt-2026-02-13-horizon-robotics-product_launch-holobrain-0.yaml", "id": "evt-2026-02-13-horizon-robotics-product_launch-holobrain-0", "orgs": [{"id": "horizon-robotics", "role": "subject"}, {"id": "d-robotics", "role": "counterparty"}], "title": {"zh": "地平线发布并开源 HoloBrain-0 具身智能 VLA 基座模型及 RoboOrchard 基础设施"}, "summary": {"zh": "2 月 13 日，地平线宣布其机器人实验室的 HoloBrain-0 基座模型及框架全面开源，同步开放数据采集、训练、真机部署的全栈基础设施 RoboOrchard。HoloBrain-0 是面向具身智能的 Vision-Language-Action 框架，在架构中显式注入多视角相机参数与机器人运动学结构等具身先验，预训练融合多本体遥操作数据、人类视频数据与仿真数据；同时发布 0.2B 参数的端侧版本，可适配地瓜机器人 RDK S100 开发者套件。"}, "evidence": [{"url": "https://www.horizon.auto/news/technology/435", "publisher": "地平线官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/horizon-2026-02-13-horizon-holobrain0.html"}]}, {"path": "events/2026/09/evt-2026-09-28-horizon-robotics-publication-cogwam-research-note.yaml", "id": "evt-2026-09-28-horizon-robotics-publication-cogwam-research-note", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线提交 CogWAM RoboDojo 复现技术说明"}, "summary": {"zh": "地平线在官方 CogWAM 仓库提交技术说明，描述以持久语义状态连接任务进度、未来世界预测与动作生成，并列出 RoboDojo 复现实验的训练、策略服务和评测流程。说明明确该发布范围不包含论文中的 BiCoord 与真实机器人实验；评测客户端使用 Isaac Sim 与 Isaac Lab。这里记录研究复现设置，不代表量产产品采用该架构。"}, "evidence": [{"url": "https://github.com/HorizonRobotics/CogWAM/blob/ceb5c169c72c47920965aeb2f348ac6f4e153caf/README.md", "publisher": "GitHub · HorizonRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-cog-research-note-20261001.md"}, {"url": "https://api.github.com/repos/HorizonRobotics/CogWAM/git/commits/ceb5c169c72c47920965aeb2f348ac6f4e153caf", "publisher": "GitHub · HorizonRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-cog-readme-commit-20261001.json"}]}, {"path": "events/2026/09/evt-2026-09-11-horizon-robotics-publication-roboorchardcore-v0-7-0.yaml", "id": "evt-2026-09-11-horizon-robotics-publication-roboorchardcore-v0-7-0", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线发布 RoboOrchardCore v0.7.0"}, "summary": {"zh": "发布说明引入轻量基础安装，将完整机器人运行时依赖放入 robotics 可选安装组，保留 all 聚合安装组及 kinematic 兼容别名。 日期采用官方 GitHub release 的 published_at（UTC）。"}, "evidence": [{"url": "https://github.com/HorizonRobotics/RoboOrchardCore/releases/tag/v0.7.0-release", "publisher": "GitHub · HorizonRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-roboorchardcore-v0-7-0-release-20261001.json"}]}, {"path": "events/2026/09/evt-2026-09-29-horizon-robotics-publication-ego4wam-research-note.yaml", "id": "evt-2026-09-29-horizon-robotics-publication-ego4wam-research-note", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线提交 Ego4WAM 第一视角人类数据研究说明"}, "summary": {"zh": "地平线在官方 Ego4WAM 仓库提交研究说明，在固定世界动作模型框架下研究第一视角人类数据的对齐、时长、任务多样性和监督形式，并描述真机与 RoboDojo 闭环评测。说明列出 Wan2.2 视频世界模型骨干及 LeRobot 数据格式，并提供 Hugging Face 模型链接。此事件记录研究说明，不将 README 或仓库创建时间作为模型权重首次可下载时间。"}, "evidence": [{"url": "https://github.com/HorizonRobotics/Ego4WAM/blob/abbf69f4e36fbff6457d8e190adec3afd651b5b3/README.md", "publisher": "GitHub · HorizonRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-ego-research-note-20261001.md"}, {"url": "https://api.github.com/repos/HorizonRobotics/Ego4WAM/git/commits/abbf69f4e36fbff6457d8e190adec3afd651b5b3", "publisher": "GitHub · HorizonRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-ego-readme-commit-20261001.json"}]}, {"path": "events/2026/09/evt-2026-09-11-horizon-robotics-publication-roboorchardcore-v0-6-0.yaml", "id": "evt-2026-09-11-horizon-robotics-publication-roboorchardcore-v0-6-0", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线发布 RoboOrchardCore v0.6.0"}, "summary": {"zh": "发布说明列出相机批数据的缩放与图像编码、坐标变换图索引、四元数序列连续性处理，以及配置校验、命令行扩展和运行时清理等更新。 日期采用官方 GitHub release 的 published_at（UTC）。"}, "evidence": [{"url": "https://github.com/HorizonRobotics/RoboOrchardCore/releases/tag/v0.6.0-release", "publisher": "GitHub · HorizonRobotics", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-roboorchardcore-v0-6-0-release-20261001.json"}]}, {"path": "events/2026/05/evt-2026-05-18-horizon-robotics-product_launch-holomotion-1.yaml", "id": "evt-2026-05-18-horizon-robotics-product_launch-holomotion-1", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线发布并开源 HoloMotion-1：4 亿参数人形机器人全身控制「小脑大模型」"}, "summary": {"zh": "5 月 18 日，地平线正式发布并开源 HoloMotion-1，这是地平线机器人实验室面向人形机器人全身控制打造的 4 亿参数级机器人小脑大模型，采用 MoE-Transformer policy，结合 MoE 稀疏激活与 KV-cache 推理机制，在端侧实现约 300FPS 实时推理（报告设置下推理延迟 3.32ms）。训练数据来自互联网视频恢复动作、光学动捕数据、VR 遥操作数据和惯性动捕遥操作数据；同步开放覆盖数据处理、动作重定向、模型训练、离线评测、端侧部署的完整流程。"}, "evidence": [{"url": "https://www.horizon.auto/news/technology/456", "publisher": "地平线官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/horizon-2026-05-18-horizon-robotics-holomot.html"}, {"url": "https://finance.sina.com.cn/tech/digi/2026-05-19/doc-inhymivm2307662.shtml", "publisher": "新浪科技（转载 IT 之家）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/finance-2026-05-18-horizon-robotics-holomot.html"}]}, {"path": "events/2024/11/evt-2024-11-22-horizon-robotics-publication-bip3d.yaml", "id": "evt-2024-11-22-horizon-robotics-publication-bip3d", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线发布具身 3D 感知模型论文《BIP3D: Bridging 2D Images and 3D Perception for Embodied Intelligence》"}, "summary": {"zh": "11 月 22 日，地平线团队将 BIP3D 论文提交至 arXiv。BIP3D 是以图像为中心的 3D 感知模型，用显式 3D 位置编码配合预训练 2D 视觉基础模型，并引入空间增强模块，实现多视角、多模态特征融合与端到端 3D 感知；论文称在 EmbodiedScan benchmark 上，3D 检测任务提升 5.69%，3D 视觉定位任务提升 15.25%。代码仓库在 GitHub 的 HorizonRobotics 组织下公开。"}, "evidence": [{"url": "https://arxiv.org/abs/2411.14869", "publisher": "arXiv", "tier": "primary", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/arxiv-2024-11-22-horizon-robotics-bip3d.html"}, {"url": "https://github.com/HorizonRobotics/BIP3D", "publisher": "地平线 GitHub 组织", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/github-2024-11-22-horizon-robotics-bip3d-r.html"}]}, {"path": "events/2024/10/evt-2024-10-24-horizon-robotics-funding-hkex-listing.yaml", "id": "evt-2024-10-24-horizon-robotics-funding-hkex-listing", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线在香港交易所主板挂牌上市"}, "summary": {"zh": "10 月 24 日，地平线（股票代码 9660.HK）正式于香港交易所主板挂牌上市，上市仪式在港交所举行。据每日经济新闻报道，本次 IPO 以每股 3.99 港元发售 13.6 亿股，募资总额 54.07 亿港元，开盘价 5.12 港元。"}, "evidence": [{"url": "https://www.horizon.auto/news/press/306", "publisher": "地平线官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/horizon-2024-10-24-horizon-robotics-hkex-li.html"}, {"url": "https://www.nbd.com.cn/articles/2024-10-24/3603332.html", "publisher": "每日经济新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/nbd-2024-10-24-horizon-robotics-hkex-nb.html"}]}, {"path": "events/2025/07/evt-2025-07-30-horizon-robotics-publication-roboorchardcore.yaml", "id": "evt-2025-07-30-horizon-robotics-publication-roboorchardcore", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线开源机器人运行时底座 RoboOrchardCore 并发布 v0.1.0"}, "summary": {"zh": "7 月 30 日，地平线在 GitHub 的 HorizonRobotics 组织下发布 RoboOrchardCore v0.1.0。RoboOrchardCore 是 RoboOrchard 系列软件包的运行时底座，提供类型化配置、张量化数据类型、管理器驱动的环境循环与命令行工具，让仿真、训练与部署代码共用同一套接口约定。"}, "evidence": [{"url": "https://github.com/HorizonRobotics/RoboOrchardCore/releases/tag/v0.1.0-release", "publisher": "地平线 GitHub 组织", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/github-2025-07-30-horizon-robotics-roboorc.html"}]}, {"path": "events/2025/12/evt-2025-12-08-horizon-robotics-product_launch-holomotion-holobrain.yaml", "id": "evt-2025-12-08-horizon-robotics-product_launch-holomotion-holobrain", "orgs": [{"id": "horizon-robotics", "role": "subject"}, {"id": "d-robotics", "role": "counterparty"}], "title": {"zh": "地平线在 2025 技术生态大会发布具身智能小脑基座模型 HoloMotion 与大脑基座模型 HoloBrain"}, "summary": {"zh": "12 月 8 日，地平线在 2025 地平线技术生态大会上正式发布两大具身智能开源模型：具身智能小脑基座模型 HoloMotion（人形机器人全身运控基础模型，提供从数据获取、强化学习多机并行训练到真机部署的全流程管线）和大脑基座模型 HoloBrain（通用操作基础模型，融合真实与仿真数据）。大会 12 月 8 日至 9 日举办，同期开设「从智能汽车到机器人的智能跃迁」专题论坛，地平线机器人实验室还介绍了 EmbodiedGen 仿真数据引擎、FSR-VLN 视觉语言导航与 RoboOrchard 具身智能框架。"}, "evidence": [{"url": "https://www.horizon.auto/news/press/427", "publisher": "地平线官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/horizon-2025-12-08-horizon-robotics-holomot.html"}]}, {"path": "events/2025/06/evt-2025-06-12-horizon-robotics-publication-embodiedgen.yaml", "id": "evt-2025-06-12-horizon-robotics-publication-embodiedgen", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线发布并开源生成式 3D 世界引擎 EmbodiedGen"}, "summary": {"zh": "6 月 12 日，地平线团队将 EmbodiedGen 论文提交至 arXiv，并在 GitHub 的 HorizonRobotics 组织下开源代码。EmbodiedGen 是交互式 3D 世界生成平台，可低成本批量生成带真实物理属性与真实尺度、以 URDF 格式输出的可控 3D 资产，用于具身智能任务的训练与评测。"}, "evidence": [{"url": "https://arxiv.org/abs/2506.10600", "publisher": "arXiv", "tier": "primary", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/arxiv-2025-06-12-horizon-robotics-embodie.html"}, {"url": "https://github.com/HorizonRobotics/EmbodiedGen", "publisher": "地平线 GitHub 组织", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/github-2025-06-12-horizon-robotics-embodie.html"}]}, {"path": "events/2025/05/evt-2025-05-29-horizon-robotics-publication-robotransfer.yaml", "id": "evt-2025-05-29-horizon-robotics-publication-robotransfer", "orgs": [{"id": "horizon-robotics", "role": "subject"}], "title": {"zh": "地平线发布机器人数据合成框架论文《RoboTransfer: Controllable Geometry-Consistent Video Diffusion for Manipulation Policy Transfer》"}, "summary": {"zh": "5 月 29 日，地平线团队将 RoboTransfer 论文提交至 arXiv。RoboTransfer 是面向机器人数据合成的扩散式视频生成框架，用跨视角特征交互与全局一致的 3D 几何约束保证多视角几何一致性，并支持背景编辑、物体替换等场景要素的细粒度控制，用于缓解仿真到真实的迁移差距。"}, "evidence": [{"url": "https://arxiv.org/abs/2505.23171", "publisher": "arXiv", "tier": "primary", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/arxiv-2025-05-29-horizon-robotics-robotra.html"}]}]