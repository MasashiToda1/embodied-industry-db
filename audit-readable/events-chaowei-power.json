[{"path": "events/2026/04/evt-2026-04-26-chaowei-power-product_launch-kai-humanoid.yaml", "id": "evt-2026-04-26-chaowei-power-product_launch-kai-humanoid", "orgs": [{"id": "chaowei-power", "role": "subject"}], "title": {"zh": "超维动力发布首款全尺寸人形机器人 KAI，同步介绍 KAI World Model 与数采头环 KAI Halo"}, "summary": {"zh": "4 月 26 日，超维动力（Kinetix AI）举办「降临 GIFTED」发布会，正式发布首款全尺寸人形机器人 KAI：本体 KaiBot 身高 173 厘米、体重 70 公斤，全身 115 个自由度，单手 36 个自由度灵巧手，全身触觉皮肤 18000 个触点，1.7kWh 半固态电池支持约 3 小时双臂操作。发布会同时介绍了包含动作模块与评估模块的 KAI World Model、「一芯八摄」轻量化头环数采终端 KAI Halo，以及预训练（互联网、仿真与第一人称数据）—桥接训练（UMI 与数采手套数据）—后训练（真机遥操数据）三阶段训练体系。"}, "evidence": [{"url": "https://finance.sina.com.cn/tech/roll/2026-04-27/doc-inhvxtqy9074347.shtml", "publisher": "新浪科技", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/finance-2026-04-26-chaowei-power-kai-launch.html"}]}, {"path": "events/2026/09/evt-2026-09-11-chaowei-power-funding-23.yaml", "id": "evt-2026-09-11-chaowei-power-funding-23", "orgs": [{"id": "chaowei-power", "role": "subject"}], "title": {"zh": "宣布完成超 5 亿元天使+轮系列融资，华兴资本担任独家财务顾问"}, "summary": {"zh": "宣布完成超 5 亿元天使+轮系列融资，华兴资本担任独家财务顾问。"}, "evidence": [{"url": "https://www.jiemian.com/article/15083510.html", "publisher": "", "tier": "media", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/jiemian-2026-09-11-chaowei-power.html"}, {"url": "https://tech.cnr.cn/techph/20260911/t20260911_527810845.shtml", "publisher": "", "tier": "media", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/tech-2026-09-11-chaowei-power.html"}, {"url": "https://tech.gmw.cn/2026-09/11/content_38996268.htm", "publisher": "", "tier": "media", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/tech-2026-09-11-chaowei-power.html"}]}, {"path": "events/2025/07/evt-2025-07-17-chaowei-power-corporate-founded.yaml", "id": "evt-2025-07-17-chaowei-power-corporate-founded", "orgs": [{"id": "chaowei-power", "role": "subject"}], "title": {"zh": "深圳超维动力智能科技有限公司成立"}, "summary": {"zh": "超维动力（Kinetix AI）官网介绍公司成立于 2025 年 7 月，定位全栈具身智能大模型企业，选择高拟人人形路线，围绕本体、大脑、灵巧操作与数据闭环搭建能力。亿欧报道写明深圳超维动力智能科技有限公司成立于 2025 年 7 月 17 日，总部位于深圳，在香港设有研发中心。"}, "evidence": [{"url": "https://www.kinetixai.tech/zh/about", "publisher": "超维动力官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/kinetixai-2025-07-17-chaowei-power-founded.html"}, {"url": "https://www.163.com/dy/article/KHVRI09C05118K7K.html", "publisher": "网易号转载亿欧", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/163-2025-07-17-chaowei-power-founded-16.html"}]}, {"path": "events/2025/10/evt-2025-10-30-chaowei-power-funding-angel-round.yaml", "id": "evt-2025-10-30-chaowei-power-funding-angel-round", "orgs": [{"id": "chaowei-power", "role": "subject"}], "title": {"zh": "超维动力完成天使轮融资，分享投资与青鸟消防共同投资"}, "summary": {"zh": "2025 年 10 月 30 日，深圳超维动力智能科技有限公司宣布完成天使轮融资，由分享投资和青鸟消防共同投资，金额未披露，资金用于具身智能机器人技术研发及团队建设。文中称公司成立于 2025 年 7 月 17 日，总部位于深圳和香港。"}, "evidence": [{"url": "https://www.163.com/dy/article/KD609UOO05118K7K.html", "publisher": "网易号（亿欧）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/163-2025-10-30-chaowei-power-angel-roun.html"}]}, {"path": "events/2025/12/evt-2025-12-28-chaowei-power-funding-pre-a-round.yaml", "id": "evt-2025-12-28-chaowei-power-funding-pre-a-round", "orgs": [{"id": "chaowei-power", "role": "subject"}], "title": {"zh": "超维动力完成 Pre-A 轮融资，松禾资本领投"}, "summary": {"zh": "2025 年 12 月 28 日，深圳超维动力智能科技有限公司宣布完成 Pre-A 轮融资，由松禾资本领投，金额未披露。文中称公司总部位于深圳，并在香港设有研发中心。"}, "evidence": [{"url": "https://www.163.com/dy/article/KHVRI09C05118K7K.html", "publisher": "网易号（亿欧）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/163-2025-12-28-chaowei-power-pre-a-roun.html"}, {"url": "https://www.donews.com/news/detail/8/6336926.html", "publisher": "DoNews", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/donews-2025-12-28-chaowei-power-pre-a-roun.html"}]}]