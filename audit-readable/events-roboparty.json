[{"path": "events/2026/03/evt-2026-03-31-roboparty-funding-angel-round.yaml", "id": "evt-2026-03-31-roboparty-funding-angel-round", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "RoboParty 萝博派对完成 2000 万美元天使轮融资，商汤国香资本、经纬创投联合领投"}, "summary": {"zh": "3 月 31 日消息，「RoboParty 萝博派对」宣布完成 2000 万美元天使轮融资，由商汤国香资本、经纬创投超额加注并联合领投，浦东创投、上海未来产业基金、安创资本、赛纳资本、百川资本等跟投，光源资本担任孵化方和独家财务顾问，为半年内官宣的第三轮融资。资金用于本体、运控、软硬件系统协同及开发者生态投入；文中提到 2026 年 1 月 15 日开源的双足人形机器人萝博头原型机（ROBOTO Origin）。"}, "evidence": [{"url": "https://news.pedaily.cn/202603/562269.shtml", "publisher": "投资界", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/news-2026-03-31-roboparty-angel-round.html"}]}, {"path": "events/2026/07/evt-2026-07-15-roboparty-funding-angel-plus-plus-pre-a.yaml", "id": "evt-2026-07-15-roboparty-funding-angel-plus-plus-pre-a", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "RoboParty 萝博派对连续完成近 5 亿元天使++轮和 Pre-A 轮融资，Pre-A 轮由宁德时代独家投资"}, "summary": {"zh": "7 月 15 日消息，开源具身全栈平台「RoboParty 萝博派对」近日连续完成近 5 亿元人民币天使++轮和 Pre-A 轮融资：天使++轮由顺为资本、经纬创投、小米战投、商汤国香等老股东持续加注，Pre-A 轮由宁德时代独家投资，光源资本担任孵化方和独家财务顾问。报道称公司已完成从关节模组、整机平台、运动控制、SDK 到开源开发体系的底层建设，正在进入量产爬坡阶段，并于 2026 年 1 月成立 RoboParty Lab。"}, "evidence": [{"url": "https://finance.sina.com.cn/tech/roll/2026-07-15/doc-inihvytp7900556.shtml", "publisher": "新浪科技", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/finance-2026-07-15-roboparty-pre-a-round.html"}]}, {"path": "events/2026/09/evt-2026-09-15-roboparty-publication-roboparty.yaml", "id": "evt-2026-09-15-roboparty-publication-roboparty", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "萝博派对新建 4 个仓库（2026-09-10～2026-09-15）"}, "summary": {"zh": "萝博派对新建 4 个仓库（2026-09-10～2026-09-15）。来源：GitHub · Roboparty"}, "evidence": [{"url": "https://github.com/Roboparty", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-15-roboparty.html"}]}, {"path": "events/2026/09/evt-2026-09-14-roboparty-publication-v1-7-18.yaml", "id": "evt-2026-09-14-roboparty-publication-v1-7-18", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "萝博派对发布 robopi_addon v1.7.18"}, "summary": {"zh": "萝博派对发布 robopi_addon v1.7.18。来源：GitHub · Roboparty"}, "evidence": [{"url": "https://github.com/Roboparty/robopi_addon/releases/tag/v1.7.18", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-14-roboparty.html"}]}, {"path": "events/2026/09/evt-2026-09-10-roboparty-publication-dexhand-v0-5-0.yaml", "id": "evt-2026-09-10-roboparty-publication-dexhand-v0-5-0", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "萝博派对发布 roboparty_dexhand v0.5.0"}, "summary": {"zh": "该标签下的 README 将软件定义为 RP_Hand 6DOF 灵巧手的 Linux C++/Python 控制库，通过 SocketCAN CAN-FD 通信。发布说明只写 update to 24.04 并附版本比较链接，未进一步解释该版本号的含义。 日期采用官方 GitHub release 的 published_at（UTC）。"}, "evidence": [{"url": "https://github.com/Roboparty/roboparty_dexhand/releases/tag/v0.5.0", "publisher": "GitHub · Roboparty", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-dexhand-v0-5-0-release-20261001.json"}, {"url": "https://github.com/Roboparty/roboparty_dexhand/blob/v0.5.0/README.md", "publisher": "GitHub · Roboparty", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-dexhand-v0-5-0-readme-20261001.md"}]}, {"path": "events/2026/09/evt-2026-09-30-roboparty-publication-capture-repository.yaml", "id": "evt-2026-09-30-roboparty-publication-capture-repository", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "萝博派对创建 roboparty_capture 数据采集工具仓库"}, "summary": {"zh": "GitHub 元数据显示，萝博派对官方账号 Roboparty 于 9 月 30 日创建 roboparty_capture 仓库。截至 10 月 1 日核验，公开 README 将其描述为基于 ROS 2 的机器人板端数据采集包，提供 EGO 双目相机和 IMU 驱动，并将相机、机器人状态及遥操命令录制为 MCAP 文件。README 同时注明，完整构建、取数与录制验收仍待完成。"}, "evidence": [{"url": "https://api.github.com/repos/Roboparty/roboparty_capture", "publisher": "GitHub · Roboparty", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-roboparty-capture-repo-20261001.json"}, {"url": "https://github.com/Roboparty/roboparty_capture/blob/feat/recording-workflow/README.md", "publisher": "GitHub · Roboparty README", "tier": "official", "retrieved": "2026-10-01", "snapshot": "snapshots/2026/10/github-roboparty-capture-readme-20261001.md"}]}, {"path": "events/2026/09/evt-2026-09-10-roboparty-publication-v1-5-0.yaml", "id": "evt-2026-09-10-roboparty-publication-v1-5-0", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "萝博派对发布 roboparty_bms v1.5.0"}, "summary": {"zh": "萝博派对发布 roboparty_bms v1.5.0。来源：GitHub · Roboparty"}, "evidence": [{"url": "https://github.com/Roboparty/roboparty_bms/releases/tag/v1.5.0", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-10-roboparty.html"}]}, {"path": "events/2026/09/evt-2026-09-18-roboparty-publication-13.yaml", "id": "evt-2026-09-18-roboparty-publication-13", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "萝博派对发布 robopi_analyze v1.0.9"}, "summary": {"zh": "萝博派对发布 robopi_analyze v1.0.9。v1.0.9：## What's Changed * fix analyzer by @MsFANRUI in https://github.com/Roboparty/robopi_analyze/pull/5 **Full Changelog**: https://github.com/Roboparty/robopi_analyze/compare/v1.0.7...v1.0.9"}, "evidence": [{"url": "https://github.com/Roboparty/robopi_analyze/releases/tag/v1.0.9", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-18-roboparty.html"}]}, {"path": "events/2026/08/evt-2026-08-22-roboparty-product_launch-rp1-wrc-debut.yaml", "id": "evt-2026-08-22-roboparty-product_launch-rp1-wrc-debut", "orgs": [{"id": "roboparty", "role": "subject"}, {"id": "alibaba-robotics", "role": "counterparty"}], "title": {"zh": "RoboParty 在 2026 世界机器人大会首次完整公开下一代通用人形机器人 RP1 外观"}, "summary": {"zh": "2026 世界机器人大会期间，RoboParty 萝博派对围绕「全栈开源」集中展示 RPO 机器人、前沿技术与开发者生态，并首次完整公开下一代通用人形机器人 RP1 的产品外观，暂不公布关键参数；RP1 定位更高性能的通用人形机器人本体，面向科研开发者和前沿具身智能研究，包括自研核心关节模组、灵巧手适配与拓展接口。RoboParty 还联合阿里巴巴达摩院于 8 月 21 日举办「开源具身智能与通用人形机器人的未来」技术论坛。"}, "evidence": [{"url": "http://www.investorscn.com/2026/08/22/135964/", "publisher": "投资家网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/investorscn-2026-08-22-roboparty-rp1-wrc.html"}]}, {"path": "events/2026/05/evt-2026-05-19-roboparty-funding-angel-plus-round.yaml", "id": "evt-2026-05-19-roboparty-funding-angel-plus-round", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "RoboParty 萝博派对完成数千万美元天使+轮融资，顺为资本领投、小米战投追加"}, "summary": {"zh": "5 月 19 日消息，「RoboParty 萝博派对」宣布完成数千万美元天使+轮融资，由顺为资本领投，小米战投追加投资，光源资本担任孵化方和独家财务顾问，距上一轮完成不到一个月，为公司自 2025 年 2 月成立以来的第四轮融资。报道称首款产品 RPO 及开源平台已进入首批数百台交付阶段，GitHub 项目 1.7K Star，开发者社区人数突破 5000 人。"}, "evidence": [{"url": "https://news.pedaily.cn/202605/564040.shtml", "publisher": "投资界", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/news-2026-05-19-roboparty-angel-plus-rou.html"}, {"url": "https://finance.sina.com.cn/wm/2026-05-20/doc-inhyqqhf8552209.shtml", "publisher": "新浪财经（转载第一机器人）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/finance-2026-05-19-roboparty-angel-plus-rou.html"}]}, {"path": "events/2025/02/evt-2025-02-21-roboparty-corporate-founded.yaml", "id": "evt-2025-02-21-roboparty-corporate-founded", "orgs": [{"id": "roboparty", "role": "subject"}], "title": {"zh": "上海萝博派对科技有限公司成立"}, "summary": {"zh": "萝博派对在其开源仓库 roboto_origin 的说明中写明，上海萝博派对科技有限公司成立于 2025 年 2 月 21 日，2025 年 4 月开始正式投入人形机器人研发。百度百科记载公司注册地为上海市浦东新区秀浦路 2388 号 13 幢 407 室。"}, "evidence": [{"url": "https://github.com/Roboparty/roboto_origin/blob/main/README_cn.md", "publisher": "萝博派对 GitHub 组织", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/02/github-2025-02-21-roboparty-founded-readme.html"}, {"url": "https://baike.baidu.com/item/%E4%B8%8A%E6%B5%B7%E8%90%9D%E5%8D%9A%E6%B4%BE%E5%AF%B9%E7%A7%91%E6%8A%80%E6%9C%89%E9%99%90%E5%85%AC%E5%8F%B8/66988002", "publisher": "百度百科", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/02/baike-2025-02-21-roboparty-founded-baike.html"}]}]