[{"path": "events/2024/06/evt-2024-06-25-duatic-funding-venture-kick-stage1-40k-chf.yaml", "id": "evt-2024-06-25-duatic-funding-venture-kick-stage1-40k-chf", "orgs": [{"id": "duatic", "role": "subject"}], "title": {"zh": "Duatic 入选 Venture Kick 第一阶段，获 4 万瑞士法郎早期资助"}, "summary": {"zh": "6 月 25 日，瑞士早期创业资助机构 Venture Kick 宣布 Duatic、Grensol 与 SecondWave Photonics 入选其第一阶段财务与创业支持，Duatic 获 4 万瑞士法郎。Venture Kick 称 Duatic 提供全栈机器人移动操作方案，团队来自 ETH 机器人研究，自研机械臂与机器学习技术紧密集成。这是 Duatic 目前唯一公开的融资信息。"}, "evidence": [{"url": "https://www.venturekick.ch/CHF-40000-for-fullstack-robotic-mobile-manipulation-solutions-recycling-with-lightpowered-material-recovery-and-nextgen-light-analysis-sensors", "publisher": "Venture Kick 官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/06/venturekick-2024-06-25-duatic-venture-kick-40k.html"}]}, {"path": "events/2025/06/evt-2025-06-30-duatic-product_launch-alpha-automatica.yaml", "id": "evt-2025-06-30-duatic-product_launch-alpha-automatica", "orgs": [{"id": "duatic", "role": "subject"}], "title": {"zh": "Duatic 在 automatica 2025 推出服务机器人 Alpha"}, "summary": {"zh": "6 月 30 日，Duatic 在其领英账号发布 automatica 2025（慕尼黑）参展回顾，称本届展会上推出了新的服务机器人 Alpha，定位为把先进自动化带到多个行业的模块化平台，在展台做了现场演示与多场洽谈。"}, "evidence": [{"url": "https://www.linkedin.com/posts/duatic_duatic-automatica2025-robotics-activity-7345517814079758337-EgR4", "publisher": "Duatic 官方领英账号", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/linkedin-2025-06-30-duatic-alpha-automatica.html"}]}]