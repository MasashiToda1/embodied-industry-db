[{"path": "events/2026/02/evt-2026-02-wanjiyizu-funding-angel-round.yaml", "id": "evt-2026-02-wanjiyizu-funding-angel-round", "orgs": [{"id": "wanjiyizu", "role": "subject"}], "title": {"zh": "万机易租完成首轮天使轮融资，三位企业家联合战略投资"}, "summary": {"zh": "2026 年 2 月，万机易租宣布完成首轮天使轮融资，由三位细分赛道头部企业家联合战略投资，金额未披露。资金用于城市网络扩张、AI 匹配与数字化运维平台升级、供应链绑定与团队扩张。公司称平台已覆盖全国 30 个核心城市、超 300 家服务商，全品类机器人租金从 100 元至数千元，并与捞王、卡通尼乐园达成合作。"}, "evidence": [{"url": "https://www.163.com/dy/article/KLGD6HCC053900WX.html", "publisher": "网易号 · 转载 IPO 早知道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/163-2026-02-wanjiyizu-angel-round.html"}]}, {"path": "events/2026/08/evt-2026-08-03-wanjiyizu-deployment-fleet-5000-units.yaml", "id": "evt-2026-08-03-wanjiyizu-deployment-fleet-5000-units", "orgs": [{"id": "wanjiyizu", "role": "subject"}, {"id": "ubtech", "role": "supplier"}, {"id": "dobot", "role": "supplier"}, {"id": "x-square-robot", "role": "supplier"}, {"id": "magiclab", "role": "supplier"}], "title": {"zh": "万机易租披露平台可调度合作机器人超 5000 台，接入优必选、越疆、自变量、魔法原子等厂商"}, "summary": {"zh": "8 月 3 日报道，万机易租平台可调度合作机器人规模超 5000 台，合作企业包括优必选、越疆、自变量、魔法原子、优理奇、鲸鱼 AI 教育机器人、大咖机器人等，已在文旅、商演、展会、零售、办公、教育、酒店等场景交付项目。平台以 App 与微信小程序为载体，业务含新机销售、二手设备流转、定制开发、维保检修、零配件供销。"}, "evidence": [{"url": "https://www.gasgoo.com/robot/news/70468423-seeds-%E4%B8%87%E6%9C%BA%E6%98%93%E7%A7%9F%E5%AE%8C%E6%88%90%E6%96%B0%E4%B8%80%E8%BD%AE%E8%9E%8D%E8%B5%84/", "publisher": "盖世汽车", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/gasgoo-2026-08-03-wanjiyizu-second-round.html"}]}, {"path": "events/2026/08/evt-2026-08-03-wanjiyizu-funding-second-strategic-round.yaml", "id": "evt-2026-08-03-wanjiyizu-funding-second-strategic-round", "orgs": [{"id": "wanjiyizu", "role": "subject"}], "title": {"zh": "万机易租完成第二轮战略融资，投后估值突破 10 亿元"}, "summary": {"zh": "8 月 3 日报道，上海万机易租科技有限公司近日完成第二轮战略融资，引入头部生物产业企业家与文化传媒企业两类战略投资方，金额未披露，交割后投后估值突破 10 亿元。公司称将布局国内 30 座核心城市、落地超 300 家合作服务商。"}, "evidence": [{"url": "https://www.gasgoo.com/robot/news/70468423-seeds-%E4%B8%87%E6%9C%BA%E6%98%93%E7%A7%9F%E5%AE%8C%E6%88%90%E6%96%B0%E4%B8%80%E8%BD%AE%E8%9E%8D%E8%B5%84/", "publisher": "盖世汽车", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/gasgoo-2026-08-03-wanjiyizu-second-round.html"}]}, {"path": "events/2026/01/evt-2026-01-15-wanjiyizu-corporate-platform-launch.yaml", "id": "evt-2026-01-15-wanjiyizu-corporate-platform-launch", "orgs": [{"id": "wanjiyizu", "role": "subject"}], "title": {"zh": "万机易租平台在上海松江发布上线"}, "summary": {"zh": "2026 年 1 月 15 日，全球机器人租赁生态联盟峰会暨万机易租平台发布会在上海松江区临港松江科技城举行，机器人租赁平台「万机易租」正式上线，并同步发起全球机器人租赁生态联盟。用户通过小程序下单，可租表演、清洁、教学、陪护等品类机器人。主要股东含德马科技、捞王餐饮集团、达诺尔的创始人及梧桐树资本、弘瑞资本、老鹰基金合伙人。"}, "evidence": [{"url": "https://www.36kr.com/p/3642181919592329", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/36kr-2026-01-15-wanjiyizu-platform-launc.html"}]}]