[{"path": "events/2026/09/evt-2026-09-dexmate-partnership-tianchuang-special-robots.yaml", "id": "evt-2026-09-dexmate-partnership-tianchuang-special-robots", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人与南京天创智能签署亿元级框架协议，合作特种场景具身机器人"}, "summary": {"zh": "2026 年 9 月初报道，南京天创智能科技有限公司与戴盟（深圳）机器人科技有限公司签署亿元级战略合作框架协议，围绕消防、电网、矿山、化工防爆等特种场景，结合天创的防爆巡检整机制造与戴盟的触觉传感器、Daimon-TWM 模型，推进电网巡检机器人触觉增强改造与矿山掘进机器人柔性操作系统开发。报道注明「亿元是框架协议，不是确定采购」。"}, "evidence": [{"url": "https://www.dtm.com.cn/news/202609/305866.html", "publisher": "天脉财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/dtm-2026-09-dexmate-tianchuang.html"}, {"url": "https://caifuhao.eastmoney.com/news/20260903225801847968810", "publisher": "东方财富网财富号", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/caifuhao-2026-09-dexmate-tianchuang-eastm.html"}]}, {"path": "events/2026/08/evt-2026-08-dexmate-product-launch-daimon-twm.yaml", "id": "evt-2026-08-dexmate-product-launch-daimon-twm", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人发布触觉锚定世界模型 Daimon-TWM"}, "summary": {"zh": "2026 年 8 月，戴盟机器人发布触觉锚定世界模型 Daimon-TWM（Tactile-grounded World Model），官方称其将物理认知、推演决策与瞬时操控纳入统一模型框架，正与全球头部 3C 企业及特斯拉供应链企业开展模型落地验证。公司 2024 年提出在 VLA 架构中引入触觉的 VTLA 路线。"}, "evidence": [{"url": "https://www.36kr.com/p/3935107450125442", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/36kr-2026-08-11-dexmate-ant-round.html"}]}, {"path": "events/2026/08/evt-2026-08-11-dexmate-funding-ant-strategic.yaml", "id": "evt-2026-08-11-dexmate-funding-ant-strategic", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人完成数亿元战略融资，蚂蚁集团领投"}, "summary": {"zh": "2026 年 8 月 11 日，戴盟机器人宣布完成数亿元融资，由蚂蚁集团领投，老股东超额跟投加注。公司称自研视触觉传感器已实现万片级出货，累计服务全球 200 余家客户，近期向 OpenAI、Figure、Physical Intelligence、Skild AI、Meta、BMW、Google DeepMind 等交付；并与中国移动共建「数采进家庭」采集网络，首期投放 1000 套设备。"}, "evidence": [{"url": "https://www.36kr.com/p/3935107450125442", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/36kr-2026-08-11-dexmate-ant-round.html"}, {"url": "https://m.21jingji.com/article/20260811/herald/cb391d5afca50c997e0e54571f7bb0ec.html", "publisher": "21世纪经济报道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/m-2026-08-11-dexmate-ant-round-21.html"}]}, {"path": "events/2026/06/evt-2026-06-04-dexmate-funding-a-round.yaml", "id": "evt-2026-06-04-dexmate-funding-a-round", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人完成亿元 A 轮融资，汇川产投与中国电信联合投资"}, "summary": {"zh": "证券时报 6 月 4 日报道，戴盟机器人近日完成亿元 A 轮融资，由汇川技术旗下产业基金汇川产投与中国电信联合投资，资金用于打造超大规模含物理交互信息数据集和物理世界模型研发。36氪报道称其视触觉传感器出货量居全球第一。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3944636.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/stcn-2026-06-dexmate-a-round.html"}, {"url": "https://m.36kr.com/p/3837269482091656", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/06/m-2026-06-dexmate-a-round-36kr.html"}]}, {"path": "events/2024/11/evt-2024-11-18-dexmate-funding-angel-plus.yaml", "id": "evt-2024-11-18-dexmate-funding-angel-plus", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人宣布连续完成两轮亿元级天使 + 轮融资"}, "summary": {"zh": "11 月 18 日，戴盟机器人（Daimon Robotics）宣布连续完成两轮亿元级人民币天使 + 轮融资，由国中资本联合领投，主要投资方包括金鼎资本、联想创投以及头部银行系投资机构。公司称资金主要用于视触觉（光学式触觉）传感器、触觉灵巧手以及含触觉的多模态感知操作模型等产品与技术研发。报道称公司 2023 年 8 月正式运营，团队规模超 30 人，研发人员占比超 80%。"}, "evidence": [{"url": "https://www.chinaventure.com.cn/news/108-20241118-383899.html", "publisher": "投中网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/chinaventure-2024-11-18-dexmate-angel-plus.html"}, {"url": "https://finance.sina.com.cn/tech/roll/2024-11-18/doc-incwmzst0500122.shtml", "publisher": "新浪科技", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/11/finance-2024-11-18-dexmate-angel-plus-sina.html"}]}, {"path": "events/2025/04/evt-2025-04-16-dexmate-product-launch-dm-family.yaml", "id": "evt-2025-04-16-dexmate-product-launch-dm-family", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人发布 DM-Tac W 视触觉传感器、DM-Hand1 灵巧手与 DM-EXton 数采系统"}, "summary": {"zh": "4 月 16 日，戴盟机器人发布三款产品：多维高分辨率高频率视触觉传感器 DM-Tac W、多维触觉感知五指灵巧手 DM-Hand1、便携穿戴式遥操作数据采集系统 DM-EXton。官方稿称 DM-Tac W 每平方厘米覆盖 4 万个感知单元，基于单色光原理；DM-Hand1 在指尖集成毫米级厚度视触觉传感器，结合力位混合控制算法；DM-EXton 适配主流机器人本体。公司称系列产品已在具身智能、智慧物流、智能制造、实验室自动化等场景小规模应用并面向全球开发者公开销售，未公布售价。"}, "evidence": [{"url": "https://www.prnasia.com/story/485826-1.shtml", "publisher": "美通社（戴盟机器人通稿）", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/prnasia-2025-04-16-dexmate-family-launch.html"}, {"url": "https://www.21jingji.com/article/20250416/herald/b1ce6ca6df64c2bb74681348abd6fbb4.html", "publisher": "21 世纪经济报道", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/21jingji-2025-04-16-dexmate-family-launch-21.html"}]}, {"path": "events/2025/08/evt-2025-08-12-dexmate-funding-angel-plus-plus.yaml", "id": "evt-2025-08-12-dexmate-funding-angel-plus-plus", "orgs": [{"id": "dexmate", "role": "subject"}], "title": {"zh": "戴盟机器人完成亿元级天使 ++ 轮融资，招商局创投领投"}, "summary": {"zh": "8 月 12 日，戴盟机器人宣布完成亿元级天使 ++ 轮融资，由招商局创投领投，东方嘉富、架桥资本跟投，资金用于视触觉感知与灵巧操作技术的落地应用。报道写明此前公司完成了昆仲资本独投的天使轮融资，以及国中资本、金鼎资本、联想创投和招银国际联合投资的天使 + 轮融资，三轮累计融资金额达数亿元。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3049769.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/stcn-2025-08-12-dexmate-angel-pp.html"}, {"url": "https://www.chinaventure.com.cn/news/114-20250812-387556.html", "publisher": "投中网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/chinaventure-2025-08-12-dexmate-angel-pp-cv.html"}]}]