[{"path": "events/2026/03/evt-2026-03-29-inspire-robots-product_launch-rh56h1.yaml", "id": "evt-2026-03-29-inspire-robots-product_launch-rh56h1", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人发布小尺寸灵巧手 RH56H1 系列"}, "summary": {"zh": "3 月 29 日，因时机器人发布 RH56H1 系列灵巧手，定位小尺寸高性能执行器，面向具身智能与人形机器人应用。产品尺寸 159.70mm×75.18mm，六自由度、十一关节，单指最大输出力 15N，单指被动负载 8kg，控制频率 1000Hz，集成触觉传感器，支持 Modbus-RTU、EtherCAT、RS485 及 CANFD 通信协议。"}, "evidence": [{"url": "https://www.aibangbots.com/a/8062", "publisher": "艾邦机器人", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/aibangbots-2026-03-29-inspire-robots-rh56h1-la.html"}]}, {"path": "events/2026/02/evt-2026-02-24-inspire-robots-funding-c1-c2-round.yaml", "id": "evt-2026-02-24-inspire-robots-funding-c1-c2-round", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人完成数亿元 C1 轮及 C2 轮融资"}, "summary": {"zh": "因时机器人宣布完成 C1 及 C2 两轮融资，合计融资金额数亿元人民币。C1 轮由中国移动链长基金与深创投联合领投，博原资本、达晨财智、春华资本跟投；C2 轮由北京市人工智能产业投资基金领投，启明创投、博原资本、春华资本、金石数经基金、TCL 创投跟投。公司称融资用于灵巧操作技术研发、核心零部件产品创新、提升交付能力与拓展全球化市场。"}, "evidence": [{"url": "https://www.chinaventure.com.cn/news/114-20260225-390217.html", "publisher": "投中网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/chinaventure-2026-02-24-inspire-robots-c1-c2-rou.html"}]}, {"path": "events/2026/08/evt-2026-08-inspire-robots-product_launch-rh524j1-wrc.yaml", "id": "evt-2026-08-inspire-robots-product_launch-rh524j1-wrc", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人在 2026 世界机器人大会首发 RH524J1 系列 24 自由度腱绳混合驱动灵巧手"}, "summary": {"zh": "2026 世界机器人大会期间，因时机器人在 B405 展位完成 RH524J1 系列 24 自由度腱绳混合驱动灵巧手全球首发。该产品手指 22 个、手腕 2 个合计 24 个主动自由度，采用腱绳与直驱混合驱动架构，集成接近觉、触觉、深度视觉多维度感知。公司称微型伺服电缸年产能达 50 万台。"}, "evidence": [{"url": "http://www.eeo.com.cn/2026/0821/1006890.shtml", "publisher": "经济观察网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/eeo-2026-08-inspire-robots-rh524j1-w.html"}]}, {"path": "events/2024/09/evt-2024-09-29-inspire-robots-deployment-customer-coverage.yaml", "id": "evt-2024-09-29-inspire-robots-deployment-customer-coverage", "orgs": [{"id": "inspire-robots", "role": "subject"}, {"id": "ubtech", "role": "customer"}, {"id": "agibot", "role": "customer"}, {"id": "galbot", "role": "customer"}, {"id": "unitree", "role": "customer"}, {"id": "skild-ai", "role": "customer"}], "title": {"zh": "因时机器人披露微型伺服电缸与灵巧手已服务的客户范围"}, "summary": {"zh": "9 月 29 日报道，因时机器人自 2016 年开始研发微型伺服电缸与仿人五指灵巧手，是国内第一家推出商业化灵巧手、也是当时唯一已大批量交付的厂商，服务客户包括 CATL、ATL、BYD、SKILD AI、优必选、智元、银河通用、宇树科技等企业。"}, "evidence": [{"url": "https://news.pedaily.cn/202409/540834.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/news-2024-09-27-inspire-robots-b2-round.html"}]}, {"path": "events/2024/09/evt-2024-09-27-inspire-robots-funding-b2-round.yaml", "id": "evt-2024-09-27-inspire-robots-funding-b2-round", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人完成超亿元 B2 轮融资"}, "summary": {"zh": "9 月 27 日消息，因时机器人完成超亿元 B2 轮融资，由达晨财智领投，深创投、中金资本旗下基金、钧山、天投科创投资公司、芯联资本和科沃斯跟投，久谦资本担任本轮独家财务顾问。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20240930A021DX00", "publisher": "高工机器人（腾讯新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/news-2024-09-27-inspire-robots-b2-round-.html"}, {"url": "https://news.pedaily.cn/202409/540834.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/09/news-2024-09-27-inspire-robots-b2-round.html"}]}, {"path": "events/2025/07/evt-2025-07-26-inspire-robots-product_launch-rh56f1.yaml", "id": "evt-2025-07-26-inspire-robots-product_launch-rh56f1", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人发布第五代 RH56F1 系列仿人五指灵巧手"}, "summary": {"zh": "7 月 26 日，在 2025 WAIC 世界人工智能大会上，因时机器人发布第五代产品 RH56F1 系列仿人五指灵巧手。该系列采用全金属机身与骨架一体化设计，支持 1KHz 高速实时通讯，静态被动载荷 30KG，指尖抓握力 15N。"}, "evidence": [{"url": "https://www.ithome.com/0/870/952.htm", "publisher": "IT之家", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/ithome-2025-07-26-inspire-robots-rh56f1.html"}]}, {"path": "events/2025/04/evt-2025-04-29-inspire-robots-funding-b3-round.yaml", "id": "evt-2025-04-29-inspire-robots-funding-b3-round", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人完成近亿元 B3 轮融资"}, "summary": {"zh": "4 月 29 日消息，因时机器人完成近亿元人民币 B3 轮投资，由神骐资本领投，源禾资本、华盖资本跟投，久谦资本担任长期独家财务顾问。融资将投入尖端技术研发、产品迭代以及全球化市场拓展。"}, "evidence": [{"url": "https://36kr.com/newsflashes/3270724216397961", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/36kr-2025-04-29-inspire-robots-b3-round.html"}]}, {"path": "events/2025/12/evt-2025-12-18-inspire-robots-product_launch-rh5dg2.yaml", "id": "evt-2025-12-18-inspire-robots-product_launch-rh5dg2", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人发布 RH5DG2 系列高自由度灵巧手，全年量产交付超 10000 台"}, "summary": {"zh": "12 月 18 日，在杭州举办的第六届中国机器人行业年会上，因时机器人发布新一代 RH5DG2 系列（G2 系列）高自由度灵巧手。G2 系列具备 13 个主动自由度、18 个可运动关节，整手宽度 95mm，重量约 990g，指尖抓握力 20N，掌内集成 8 组触觉传感器。公司 CEO 在大会上称，因时机器人灵巧手全年累计量产交付超过 10000 台。"}, "evidence": [{"url": "https://inspire-robots.com/news/company%20news/2025-12-30/296.html", "publisher": "因时机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/inspire-robo-2025-12-18-inspire-robots-g2-launch.html"}]}, {"path": "events/2025/08/evt-2025-08-inspire-robots-product_launch-rh5eg1-wrc.yaml", "id": "evt-2025-08-inspire-robots-product_launch-rh5eg1-wrc", "orgs": [{"id": "inspire-robots", "role": "subject"}], "title": {"zh": "因时机器人 RH5EG1 系列高自由度灵巧手在 2025 WRC 亮相"}, "summary": {"zh": "在 2025 WRC 世界机器人大会上，因时机器人展出 RH5EG1 系列高自由度仿人五指灵巧手。该系列具有 14 个主动自由度、18 个可运动关节，指尖抓握力达 2kg，掌内集成 13 组高灵敏度触觉传感器，现场以视觉遥操方式演示。"}, "evidence": [{"url": "https://www.leaderobot.com/news/6033", "publisher": "机器人大讲堂", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/leaderobot-2025-08-inspire-robots-rh5eg1-wr.html"}]}]