[{"path": "events/2026/07/evt-2026-07-26-qiyuan-robotics-corporate-pudong-hq.yaml", "id": "evt-2026-07-26-qiyuan-robotics-corporate-pudong-hq", "orgs": [{"id": "qiyuan-robotics", "role": "subject"}], "title": {"zh": "启元新创（上海）落户浦东张江机器人谷，列为上海市人工智能重点项目"}, "summary": {"zh": "证券时报 7 月 26 日报道，上纬新材旗下子公司启元新创（上海）科技有限公司近日正式落户浦东，作为上海市人工智能重点项目签约，项目同步落地张江机器人谷。报道称 2026 年一季度上纬新材具身智能业务研发投入 3778 万元，启元线下体验店已在上海、深圳、西安、厦门、广州陆续启动。"}, "evidence": [{"url": "https://stcn.com/article/detail/4041786.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/stcn-2026-07-26-qiyuan-robotics-pudong.html"}]}, {"path": "events/2026/04/evt-2026-04-qiyuan-robotics-corporate-subsidiaries.yaml", "id": "evt-2026-04-qiyuan-robotics-corporate-subsidiaries", "orgs": [{"id": "qiyuan-robotics", "role": "subject"}], "title": {"zh": "上纬新材审议通过消费级具身智能机器人业务规划，设立启元上海、启元北京两家全资子公司"}, "summary": {"zh": "上纬新材 2026 年半年报披露，公司于 2026 年 4 月审议通过消费级具身智能机器人新业务发展规划，并设立启元上海、启元北京两家全资子公司作为新业务独立载体；上海子公司启元新创为上海市人工智能重点项目。"}, "evidence": [{"url": "https://www.cnfin.com/gs-lb/detail/20260815/4455704_1.html", "publisher": "中国金融信息网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/cnfin-2026-04-qiyuan-robotics-subsidia.html"}, {"url": "http://sh.news.cn/20260815/a3fdf95d43a548a1a5438c71cf9c6548/c.html", "publisher": "新华网上海", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/sh-2026-08-15-qiyuan-robotics-h1-repor.html"}]}, {"path": "events/2026/09/evt-2026-09-20-qiyuan-robotics-product-launch-q1-t1.yaml", "id": "evt-2026-09-20-qiyuan-robotics-product-launch-q1-t1", "orgs": [{"id": "qiyuan-robotics", "role": "subject"}], "title": {"zh": "启元机器人发售个人机器人 Q1、T1，19999 元起"}, "summary": {"zh": "上纬新材旗下消费级具身智能品牌启元机器人在上海举办新品发布会，正式发售启元 Q1 与启元 T1 两款个人机器人，发售即发货。Q1 售价 19999 元，Q1 探索版 26999 元；T1 被报道为「可变形」个人机器人，人形与四足形态可切换。"}, "evidence": [{"url": "https://tech.caijing.com.cn/20260920/5184656.shtml", "publisher": "财经网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/tech-2026-09-20-qiyuan.html"}, {"url": "https://www.robotbloc.com/news/315.html", "publisher": "机器人之家", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/robotbloc-2026-09-20-qiyuan.html"}, {"url": "https://news.dayoo.com/finance/202609/21/171077_55006010.htm", "publisher": "广州日报大洋网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/news-2026-09-20-qiyuan.html"}]}, {"path": "events/2026/08/evt-2026-08-23-qiyuan-robotics-product-launch-preorder.yaml", "id": "evt-2026-08-23-qiyuan-robotics-product-launch-preorder", "orgs": [{"id": "qiyuan-robotics", "role": "subject"}], "title": {"zh": "启元机器人开启启元 Q1、启元 T1 公开预订"}, "summary": {"zh": "8 月 23 日，上纬新材旗下启元机器人正式开启启元 Q1、启元 T1 双产品公开预订。科技日报报道，启元 Q1 身高约 88cm、重约 15 公斤；启元 T1 站立身高约 100cm、重约 16 公斤，可在轮足人形与四足形态间切换。此前两款产品已在 WAIC 2026、ChinaJoy 2026 完成小范围预约。"}, "evidence": [{"url": "https://www.stdaily.com/web/gdxw/2026-08/23/content_568520.html", "publisher": "科技日报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/stdaily-2026-08-23-qiyuan-robotics-preorder.html"}]}, {"path": "events/2026/08/evt-2026-08-15-qiyuan-robotics-partnership-lens-production-line.yaml", "id": "evt-2026-08-15-qiyuan-robotics-partnership-lens-production-line", "orgs": [{"id": "qiyuan-robotics", "role": "subject"}], "title": {"zh": "上纬新材半年报：启元与蓝思智能达成首期万台级机器人产线合作，预收货款 2.1 亿元"}, "summary": {"zh": "上纬新材 2026 年半年报（8 月 15 日报道）披露，公司与蓝思科技子公司蓝思智能达成首期规划万台级机器人的产线合作，已与 20 余家核心渠道商签署合作协议；报告期内消费级具身智能机器人首批订单对应预收货款 2.1 亿元，尚未确认收入。上半年机器人业务研发投入约 1.6 亿元。"}, "evidence": [{"url": "http://sh.news.cn/20260815/a3fdf95d43a548a1a5438c71cf9c6548/c.html", "publisher": "新华网上海", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/sh-2026-08-15-qiyuan-robotics-h1-repor.html"}, {"url": "https://www.cnfin.com/gs-lb/detail/20260815/4455704_1.html", "publisher": "中国金融信息网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/cnfin-2026-04-qiyuan-robotics-subsidia.html"}]}, {"path": "events/2025/12/evt-2025-12-31-qiyuan-robotics-product-launch-q1-reveal.yaml", "id": "evt-2025-12-31-qiyuan-robotics-product-launch-q1-reveal", "orgs": [{"id": "qiyuan-robotics", "role": "subject"}], "title": {"zh": "上纬新材以「上纬启元」品牌发布小尺寸全身力控人形机器人启元 Q1"}, "summary": {"zh": "12 月 31 日，上纬新材董事长彭志辉（稚晖君）发布全身力控小尺寸人形机器人「启元 Q1」，并宣布公司以「上纬启元」品牌进军个人机器人赛道。第一财经报道该机身高不足 1 米，可折叠装入双肩背包；官方称将 QDD 准直驱关节压缩至「比鸡蛋还小」，面向极客玩家、科研人员和家庭用户。"}, "evidence": [{"url": "https://www.yicai.com/news/102983441.html", "publisher": "第一财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/yicai-2025-12-31-qiyuan-robotics-q1-revea.html"}, {"url": "https://www.163.com/tech/article/KI49S0JP00098IEO.html", "publisher": "网易科技", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/163-2025-12-31-qiyuan-robotics-q1-revea.html"}]}]