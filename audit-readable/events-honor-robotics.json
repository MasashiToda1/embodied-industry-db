[{"path": "events/2026/03/evt-2026-03-01-honor-robotics-product_launch-mwc-humanoid-debut.yaml", "id": "evt-2026-03-01-honor-robotics-product_launch-mwc-humanoid-debut", "orgs": [{"id": "honor-robotics", "role": "subject"}, {"id": "paxini", "role": "supplier"}], "title": {"zh": "荣耀首款人形机器人在 MWC 2026 巴塞罗那发布会亮相，同步宣布成立新产业孵化部"}, "summary": {"zh": "3 月 1 日，荣耀在 MWC 2026 全球发布会上展示首款人形机器人，现场完成舞蹈、握手与翻跟头等动作，荣耀未公布名称、价格与详细参数。会后荣耀透露已成立新产业孵化部，下设具身智能实验室、具身数据实验室、交互安全实验室、动力总成实验室和仿生本体研究实验室；同场亮相的灵巧手 DexH13 为帕西尼感知科技与荣耀合作产品。"}, "evidence": [{"url": "https://zhidx.com/p/537008.html", "publisher": "智东西", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/zhidx-2026-03-01-honor-robotics-mwc-human.html"}, {"url": "https://www.gkong.com/news/125105.html", "publisher": "中华工控网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/gkong-2026-03-01-honor-robotics-mwc-human.html"}]}, {"path": "events/2026/03/evt-2026-03-04-hesai-deployment-honor-humanoid-jt-lidar.yaml", "id": "evt-2026-03-04-hesai-deployment-honor-humanoid-jt-lidar", "orgs": [{"id": "hesai", "role": "subject"}, {"id": "honor-robotics", "role": "customer"}], "title": {"zh": "荣耀首款具身智能人形机器人搭载禾赛 JT 系列激光雷达在 MWC 2026 亮相"}, "summary": {"zh": "2026 世界移动通信大会（MWC）上，荣耀第一款具身智能人形机器人亮相，搭载禾赛 JT 系列激光雷达，现场完成握手、太空步、后空翻等动作。禾赛称 JT 系列为迷你型 360° 激光雷达，截至 2025 年累计交付量突破 20 万颗。"}, "evidence": [{"url": "https://www.hesaitech.com/cn/news/1436", "publisher": "禾赛科技官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/hesaitech-2026-03-04-hesai-honor-humanoid-mwc.html"}]}, {"path": "events/2026/04/evt-2026-04-19-honor-robotics-product_launch-shandian-half-marathon.yaml", "id": "evt-2026-04-19-honor-robotics-product_launch-shandian-half-marathon", "orgs": [{"id": "honor-robotics", "role": "subject"}], "title": {"zh": "荣耀人形机器人「闪电」以 50 分 26 秒夺得 2026 北京亦庄人形机器人半马冠军，荣耀称 2026 年小批量量产"}, "summary": {"zh": "4 月 19 日，2026 北京亦庄半程马拉松暨人形机器人半程马拉松上，深圳荣耀智慧科技开发有限公司齐天大圣队的自主导航人形机器人「闪电」以 50 分 26 秒净用时夺冠，另两支荣耀队伍的「闪电」分别以 50 分 56 秒和 53 分 01 秒位列第二、第三。科创板日报称荣耀另一款机器人「元气仔」获最佳步态奖，蓝思科技为荣耀机器人供应 132 款金属结构件，荣耀推进 2026 年小批量量产计划。"}, "evidence": [{"url": "https://www.news.cn/sports/20260419/c91172da5ef84342b7b07fb3c2ef8f12/c.html", "publisher": "新华网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/news-2026-04-19-honor-robotics-half-mara.html"}, {"url": "https://m.cls.cn/detail/2348432", "publisher": "科创板日报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/m-2026-04-19-honor-robotics-half-mara.html"}]}, {"path": "events/2025/04/evt-2025-04-03-honor-robotics-corporate-new-industry-incubation-dept.yaml", "id": "evt-2025-04-03-honor-robotics-corporate-new-industry-incubation-dept", "orgs": [{"id": "honor-robotics", "role": "subject"}], "title": {"zh": "报道称荣耀设立新产业孵化部，下设具身智能实验室等五个实验室"}, "summary": {"zh": "4 月 3 日，《科创板日报》报道称荣耀已设立新产业孵化部，下设具身智能实验室、具身数据实验室、交互安全实验室、动力总成实验室、仿生本体研究实验室。报道称荣耀在招聘网站上发布了机器人数据生成算法工程师、一体化关节设计师、机器人动力系统仿真工程师等岗位。"}, "evidence": [{"url": "https://www.tmtpost.com/nictation/7522156.html", "publisher": "钛媒体（转载《科创板日报》）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/tmtpost-2025-04-03-honor-robotics-incubatio.html"}]}]