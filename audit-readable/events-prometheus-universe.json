[{"path": "events/2026/03/evt-2026-03-02-prometheus-universe-funding-angel-round.yaml", "id": "evt-2026-03-02-prometheus-universe-funding-angel-round", "orgs": [{"id": "prometheus-universe", "role": "subject"}], "title": {"zh": "普罗宇宙机器人完成数千万元天使轮融资"}, "summary": {"zh": "投资界 3 月 2 日报道，普罗宇宙机器人完成数千万元天使轮融资，投资方未披露。报道称公司 2025 年 1 月成立于苏州，首款工业级通用轮式具身机器人大白 8 月发布初代、11 月发布二代并已小批量交付。"}, "evidence": [{"url": "https://m.pedaily.cn/news/561291", "publisher": "投资界", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/m-2026-03-02-prometheus-universe-ange.html"}]}, {"path": "events/2025/11/evt-2025-11-10-prometheus-universe-pricing-dabai-360k.yaml", "id": "evt-2025-11-10-prometheus-universe-pricing-dabai-360k", "orgs": [{"id": "prometheus-universe", "role": "subject"}], "title": {"zh": "普罗宇宙大白机器人售价 36 万元，累计订单达百台"}, "summary": {"zh": "星河频率 11 月 10 日刊发的报道（普罗宇宙官网转载）称，普罗宇宙大白机器人售价 36 万元，全向移动速度 2.5m/s；公司累计订单量已达到百台，在 3C 电子、汽车制造、半导体等工业场景与头部客户合作并启动批量交付。"}, "evidence": [{"url": "https://www.pl-universe.com/article/8/detail/33", "publisher": "星河频率（普罗宇宙官网转载）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/pl-universe-2025-11-10-prometheus-universe-daba.html"}]}, {"path": "events/2025/11/evt-2025-11-01-prometheus-universe-partnership-jd-exclusive-online.yaml", "id": "evt-2025-11-01-prometheus-universe-partnership-jd-exclusive-online", "orgs": [{"id": "prometheus-universe", "role": "subject"}], "title": {"zh": "普罗宇宙与京东达成全球线上独家销售合作"}, "summary": {"zh": "11 月 1 日，普罗宇宙机器人在北京亦庄京东总部宣布与京东达成全球线上独家销售合作，京东成为普罗宇宙全球线上独家销售渠道，双方在产品销售、出海、技术支持、服务体系搭建、营销活动等方面合作。"}, "evidence": [{"url": "http://www.news.cn/tech/20251102/cfe660f0d68444f4bc39b5af68317b26/c.html", "publisher": "新华网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/news-2025-11-01-prometheus-universe-daba.html"}]}, {"path": "events/2025/11/evt-2025-11-01-prometheus-universe-product_launch-dabai-2-0.yaml", "id": "evt-2025-11-01-prometheus-universe-product_launch-dabai-2-0", "orgs": [{"id": "prometheus-universe", "role": "subject"}], "title": {"zh": "普罗宇宙发布工业级轮式具身机器人大白 2.0、四款末端执行器与灵巧手普罗小灵"}, "summary": {"zh": "11 月 1 日，普罗宇宙机器人 2025 新品发布会在北京亦庄京东总部举办，发布工业级轮式具身机器人普罗宇宙大白 2.0 版、四款末端执行器（覆盖锁付、焊锡、点胶、涂油工艺）及灵巧手普罗小灵。大白 2.0 在 300 多个性能点升级，具备亚毫米级操作精度，可集成企业 MES 系统。"}, "evidence": [{"url": "http://www.news.cn/tech/20251102/cfe660f0d68444f4bc39b5af68317b26/c.html", "publisher": "新华网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/news-2025-11-01-prometheus-universe-daba.html"}, {"url": "https://pl-universe.com/article/7/detail/22", "publisher": "普罗宇宙官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/pl-universe-2025-11-01-prometheus-universe-daba.html"}]}, {"path": "events/2025/08/evt-2025-08-08-prometheus-universe-product_launch-dabai-wrc2025.yaml", "id": "evt-2025-08-08-prometheus-universe-product_launch-dabai-wrc2025", "orgs": [{"id": "prometheus-universe", "role": "subject"}], "title": {"zh": "普罗宇宙在 2025 世界机器人大会首发大白机器人"}, "summary": {"zh": "8 月 8 日，世界机器人大会在北京开幕，普罗宇宙携旗下新品大白机器人首发亮相。官网新闻称该产品为工业级具身智能机器人，面向工业场景智能制造领域。"}, "evidence": [{"url": "https://www.pl-universe.com/article/8/detail/10", "publisher": "普罗宇宙官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/pl-universe-2025-08-08-prometheus-universe-daba.html"}]}, {"path": "events/2025/01/evt-2025-01-prometheus-universe-corporate-incorporation.yaml", "id": "evt-2025-01-prometheus-universe-corporate-incorporation", "orgs": [{"id": "prometheus-universe", "role": "subject"}], "title": {"zh": "普罗宇宙机器人在苏州工业园成立"}, "summary": {"zh": "普罗宇宙官网公司介绍页称，普罗宇宙机器人成立于 2025 年 1 月，总部位于苏州工业园，专注具身智能机器人研发与场景落地。官网发展历程栏目将「普罗宇宙机器人 苏州工业园正式成立」标注在 2025.1。"}, "evidence": [{"url": "https://pl-universe.com/about/10", "publisher": "普罗宇宙官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/01/pl-universe-2025-01-prometheus-universe-foun.html"}]}]