[{"path": "events/2026/03/evt-2026-03-02-xiaomi-robotics-deployment-factory-internship.yaml", "id": "evt-2026-03-02-xiaomi-robotics-deployment-factory-internship", "orgs": [{"id": "xiaomi-robotics", "role": "subject"}], "title": {"zh": "小米人形机器人进入汽车工厂「实习」"}, "summary": {"zh": "3 月 2 日，雷军发文称小米机器人已开始在汽车工厂实习；「小米技术」同日发文称，机器人在压铸车间自攻螺母上件工站连续自主运行 3 小时，安装成功率 90.2%，同步满足 76 秒产线节拍。雷军称已在自攻螺母上件、料箱搬运等场景初步实现自主工作。"}, "evidence": [{"url": "https://www.21jingji.com/article/20260302/herald/08affb6ec0392e8076bc491ca9056af1.html", "publisher": "21 经济网（转载中国基金报）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/21jingji-2026-03-02-xiaomi-robotics-factory-.html"}]}, {"path": "events/2026/07/evt-2026-07-16-xiaomi-robotics-product_launch-xiaomi-robotics-1.yaml", "id": "evt-2026-07-16-xiaomi-robotics-product_launch-xiaomi-robotics-1", "orgs": [{"id": "xiaomi-robotics", "role": "subject"}], "title": {"zh": "小米推出具身基座模型 Xiaomi-Robotics-1"}, "summary": {"zh": "7 月 16 日，小米集团正式推出具身基座模型 Xiaomi-Robotics-1。该模型采用「预训练 + 后训练」两阶段训练范式，预训练使用 10 万小时真实世界操作轨迹数据，后训练构建约 1 万小时跨本体数据，模型参数规模最高 10B，可按自然语言指令执行多类任务。"}, "evidence": [{"url": "https://hk.finance.yahoo.com/news/%E5%B0%8F%E7%B1%B3-01810-%E4%BB%8A%E6%97%A5%E6%8E%A8%E5%87%BA%E5%85%B7%E8%BA%AB%E5%9F%BA%E5%BA%A7%E6%A8%A1%E5%9E%8B-xiaomi-robotics-080300497.html", "publisher": "雅虎香港财经（转载汇港通讯）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/hk-2026-07-16-xiaomi-robotics-robotics.html"}]}, {"path": "events/2026/08/evt-2026-08-19-xiaomi-robotics-product_launch-new-humanoid-wrc.yaml", "id": "evt-2026-08-19-xiaomi-robotics-product_launch-new-humanoid-wrc", "orgs": [{"id": "xiaomi-robotics", "role": "subject"}], "title": {"zh": "小米新一代人形机器人在 2026 世界机器人大会首次亮相"}, "summary": {"zh": "8 月 19 日，结束 4 个月汽车工厂实训的小米新一代人形机器人在 2026 世界机器人大会对外亮相，整套动作由具身大模型驱动自主决策执行。小米称该机器人仍处于样机研发阶段，国内首展后将前往欧洲展出；技术路线为全尺寸双足方案，采用「大脑 + 小脑」混合架构，自研 Mi-Sense 深度视觉感知系统。"}, "evidence": [{"url": "https://www.jiemian.com/article/14953257.html", "publisher": "界面新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/jiemian-2026-08-19-xiaomi-robotics-wrc-huma.html"}]}]