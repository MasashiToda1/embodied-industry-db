[{"path": "events/2026/07/evt-2026-07-21-shouxing-funding-a2.yaml", "id": "evt-2026-07-21-shouxing-funding-a2", "orgs": [{"id": "shouxing", "role": "subject"}], "title": {"zh": "首形科技完成数亿元 A2 轮融资，中信金石与吉利资本联合领投"}, "summary": {"zh": "7 月 21 日，首形科技宣布完成数亿元 A2 轮融资，由中信金石与吉利资本联合领投，中信证券国际资本、国泰君安创新投、君礼资本、京铭资本、交源资本跟投，老股东中网投与顺为资本追投。资金投向全系列仿生产品矩阵扩容、标准化量产产线搭建与仿生具身智能算法迭代。"}, "evidence": [{"url": "https://stcn.com/article/detail/4036657.html", "publisher": "证券时报网（来源：21 世纪经济报道）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/stcn-2026-07-21-shouxing-a2-round.html"}, {"url": "https://www.cyzone.cn/article/840668.html", "publisher": "创业邦", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/cyzone-2026-07-21-shouxing-a2-round-cyzone.html"}]}, {"path": "events/2026/04/evt-2026-04-07-shouxing-funding-a1.yaml", "id": "evt-2026-04-07-shouxing-funding-a1", "orgs": [{"id": "shouxing", "role": "subject"}], "title": {"zh": "首形科技完成数亿元 A1 轮融资，华控基金及某互联网大厂联合领投"}, "summary": {"zh": "4 月 7 日，首形科技宣布完成数亿元人民币 A1 轮融资，由华控基金及某互联网大厂联合领投，嘉御资本、鹏瑞基金、亦庄国投、上海半导体产投、南山战新投及老股东招商局创投、顺为资本、弘晖基金、厚雪资本、东方富海跟投。资金用于多模态具身交互系统与情绪基座模型迭代、仿生面部部件规模化及全球市场拓展。"}, "evidence": [{"url": "https://www.yicai.com/news/103120884.html", "publisher": "第一财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/yicai-2026-04-07-shouxing-a1-round.html"}, {"url": "https://m.thepaper.cn/newsDetail_forward_32915673", "publisher": "澎湃新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/m-2026-04-07-shouxing-a1-round-thepap.html"}]}, {"path": "events/2024/10/evt-2024-10-shouxing-funding-angel.yaml", "id": "evt-2024-10-shouxing-funding-angel", "orgs": [{"id": "shouxing", "role": "subject"}, {"id": "agibot", "role": "investor"}], "title": {"zh": "首形科技获天使轮投资，投资方含智元机器人"}, "summary": {"zh": "凤凰网稿件写明「2024 年 10 月，首形科技曾获德迅投资、奇绩创坛、Taihill、智元机器人天使投资」，未披露金额。"}, "evidence": [{"url": "https://finance.ifeng.com/c/8kWQoPlTKzP", "publisher": "凤凰网财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/finance-2024-10-shouxing-angel-2024.html"}]}, {"path": "events/2025/09/evt-2025-09-29-shouxing-funding-ant-led-round.yaml", "id": "evt-2025-09-29-shouxing-funding-ant-led-round", "orgs": [{"id": "shouxing", "role": "subject"}], "title": {"zh": "首形科技完成新一轮过亿元融资，蚂蚁集团领投"}, "summary": {"zh": "9 月 29 日，首形科技（AheadForm）宣布完成新一轮过亿元融资，为 2025 年内第三轮，由蚂蚁集团领投、锦秋基金联合投资，厚雪资本、弘晖基金、鹏城愿景基金参与，老股东顺为资本、招商局创投、Taihill 追投。资金用于情绪基座模型迭代与多场景应用落地。"}, "evidence": [{"url": "https://www.yicai.com/news/102848787.html", "publisher": "第一财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/09/yicai-2025-09-29-shouxing-ant-round.html"}, {"url": "https://www.chinaventure.com.cn/news/114-20250929-388252.html", "publisher": "投中网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/09/chinaventure-2025-09-29-shouxing-ant-round-cv.html"}]}, {"path": "events/2025/12/evt-2025-12-12-shouxing-funding-round-four.yaml", "id": "evt-2025-12-12-shouxing-funding-round-four", "orgs": [{"id": "shouxing", "role": "subject"}], "title": {"zh": "首形科技完成 2025 年第四轮融资，中网投与蚂蚁集团联合领投"}, "summary": {"zh": "12 月 12 日，首形科技宣布完成新一轮融资，由中国互联网投资基金（中网投）与蚂蚁集团联合领投，上海未来产业基金、东方富海参与，老股东招商局创投追投，深蓝资本担任财务顾问。资金用于产品矩阵扩展、小批量量产体系搭建及核心模型与算法迭代。金额未披露。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1765528223168230.html", "publisher": "新京报贝壳财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/bjnews-2025-12-12-shouxing-dec-round.html"}, {"url": "https://news.pedaily.cn/202512/558558.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/news-2025-12-12-shouxing-dec-round-pedai.html"}]}, {"path": "events/2025/06/evt-2025-06-26-shouxing-funding-pre-a.yaml", "id": "evt-2025-06-26-shouxing-funding-pre-a", "orgs": [{"id": "shouxing", "role": "subject"}], "title": {"zh": "首形科技完成 Pre-A 轮融资，招商局创投与深创投共同领投"}, "summary": {"zh": "6 月 26 日，首形科技宣布完成新一轮融资，由招商局创投、深创投共同领投，五源资本、浔商创投跟投，未披露金额。稿件写明此前天使轮投资人为德迅投资、奇绩创坛、Taihill、智元机器人；其创始人发布的一段仿生机器人睁眼、微笑的视频在社交平台获得大量转发。"}, "evidence": [{"url": "https://news.pedaily.cn/202506/551521.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/news-2025-06-26-shouxing-pre-a.html"}]}]