[{"path": "events/2026/02/evt-2026-02-04-zhuoyide-funding-pre-a-plus.yaml", "id": "evt-2026-02-04-zhuoyide-funding-pre-a-plus", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "卓益得机器人完成近亿元 Pre-A+ 轮融资"}, "summary": {"zh": "2026 年 2 月 4 日，上海卓益得机器人有限公司宣布完成近亿元人民币 Pre-A+ 轮融资，由上海浦东引领区投资中心、上海张江科技创业投资有限公司联合领投，河南省科投产业发展投资基金等跟投，并引入青岛征和工业股份有限公司、厦门松霖科技股份有限公司集团成员作为战略产业投资者。资金用于核心技术与产品迭代、量产交付与供应链体系升级，重点面向老年人康养陪护市场。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1770256053129901.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/bjnews-2026-02-04-zhuoyide-pre-a-plus.html"}, {"url": "https://www.droidup.com/fenleimingcheng", "publisher": "卓益得机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/droidup-2026-01-30-zhuoyide-official-news.html"}]}, {"path": "events/2026/07/evt-2026-07-20-sh-humanoid-deployment-pilot-platform-zhuoyide.yaml", "id": "evt-2026-07-20-sh-humanoid-deployment-pilot-platform-zhuoyide", "orgs": [{"id": "sh-humanoid", "role": "subject"}, {"id": "zhuoyide", "role": "counterparty"}], "title": {"zh": "上海市人形机器人中试服务平台投入运营，国地中心与卓益得签千台套试制专项"}, "summary": {"zh": "WAIC 2026 期间，国地中心联合上海电气集团打造的上海市人形机器人中试服务平台正式发布并投入运营，平台落地张江机器人谷，设两条模块化柔性整机试制产线与一条精密零部件装配线，报道称具备年产 2000 台（套）试制能力。同日国地中心与卓益得完成千台套人形机器人试制专项签约。"}, "evidence": [{"url": "https://finance.sina.com.cn/roll/2026-07-20/doc-iniimqsk8240862.shtml", "publisher": "新浪财经（转载证券时报 e 公司）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/finance-2026-07-20-sh-humanoid-waic-platfor.html"}, {"url": "https://www.ofweek.com/im/2026-07/ART-201900-8120-30695296.html", "publisher": "OFweek 智能制造网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/ofweek-2026-07-20-sh-humanoid-pilot-platfo.html"}]}, {"path": "events/2026/07/evt-2026-07-19-zhuoyide-partnership-pilot-platform-1000-units.yaml", "id": "evt-2026-07-19-zhuoyide-partnership-pilot-platform-1000-units", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "卓益得与上海人形机器人中试服务平台签订千台量产战略合作协议"}, "summary": {"zh": "7 月 19 日，在 2026 WAIC 期间举办的人形机器人与具身智能创新发展论坛上，卓益得与上海人形机器人中试服务平台签订千台量产战略合作协议，双方打通研发试制、标准化中试、批量生产、终端交付环节。卓益得现场称已手握千台级商用订单，覆盖康养、汽车、美业等场景。"}, "evidence": [{"url": "https://sz.ifeng.com/c/8uuIIHYJ5Z5", "publisher": "凤凰网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/sz-2026-07-19-zhuoyide-pilot-platform-.html"}, {"url": "https://news.ikanchai.com/2026/0720/663054.shtml", "publisher": "砍柴网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/news-2026-07-19-zhuoyide-pilot-platform-.html"}]}, {"path": "events/2026/01/evt-2026-01-30-zhuoyide-product-launch-moya.yaml", "id": "evt-2026-01-30-zhuoyide-product-launch-moya", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "卓益得在张江总部展厅开业仪式上发布完全仿生机器人 Moya，首批 50 台预售 120 万至 150 万元"}, "summary": {"zh": "上海卓益得机器人有限公司在张江机器人谷总部展厅开业仪式上推出完全仿生具身智能机器人 Moya，定位高端情感陪护，目标客户为高净值家庭、养老机构及科研院所。报道称首批 50 台限量预售定价区间为 120 万至 150 万元人民币，计划 2026 年第四季度启动交付。官网新闻写明总部乔迁暨展厅开业典礼于 2026 年 1 月 30 日举行。"}, "evidence": [{"url": "https://www.itbear.com.cn/html/2026-01/1120964.html", "publisher": "ITBear 科技资讯", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/itbear-2026-01-30-zhuoyide-moya-launch.html"}, {"url": "https://www.droidup.com/fenleimingcheng", "publisher": "卓益得机器人官网", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/droidup-2026-01-30-zhuoyide-official-news.html"}]}, {"path": "events/2024/10/evt-2024-10-14-zhuoyide-funding-angel-plus.yaml", "id": "evt-2024-10-14-zhuoyide-funding-angel-plus", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "卓益得机器人完成 1 亿元融资，投资方未披露"}, "summary": {"zh": "10 月 14 日，艾媒网报道上海卓益得机器人有限公司完成 1 亿元人民币融资，本轮投资方未透露。报道称公司成立于 2021 年 5 月 13 日，位于上海市杨浦区，产品为小贝系列机器人。36 氪项目库将该轮记为 2024 年 10 月的天使 + 轮，金额 1 亿元人民币、投资方未披露。"}, "evidence": [{"url": "https://www.iimedia.cn/c1064/102538.html", "publisher": "艾媒网", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2024/10/iimedia-2024-10-14-zhuoyide-angel-plus.html"}]}, {"path": "events/2025/07/evt-2025-07-27-zhuoyide-product-launch-xingzhe3.yaml", "id": "evt-2025-07-27-zhuoyide-product-launch-xingzhe3", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "卓益得在 WAIC 2025 发布双足人形机器人「行者三号」"}, "summary": {"zh": "7 月 27 日，在 2025 世界人工智能大会上，卓益得推出双足人形机器人「行者三号」。官方介绍其身高约 1.7 米、重约 38 公斤，依托肌腱仿生驱动技术，机身较同级轻 20% 以上、能耗降低 50%，动态耦合节能技术使动态续航达 6 小时；共 30 个主动自由度（不含手部），全身 3D 高弹性材料外壳可衰减 90% 以上碰撞力。公司同期在 WAIC 宣布总部迁入张江机器人谷，并发布全球合作伙伴招募政策，未公布行者三号售价。"}, "evidence": [{"url": "https://finance.eastmoney.com/a/202507273468475238.html", "publisher": "上海证券报·中国证券网（东方财富转载）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/finance-2025-07-27-zhuoyide-xingzhe3-launch.html"}, {"url": "https://mp.weixin.qq.com/s/dd0CM8tfD5g1gWlO8uFmCQ", "publisher": "卓益得机器人微信公众号", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/mp-2025-07-27-zhuoyide-xingzhe3-offici.html"}]}, {"path": "events/2025/04/evt-2025-04-zhuoyide-funding-zhengzhou-airport-fund.yaml", "id": "evt-2025-04-zhuoyide-funding-zhengzhou-airport-fund", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "郑州航空港私募基金完成对卓益得的投资交割"}, "summary": {"zh": "大河财立方 4 月 16 日报道，郑州航空港私募基金管理有限公司于 2025 年年初完成对卓益得的投资决策落地，并于近日完成交割，卓益得是该基金完成的首个投资项目，金额未披露。报道同时提到，2024 年 10 月中豫具身智能实验室在郑州揭牌成立，卓益得创始人任实验室执行主任。"}, "evidence": [{"url": "https://app.dahecube.com/nweb/news/20250416/232543nc542a7b0cf0.htm?artid=232543", "publisher": "大河财立方", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/app-2025-04-zhuoyide-pre-a-hangkongg.html"}]}, {"path": "events/2025/06/evt-2025-06-09-zhuoyide-pricing-xingzhe2-jd.yaml", "id": "evt-2025-06-09-zhuoyide-pricing-xingzhe2-jd", "orgs": [{"id": "zhuoyide", "role": "subject"}], "title": {"zh": "卓益得「行者二号」在京东商城上线，售价 16.98 万元起"}, "summary": {"zh": "6 月 9 日，卓益得「行者二号」人形机器人在京东商城正式上线，售价 16.98 万元起。每日经济新闻 6 月 18 日报道，公司创始人称上线当晚即产生订单，正在准备产能交付。行者二号由上海卓益得机器人有限公司与中豫具身智能实验室联合研发，采用仿人肌腱驱动、以绳驱技术作为腿部驱动核心，曾在 2025 年 4 月北京亦庄人形机器人半程马拉松中获季军。"}, "evidence": [{"url": "http://m.nbd.com.cn/articles/2025-06-19/3914792.html", "publisher": "每日经济新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/m-2025-06-09-zhuoyide-xingzhe2-jd-pri.html"}]}]