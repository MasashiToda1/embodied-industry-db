[{"path": "events/2026/02/evt-2026-02-12-linkerbot-funding-b-round.yaml", "id": "evt-2026-02-12-linkerbot-funding-b-round", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手完成近 15 亿元 B 轮融资，道得投资、盛世投资领投"}, "summary": {"zh": "2 月 12 日，灵心巧手宣布完成近 15 亿元 B 轮融资。本轮由道得投资、盛世投资领投，盈渊朴远基金、诺瓦星云、新鼎资本、中和资本、智路资本、诚筑投资、临云资本、嘉铭浩春、财鑫资本、Singapore Eastern Epic Capitals 等跟投。公司称融资用于核心产品技术研发、产能提升和全栈基座能力打造，目标在 2026 年实现 5 万至 10 万台灵巧手交付。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3641823.html", "publisher": "证券时报网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/stcn-2026-02-12-linkerbot-b-round.html"}]}, {"path": "events/2026/07/evt-2026-07-17-linkerbot-product_launch-linker-hand-o30.yaml", "id": "evt-2026-07-17-linkerbot-product_launch-linker-hand-o30", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手在 WAIC 2026 首发 20 自由度全直驱灵巧手 Linker Hand O30"}, "summary": {"zh": "7 月 17 日 2026 世界人工智能大会（WAIC）开幕，灵心巧手在 H3-B122 展位首次公开亮相全直驱灵巧手 Linker Hand O30。O30 为 20 自由度，每个关节搭载独立驱动单元，单手重 740 克，公司称其具备亚毫米级重复定位精度；现场同时展示「灵巧手组装灵巧手」自动产线，并集中展示连杆、腱绳、直驱三条技术路线的新品。"}, "evidence": [{"url": "https://robot.ofweek.com/2026-07/ART-898890-8120-30695066.html", "publisher": "OFweek 机器人网 · 来源灵心巧手", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/robot-2026-07-17-linkerbot-o30-waic.html"}]}, {"path": "events/2026/04/evt-2026-04-29-linkerbot-funding-b-plus-round.yaml", "id": "evt-2026-04-29-linkerbot-funding-b-plus-round", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手完成 B+ 轮融资，中关村科学城基金、中银资产、复星创富等投资"}, "summary": {"zh": "2026 年 4 月 29 日，灵心巧手（北京）科技股份有限公司宣布完成 B+ 轮融资，金额未披露。本轮由中关村科学城基金、中银资产、复星创富、贝克资本、玖兆投资、弘章投资、元诺资本、中科英智、宇信科技等投资，老股东博佳资本、力合金融、力合资本、华福投资、德同资本持续加注。公司称目前单月出货超 4000 台，融资后推进产能爬坡，目标月交付能力过万。"}, "evidence": [{"url": "https://tech.caijing.com.cn/20260430/5157315.shtml", "publisher": "财经网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/tech-2026-04-29-linkerbot-b-plus-round.html"}]}, {"path": "events/2026/09/evt-2026-09-09-linkerbot-publication-v1-0-0.yaml", "id": "evt-2026-09-09-linkerbot-publication-v1-0-0", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手发布 linkerhand-o30-ros2 v1.0.0"}, "summary": {"zh": "灵心巧手发布 linkerhand-o30-ros2 v1.0.0。来源：GitHub · linker-bot"}, "evidence": [{"url": "https://github.com/linker-bot/linkerhand-o30-ros2/releases/tag/v1.0.0", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-09-linkerbot.html"}]}, {"path": "events/2026/09/evt-2026-09-14-linkerbot-publication-v2-2-0.yaml", "id": "evt-2026-09-14-linkerbot-publication-v2-2-0", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手发布 linkerhand-cpp-sdk v2.2.0"}, "summary": {"zh": "灵心巧手发布 linkerhand-cpp-sdk v2.2.0。来源：GitHub · linker-bot"}, "evidence": [{"url": "https://github.com/linker-bot/linkerhand-cpp-sdk/releases/tag/v2.2.0", "publisher": "", "tier": "official", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/09/github-2026-09-14-linkerbot.html"}]}, {"path": "events/2025/02/evt-2025-02-05-linkerbot-publication-linkerhand-python-sdk.yaml", "id": "evt-2025-02-05-linkerbot-publication-linkerhand-python-sdk", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手开源 LinkerHand Python SDK"}, "summary": {"zh": "灵心巧手在 GitHub 组织 linker-bot 下创建并开源 linkerhand-python-sdk 仓库，为 Linker Hand 系列灵巧手提供 Python 控制接口。"}, "evidence": [{"url": "https://github.com/linker-bot/linkerhand-python-sdk", "publisher": "GitHub · linker-bot", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/02/github-2025-02-05-linkerbot-linkerhand-pyt.html"}]}, {"path": "events/2025/07/evt-2025-07-26-linkerbot-product_launch-l6-industrial-waic.yaml", "id": "evt-2025-07-26-linkerbot-product_launch-l6-industrial-waic", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手 Linker Hand L6 工业版在 2025 WAIC 首次亮相"}, "summary": {"zh": "在 2025 世界人工智能大会上，灵心巧手的 Linker Hand「工业大师」版灵巧手 L6 首次亮相。L6 工业版针对工业场景的高灵活性、高负载需求开发，具备 6 个主动自由度、12 个总自由度，采用「无刷电机 + 滚珠丝杠」的超强电缸驱动模块与驱控一体化设计。"}, "evidence": [{"url": "https://www.36kr.com/p/3398252618238081", "publisher": "36氪", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/36kr-2025-07-26-linkerbot-l6-waic.html"}]}, {"path": "events/2025/07/evt-2025-07-02-linkerbot-publication-linkerhand-sim.yaml", "id": "evt-2025-07-02-linkerbot-publication-linkerhand-sim", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手开源 LinkerHand 仿真环境仓库"}, "summary": {"zh": "灵心巧手在 GitHub 组织 linker-bot 下创建并开源 linkerhand-sim 仓库，发布 Linker Hand 灵巧手的仿真环境，采用 Apache-2.0 许可证。"}, "evidence": [{"url": "https://github.com/linker-bot/linkerhand-sim", "publisher": "GitHub · linker-bot", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/07/github-2025-07-02-linkerbot-linkerhand-sim.html"}]}, {"path": "events/2025/04/evt-2025-04-28-linkerbot-publication-linkerhand-urdf.yaml", "id": "evt-2025-04-28-linkerbot-publication-linkerhand-urdf", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手开源 LinkerHand 灵巧手 URDF 模型仓库"}, "summary": {"zh": "灵心巧手在 GitHub 组织 linker-bot 下创建并开源 linkerhand-urdf 仓库，发布 Linker Hand 系列灵巧手的 URDF 模型文件，采用 Apache-2.0 许可证。"}, "evidence": [{"url": "https://github.com/linker-bot/linkerhand-urdf", "publisher": "GitHub · linker-bot", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/github-2025-04-28-linkerbot-linkerhand-urd.html"}]}, {"path": "events/2025/04/evt-2025-04-01-linkerbot-publication-linkerhand-ros2-sdk.yaml", "id": "evt-2025-04-01-linkerbot-publication-linkerhand-ros2-sdk", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手开源 LinkerHand ROS2 SDK"}, "summary": {"zh": "灵心巧手在 GitHub 组织 linker-bot 下创建并开源 linkerhand-ros2-sdk 仓库，为 Linker Hand 系列灵巧手提供 ROS2 驱动与接口，采用 Apache-2.0 许可证。"}, "evidence": [{"url": "https://github.com/linker-bot/linkerhand-ros2-sdk", "publisher": "GitHub · linker-bot", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/github-2025-04-01-linkerbot-linkerhand-ros.html"}]}, {"path": "events/2025/04/evt-2025-04-08-linkerbot-funding-seed-round.yaml", "id": "evt-2025-04-08-linkerbot-funding-seed-round", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手完成超亿元种子轮融资"}, "summary": {"zh": "4 月 8 日消息，灵心巧手（北京）科技有限公司完成超亿元种子轮融资，由红杉种子基金、万凯新材领投，力合资本、力合金融、华仓资本、鞍羽跟投，融资将用于底层技术研发和产品优化迭代。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1744119812168063.html", "publisher": "新京报贝壳财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/04/bjnews-2025-04-08-linkerbot-seed-round.html"}]}, {"path": "events/2025/11/evt-2025-11-25-linkerbot-funding-a-plus-round.yaml", "id": "evt-2025-11-25-linkerbot-funding-a-plus-round", "orgs": [{"id": "linkerbot", "role": "subject"}, {"id": "leju", "role": "investor"}], "title": {"zh": "灵心巧手完成数亿元 A+ 轮融资，乐聚机器人、奥克斯等参投"}, "summary": {"zh": "11 月 25 日，据灵心巧手官方公众号消息，灵心巧手（北京）科技有限公司宣布完成数亿元人民币 A+ 轮融资。本轮由浙江创新投资、德清产投、乐聚机器人、鼎晖百孚、晶华新材、东方精工、奥克斯、华福投资、弘颐基金、洪山资本、祥源新材等共同参与。公司表示 2026 年计划交付 5 万至 10 万台灵巧手。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1764057751169471.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/11/bjnews-2025-11-25-linkerbot-a-plus-round.html"}]}, {"path": "events/2025/10/evt-2025-10-24-linkerbot-funding-a-round.yaml", "id": "evt-2025-10-24-linkerbot-funding-a-round", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手完成数亿元 A 轮融资，京国瑞管理公司与博佳资本领投"}, "summary": {"zh": "10 月 24 日，灵心巧手（北京）科技有限公司宣布完成数亿元 A 轮融资。本轮由京国瑞管理公司和博佳资本领投，国中资本、帝奥微、紫峰资本、山证投资、江金卓越基金、弘颐基金等联合投资，老股东蚂蚁集团继续加注。公司称融资用于量产能力升级、全场景技术研发与全球化布局。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3404786.html", "publisher": "证券时报网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/10/stcn-2025-10-24-linkerbot-a-round.html"}]}, {"path": "events/2025/12/evt-2025-12-29-linkerbot-funding-a-plus-plus-round.yaml", "id": "evt-2025-12-29-linkerbot-funding-a-plus-plus-round", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手完成 A++ 轮融资，红杉中国、创世伙伴创投等投资"}, "summary": {"zh": "12 月 29 日，灵心巧手宣布完成 A++ 轮融资，本轮由红杉中国、创世伙伴创投（CCV）、广发乾和、普丰资本投资，金额未披露，资金用于产品技术研发、产能提升和具身智能灵巧操作数据积累。公司称已量产千台高自由度灵巧手，计划 2026 年交付 5 万至 10 万台。"}, "evidence": [{"url": "https://www.bjnews.com.cn/detail/1766978522129896.html", "publisher": "新京报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/bjnews-2025-12-29-linkerbot-a-plus-plus-ro.html"}]}, {"path": "events/2025/08/evt-2025-08-07-linkerbot-funding-angel-round.yaml", "id": "evt-2025-08-07-linkerbot-funding-angel-round", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手完成数亿元天使轮融资"}, "summary": {"zh": "8 月 7 日，灵心巧手完成数亿元天使轮融资，由蚂蚁集团领投，中金资本、首发展创投、上海半导体装备基金、澄凯基金、德同资本、可可资本跟投，老股东红杉中国种子基金继续加注。融资将用于公司的技术储备提升和具身智能数据采集场建设。"}, "evidence": [{"url": "https://m.bjnews.com.cn/detail/1754571161168596.html", "publisher": "新京报贝壳财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/08/m-2025-08-07-linkerbot-angel-round.html"}]}, {"path": "events/2025/01/evt-2025-01-20-linkerbot-product_launch-titanium-t10-t20.yaml", "id": "evt-2025-01-20-linkerbot-product_launch-titanium-t10-t20", "orgs": [{"id": "linkerbot", "role": "subject"}], "title": {"zh": "灵心巧手发布 Linker Hand 灵巧手钛金版 T10、T20"}, "summary": {"zh": "灵心巧手发布自主研发的 Linker Hand 灵巧手钛金版 T10、T20，售价分别为 19999 元和 49999 元。钛金版采用单指模块化设计和连杆驱动，工业版自由度 25—30 个，科研版最高自由度 42 个，最大负载 5kg，配备摄像头与电子皮肤的视触觉感知系统，支持 ROS 插件与 CAN 总线连接。"}, "evidence": [{"url": "https://news.qq.com/rain/a/20250120A08BVH00", "publisher": "机器人大讲堂（腾讯新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/01/news-2025-01-20-linkerbot-titanium-t10-t.html"}]}]