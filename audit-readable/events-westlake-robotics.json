[{"path": "events/2026/03/evt-2026-03-23-westlake-robotics-product_launch-titan-o1.yaml", "id": "evt-2026-03-23-westlake-robotics-product_launch-titan-o1", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人发布搭载 GAE 身外化身系统的人形机器人「泰坦 o1」"}, "summary": {"zh": "西湖大学孵化的西湖机器人发布人形机器人「泰坦 o1」（Titan o1），搭载自研通用动作预训练大模型 GAE（General Action Expert）身外化身系统。报道称该系统可实时模仿人类动作、跨本体适配，一人可操控多台不同地点的机器人同步作业。"}, "evidence": [{"url": "https://finance.sina.com.cn/tjhz/2026-03-23/doc-inhrxmcx5524505.shtml", "publisher": "新浪财经（转载上观新闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/finance-2026-03-23-westlake-robotics-titan-.html"}, {"url": "http://www.xinhuanet.com/20260323/c58804e25b4a43d5940a02270b51bee0/c.html", "publisher": "新华网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/xinhuanet-2026-03-23-westlake-robotics-titan-.html"}]}, {"path": "events/2026/02/evt-2026-02-14-westlake-robotics-funding-pre-a.yaml", "id": "evt-2026-02-14-westlake-robotics-funding-pre-a", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人完成亿元级 Pre-A 轮融资，赛富投资基金领投"}, "summary": {"zh": "2 月 14 日报道，西湖机器人科技（杭州）有限公司完成亿元级 Pre-A 轮融资，由赛富投资基金领投，龙芯创投、莫干山基金等机构跟投。报道称公司成立于 2021 年，以全身运动操作一体的通用具身基础大模型为核心方向。"}, "evidence": [{"url": "https://finance.sina.com.cn/jjxw/2026-02-14/doc-inhmtwhv9539073.shtml", "publisher": "新浪财经（转载财闻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/02/finance-2026-02-14-westlake-robotics-pre-a.html"}]}, {"path": "events/2026/09/evt-2026-09-11-westlake-robotics-funding-a1-round.yaml", "id": "evt-2026-09-11-westlake-robotics-funding-a1-round", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人完成数亿元 A1 轮融资"}, "summary": {"zh": "9 月 11 日，西湖机器人宣布完成数亿元 A1 轮融资，投资方包括海愿资本、翠微基金、银杏谷资本、西湖科创投、中山创投等。公司称 A 轮系列资金将投向全身运动操作一体化通用具身基础大模型 WR1、多场景商业化拓展与人才建设。"}, "evidence": [{"url": "https://tech.ifeng.com/c/8wKpQvEjEwG", "publisher": "凤凰网（转载机器人前瞻）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/tech-2026-09-11-westlake-robotics-a1-rou.html"}, {"url": "https://finance.sina.com.cn/jjxw/2026-09-11/doc-inirmvzx5314641.shtml", "publisher": "新浪财经（转载投资界）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/09/finance-2026-09-11-westlake-robotics-a1-rou.html"}]}, {"path": "events/2026/08/evt-2026-08-12-westlake-robotics-partnership-longyou-training-base.yaml", "id": "evt-2026-08-12-westlake-robotics-partnership-longyou-training-base", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人与衢州龙游县政府共建具身智能实景实训基地"}, "summary": {"zh": "西湖机器人科技（杭州）有限公司与衢州市龙游县人民政府签订战略合作协议，共建具身智能实景实训基地。龙游全域开放工业制造、民生服务、特种作业等真实场景，供西湖 o1 真机实地训练并采集人形全身运动数据集。"}, "evidence": [{"url": "http://www.zj.xinhuanet.com/20260812/e66c903b2e50459ba19609733c0b58e5/c.html", "publisher": "新华网浙江频道（来源：西湖机器人科技（杭州）有限公司）", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/08/zj-2026-08-12-westlake-robotics-longyo.html"}]}, {"path": "events/2026/08/evt-2026-08-12-westlake-robotics-funding-24.yaml", "id": "evt-2026-08-12-westlake-robotics-funding-24", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "A 轮融资落地，金额过亿元；报道称半年内完成四轮累计 5 亿元融资，方向为人形机器人全身统一大模型"}, "summary": {"zh": "A 轮融资落地，金额过亿元；报道称半年内完成四轮累计 5 亿元融资，方向为人形机器人全身统一大模型。"}, "evidence": [{"url": "https://www.nbd.com.cn/articles/2026-08-12/4539536.html", "publisher": "", "tier": "media", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/08/nbd-2026-08-12-westlake-robotics.html"}, {"url": "https://c.m.163.com/news/a/L44E68A605118DFD.html", "publisher": "", "tier": "media", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/08/c-2026-08-12-westlake-robotics.html"}, {"url": "https://www.cjcn.com.cn/news/show-482694.html", "publisher": "", "tier": "media", "retrieved": "2026-09-21", "snapshot": "snapshots/2026/08/cjcn-2026-08-12-westlake-robotics.html"}]}, {"path": "events/2024/10/evt-2024-10-westlake-robotics-product_launch-xiaoxi-quadruped.yaml", "id": "evt-2024-10-westlake-robotics-product_launch-xiaoxi-quadruped", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人推出首个商业化产品四足机器人「小西」并启用量产计划"}, "summary": {"zh": "每日商报稿件写明西湖机器人于 2024 年 10 月推出第一个商业化产品「小西」并启用量产计划，这是该公司对外正式交付的第一台四足机器人。稿件写明「小西」体重 14 公斤，采用航天级碳纤维骨架，体形比市面上已有的最小款机器人再缩小 30%，可承载 5 公斤物品；搭载高精度激光雷达和摄像头，能自主规划路线、避开障碍物，并通过语音与老人互动，实现递送物品、陪伴散步等功能。"}, "evidence": [{"url": "https://hzdaily.hangzhou.com.cn/mrsb/2025/05/08/article_detail_3_20250508A168.html", "publisher": "每日商报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/hzdaily-2025-05-08-westlake-robotics-xiaoxi.html"}]}, {"path": "events/2025/02/evt-2025-02-westlake-robotics-deployment-xiaoxi-elderly-center.yaml", "id": "evt-2025-02-westlake-robotics-deployment-xiaoxi-elderly-center", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人四足机器人「小西」在杭州西湖区古荡街道民生综合体上岗送餐"}, "summary": {"zh": "每日商报稿件写明 2025 年 2 月「小西」在杭州西湖区古荡街道的一个民生综合体上岗，食堂用餐时间背着餐盒穿梭在点餐区和用餐区之间，为就座等待的老人送上餐食。稿件同时写明「小西」目前在多个养老服务中心进行试点实验。"}, "evidence": [{"url": "https://hzdaily.hangzhou.com.cn/mrsb/2025/05/08/article_detail_3_20250508A168.html", "publisher": "每日商报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/hzdaily-2025-05-08-westlake-robotics-xiaoxi.html"}]}, {"path": "events/2025/05/evt-2025-05-westlake-robotics-product_launch-aotian-quadruped.yaml", "id": "evt-2025-05-westlake-robotics-product_launch-aotian-quadruped", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人推出小型四足机器人「傲天」，在广交会展出"}, "summary": {"zh": "每日商报稿件写明西湖机器人最新研发的高性能小型四足机器人「傲天」在最新一届广交会上展出并与宾客互动。稿件写明该机型借助企业自研的多模态大模型实现语音交互、指令下达、危险预警、环境探测；两大特点为预置图像检测定位系统（使用者只需添加传感器即可投入使用）与内置「大脑+小脑」系统，面向养老、医疗、安防、巡检等场景。"}, "evidence": [{"url": "https://hzdaily.hangzhou.com.cn/mrsb/2025/05/08/article_detail_3_20250508A168.html", "publisher": "每日商报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/hzdaily-2025-05-08-westlake-robotics-xiaoxi.html"}]}, {"path": "events/2025/01/evt-2025-01-09-westlake-robotics-funding-angel-plus.yaml", "id": "evt-2025-01-09-westlake-robotics-funding-angel-plus", "orgs": [{"id": "westlake-robotics", "role": "subject"}], "title": {"zh": "西湖机器人完成天使+轮融资，原话为「近亿元」"}, "summary": {"zh": "1 月 9 日，西湖机器人科技（杭州）有限公司宣布完成天使+轮融资，报道原话为「共计近亿元」，未披露确定金额。本轮由晶科集团旗下 CVC 金能基金、犇驰资本领投，广州诚信创投等多家机构跟投，天使轮股东天使湾创投持续加注，光源资本担任独家财务顾问。报道写明资金用于端到端具身智能大模型的进化与人形机器人产品迭代、完成客户产品交付。"}, "evidence": [{"url": "https://news.pedaily.cn/202501/545292.shtml", "publisher": "投资界", "tier": "aggregator", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/01/news-2025-01-09-westlake-robotics-angel-.html"}]}]