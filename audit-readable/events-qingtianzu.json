[{"path": "events/2026/03/evt-2026-03-18-qingtianzu-funding-angel-round.yaml", "id": "evt-2026-03-18-qingtianzu-funding-angel-round", "orgs": [{"id": "qingtianzu", "role": "subject"}], "title": {"zh": "擎天租完成天使轮及天使 + 轮融资，累计亿元级"}, "summary": {"zh": "3 月 18 日，擎天租宣布完成天使轮及天使 + 轮两轮融资，累计融资金额「亿元级别」，由大洋电机、慕华科创、敏卓机电等领投，乐华娱乐、复琢投资、明嘉资本、睿资创投、天季投资、嘉兴南投、知行投资等跟投，老股东大丰实业超额认购。公司披露平台订单已超 5500 单，可调度机器人设备超 3000 台。"}, "evidence": [{"url": "https://finance.sina.com.cn/jjxw/2026-03-18/doc-inhrkskx9420832.shtml", "publisher": "新浪财经 · 转载澎湃新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/03/finance-2026-03-18-qingtianzu-angel-round.html"}]}, {"path": "events/2026/04/evt-2026-04-29-qingtianzu-funding-pre-a-round.yaml", "id": "evt-2026-04-29-qingtianzu-funding-pre-a-round", "orgs": [{"id": "qingtianzu", "role": "subject"}], "title": {"zh": "擎天租完成数亿元 Pre-A 轮融资，正大机器人、蓝思科技等参与"}, "summary": {"zh": "4 月 29 日，擎天租宣布完成 Pre-A 轮融资，金额「数亿元」，投资方有正大集团旗下正大机器人、长信股份等产业方，以及美格智能、蓝思科技等上市公司，老股东明嘉资本、知行投资、睿资创投超额认购。报道称截至 4 月中旬平台接入且可调度的机器人超过 4000 台。"}, "evidence": [{"url": "https://www.stcn.com/article/detail/3879338.html", "publisher": "证券时报", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/04/stcn-2026-04-29-qingtianzu-pre-a-round.html"}]}, {"path": "events/2026/05/evt-2026-05-20-qingtianzu-funding-a-round.yaml", "id": "evt-2026-05-20-qingtianzu-funding-a-round", "orgs": [{"id": "qingtianzu", "role": "subject"}], "title": {"zh": "擎天租完成 A 轮及 A+ 轮融资，估值达 70 亿元"}, "summary": {"zh": "5 月 20 日，擎天租宣布近期完成 A 轮及 A+ 轮融资，金额「数亿元」，融资后估值 70 亿元。资金用于 RaaS 体系建设和工业等场景拓展。公司称平台可调度机器人已超 4000 台，业务重心转向工业制造、园区运营、仓储物流、商业服务等场景。"}, "evidence": [{"url": "https://www.jiemian.com/article/14486725.html", "publisher": "界面新闻", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/05/jiemian-2026-05-20-qingtianzu-a-round.html"}]}, {"path": "events/2026/01/evt-2026-01-15-qingtianzu-funding-seed-round.yaml", "id": "evt-2026-01-15-qingtianzu-funding-seed-round", "orgs": [{"id": "qingtianzu", "role": "subject"}], "title": {"zh": "擎天租完成种子轮融资，高瓴创投领投"}, "summary": {"zh": "1 月 15 日，擎天租宣布完成种子轮融资，由高瓴创投领投，复星创富、慕华科创、大丰基金及张江集团旗下具身智能公司参与投资，金额未披露。资金用于全国市场拓展、平台技术与服务体系建设。"}, "evidence": [{"url": "https://stcn.com/article/detail/3594340.html", "publisher": "证券时报网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/01/stcn-2026-01-15-qingtianzu-seed-round.html"}]}, {"path": "events/2025/12/evt-2025-12-22-qingtianzu-pricing-daily-rental-rates.yaml", "id": "evt-2025-12-22-qingtianzu-pricing-daily-rental-rates", "orgs": [{"id": "qingtianzu", "role": "subject"}, {"id": "agibot", "role": "supplier"}], "title": {"zh": "擎天租平台上线日租价：灵犀 X2 青春版 1499 元 / 天起，D1Edu 机器狗 200 元 / 天"}, "summary": {"zh": "平台上线当日，记者登录擎天租平台看到，智元灵犀 X2 青春版人形机器人日租 1499 元 / 天起，首形桌面级仿生人形机器人 F1 Lite 1200 元 / 天起，智元 D1Edu 机器狗日租 200 元，均含免费上门配送与订单服务期内运维保障。"}, "evidence": [{"url": "https://news.dayoo.com/finance/202512/22/171077_54908782.htm", "publisher": "广州日报大洋网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/news-2025-12-22-qingtianzu-platform-laun.html"}]}, {"path": "events/2025/12/evt-2025-12-22-qingtianzu-corporate-platform-launch.yaml", "id": "evt-2025-12-22-qingtianzu-corporate-platform-launch", "orgs": [{"id": "qingtianzu", "role": "subject"}, {"id": "agibot", "role": "counterparty"}], "title": {"zh": "擎天租机器人租赁平台在上海发布"}, "summary": {"zh": "12 月 22 日，全国机器人租赁生态峰会暨擎天租平台发布会在上海举行，发布机器人租赁平台「擎天租」。平台称已建立触达全国 50 个核心城市的租赁节点，600 余家服务商，1000 余台设备，计划 2026 年内渗透 200 余个城市。"}, "evidence": [{"url": "https://news.dayoo.com/finance/202512/22/171077_54908782.htm", "publisher": "广州日报大洋网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/12/news-2025-12-22-qingtianzu-platform-laun.html"}]}]