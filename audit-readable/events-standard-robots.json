[{"path": "events/2026/07/evt-2026-07-27-standard-robots-funding-hkex-third-filing.yaml", "id": "evt-2026-07-27-standard-robots-funding-hkex-third-filing", "orgs": [{"id": "standard-robots", "role": "subject"}], "title": {"zh": "斯坦德机器人第三次向港交所主板递交上市申请，中信证券与国泰君安国际联席保荐"}, "summary": {"zh": "据港交所 7 月 27 日披露，斯坦德机器人（无锡）股份有限公司向港交所主板提交上市申请，中信证券、国泰君安国际为联席保荐人，为公司第三次递表。招股书披露公司成立以来共完成 7 轮融资，最后一轮为 2024 年 6 月披露的 D 轮，投后估值 21 亿元；2023 年获小米 C 轮前投资 1.5 亿元，小米智造基金持股 8.4%，小米汽车超级工厂采用其解决方案。"}, "evidence": [{"url": "https://finance.sina.com.cn/wm/2026-07-28/doc-inikiewh8140675.shtml", "publisher": "新浪财经", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/finance-2026-07-27-standard-robots-hkex-thi.html"}, {"url": "https://robot.ofweek.com/2026-08/ART-8321202-12003-30697487.html", "publisher": "OFweek 机器人网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/robot-2026-07-27-standard-robots-hkex-thi.html"}]}, {"path": "events/2026/01/evt-2026-01-04-standard-robots-funding-hkex-second-filing.yaml", "id": "evt-2026-01-04-standard-robots-funding-hkex-second-filing", "orgs": [{"id": "standard-robots", "role": "subject"}], "title": {"zh": "斯坦德机器人第二次向港交所递交上市申请，定位改为「工业具身智能机器人解决方案先行者」"}, "summary": {"zh": "2026 年 1 月 4 日，斯坦德机器人（无锡）股份有限公司第二次向港交所递交上市申请，按第 18C 章特专科技公司通道申请。此前公司于 2025 年 6 月首次递表并因 6 个月审核期满失效；本次招股书将公司定位从「工业智能移动机器人解决方案提供商」改为「工业具身智能机器人解决方案的先行者」。招股书披露 2025 年具身机器人解决方案收入 2873.6 万元，占总营收 9.5%。"}, "evidence": [{"url": "https://robot.ofweek.com/2026-08/ART-8321202-12003-30697487.html", "publisher": "OFweek 机器人网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2026/07/robot-2026-07-27-standard-robots-hkex-thi.html"}]}, {"path": "events/2025/06/evt-2025-06-23-standard-robots-funding-hkex-first-filing.yaml", "id": "evt-2025-06-23-standard-robots-funding-hkex-first-filing", "orgs": [{"id": "standard-robots", "role": "subject"}], "title": {"zh": "斯坦德机器人首次向港交所递交招股书"}, "summary": {"zh": "6 月 23 日，斯坦德机器人正式向港交所递交招股书，拟在主板上市。招股书显示募集资金将用于强化核心机器人技术平台、机器人产品及 RoboVerse 系统，开发相关专有机器人技术，以及提升生产能力与建设新生产线。"}, "evidence": [{"url": "https://robot.ofweek.com/2025-06/ART-8321202-8120-30665418.html", "publisher": "OFweek 机器人网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/robot-2025-06-23-standard-robots-hkex-fir.html"}]}, {"path": "events/2025/05/evt-2025-05-standard-robots-product_launch-darwin-01.yaml", "id": "evt-2025-05-standard-robots-product_launch-darwin-01", "orgs": [{"id": "standard-robots", "role": "subject"}], "title": {"zh": "斯坦德机器人推出工业具身智能机器人 DARWIN-01"}, "summary": {"zh": "2025 年 5 月，斯坦德机器人推出工业具身智能机器人 DARWIN-01。报道称该机具备 23 个以上整机自由度，双臂协同作业载重 10 公斤，通过关节设计实现折叠变形、可在蹲伏与站立双形态间切换，全身传感器矩阵实现 360°×360° 动态环境感知。公司介绍称 DARWIN-01 融合多模感知、超大作业范围、快拆灵巧手、全向移动底盘与 VR 遥操，面向复杂工业场景。"}, "evidence": [{"url": "https://robot.ofweek.com/2025-06/ART-8321202-8120-30665418.html", "publisher": "OFweek 机器人网", "tier": "media", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/06/robot-2025-06-23-standard-robots-hkex-fir.html"}, {"url": "https://jp.standard-robots.com/blog-detail/id-22.html", "publisher": "斯坦德机器人", "tier": "official", "retrieved": "2026-09-22", "snapshot": "snapshots/2025/05/jp-2025-05-29-standard-robots-darwin01.html"}]}]