[{"sha":"2a3a090ba2a6e8c2711be1dd2552c02cc3aad46e","node_id":"C_kwDOU8J2RtoAKDJhM2EwOTBiYTJhNmU4YzI3MTFiZTFkZDI1NTJjMDJjYzNhYWQ0NmU","commit":{"author":{"name":"Haoyu Zhao","email":"55451421+Maxwell-Zhao@users.noreply.github.com","date":"2026-10-06T16:50:21Z"},"committer":{"name":"Haoyu Zhao","email":"55451421+Maxwell-Zhao@users.noreply.github.com","date":"2026-10-06T16:50:21Z"},"message":"Make downstream post-training turnkey from the released weights\n\n- add scripts/checkpoints/convert_released_to_dcp.py: CPU-only, model-free\n  re-serialization of the released film safetensors (net.* layout) into the DCP\n  dir the cosmos trainer warm-starts from -- no GPU, no VAE, no stage-1 run.\n- scripts/train.py: auto-inject a fused-AdamW optimizer when transformer_engine\n  is absent (stock requirements.txt envs), mirroring the flash_attn/lerobot\n  auto-patches; a user-pinned optimizer.optimizer_type is respected.\n- experiment_config.py: default STAGED_ROOT to '' (read source videos in place)\n  so a bare train.sh / direct invocation no longer needs it set.\n- README + downstream.toml: document the download -> convert -> post-train flow.\n\nVerified end-to-end: warm-start from the converted DCP, 3 finite-loss iters,\ncheckpoint saved, on a stock env with no STAGED_ROOT and no optimizer override.","tree":{"sha":"e51336b9a4b51283a7113c8443093999cf2c70ee","url":"https://api.github.com/repos/alibaba-damo-academy/RynnWorld-Latent/git/trees/e51336b9a4b51283a7113c8443093999cf2c70ee"},"url":"https://api.github.com/repos/alibaba-damo-academy/RynnWorld-Latent/git/commits/2a3a090ba2a6e8c2711be1dd2552c02cc3aad46e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/alibaba-damo-academy/RynnWorld-Latent/commits/2a3a090ba2a6e8c2711be1dd2552c02cc3aad46e","html_url":"https://github.com/alibaba-damo-academy/RynnWorld-Latent/commit/2a3a090ba2a6e8c2711be1dd2552c02cc3aad46e","comments